+// Harness.Trailer: renders title / caption / end-slate cards to transparent-capable PNGs (Edit Mode only).
+//
+//   TrailerCards.Render("Trailer/<slug>/cards.json") -> "rendered <n> cards to <dir>" | "error: ..."
+//
+// cards.json: {"font":"Assets/Fonts/Game SDF.asset","w":1920,"h":1080,"out_dir":"Trailer/<slug>/cards",
+//   "cards":[{"id":"title","text":"...","size":96,"color":"#ffffff","bg":"#00000000","align":"center|left|right",
+//   "valign":"middle|top|bottom","image":"Assets/Art/Logo.png","image_h":0.4,"margin":96}]}
+//
+// An additive empty scene (never saved, always closed) holds a Camera + Screen Space - Camera canvas that is rendered
+// into a RenderTexture and written with EncodeToPNG. Text uses TextMeshPro with the project font asset when
+// HARNESS_TMP is defined and a font is available, else the legacy UI Text with the built-in font.
+// out_dir is relative to the Unity project root and must be outside Assets/ (no AssetDatabase import of generated art).
+// Note: PNG alpha at anti-aliased text edges is approximate (UI blends into an alpha-0 background), which is fine for
+// overlays on video; use an opaque "bg" for cards that need exact edges.
+
+using System;
+using System.Collections.Generic;
+using System.IO;
+#if HARNESS_TMP
+using TMPro;
+using UnityEngine.UI;
+#endif
+using UnityEditor;
+using UnityEditor.SceneManagement;
+using UnityEngine;
+using UnityEngine.SceneManagement;
+
+namespace Harness.Trailer
+{
+#if !HARNESS_TMP
+    // com.unity.ugui 2.x (uGUI + TextMeshPro, in every Unity 6 template) is missing: keep the assembly compiling.
+    public static class TrailerCards
+    {
+        public static string Render(string cardsJsonPath)
+        {
+            return "error: TrailerCards needs the com.unity.ugui 2.x package (uGUI + TextMeshPro)";
+        }
+    }
+#else
+    public static class TrailerCards
+    {
+        [Serializable]
+        class CardSpec
+        {
+            public string id = "";
+            public string text = "";
+            public float size = 64f;
+            public string color = "#ffffff";
+            public string bg = "#00000000";
+            public string align = "center";
+            public string valign = "middle";
+            public string image = "";
+            public float image_h = 0.4f;
+            public float margin = 96f;
+        }
+
+        [Serializable]
+        class CardsFile
+        {
+            public string font = "";
+            public int w = 1920;
+            public int h = 1080;
+            public string out_dir = "";
+            public CardSpec[] cards = new CardSpec[0];
+        }
+
+        public static string Render(string cardsJsonPath)
+        {
+            if (EditorApplication.isPlayingOrWillChangePlaymode) return "error: cards can only be rendered in Edit Mode";
+            string abs = TrailerJob.Resolve(cardsJsonPath);
+            if (string.IsNullOrEmpty(abs) || !File.Exists(abs)) return "error: cards file not found: " + cardsJsonPath;
+            CardsFile f;
+            try { f = JsonUtility.FromJson<CardsFile>(File.ReadAllText(abs)); }
+            catch (Exception e) { return "error: invalid JSON: " + e.Message; }
+            if (f == null || f.cards == null || f.cards.Length == 0) return "error: no cards";
+            if (f.w < 16 || f.h < 16 || f.w > 8192 || f.h > 8192) return "error: w/h out of range";
+            if (string.IsNullOrEmpty(f.out_dir)) return "error: out_dir is required";
+            string outDir = TrailerJob.Resolve(f.out_dir);
+            if (TrailerJob.IsUnderAssets(outDir)) return "error: capture output must be outside Assets/";
+            var ids = new HashSet<string>();
+            foreach (var c in f.cards)
+            {
+                if (c == null || string.IsNullOrEmpty(c.id) || c.id.IndexOfAny(new[] { '/', '\\', ':' }) >= 0 || c.id.Contains(".."))
+                    return "error: every card needs a simple id";
+                if (!ids.Add(c.id)) return "error: duplicate card id " + c.id;
+            }
+
+            for (int i = 0; i < SceneManager.sceneCount; i++)
+                if (string.IsNullOrEmpty(SceneManager.GetSceneAt(i).path))
+                    return "error: save or close the untitled scene first (cards are built in a temporary additive scene)";
+
+            UnityEngine.Object font = LoadFont(f.font);
+            Scene prevActive = SceneManager.GetActiveScene();
+            Scene scene = default(Scene);
+            RenderTexture rt = null;
+            int count = 0;
+            try
+            {
+                Directory.CreateDirectory(outDir);
+                scene = EditorSceneManager.NewScene(NewSceneSetup.EmptyScene, NewSceneMode.Additive);
+                SceneManager.SetActiveScene(scene); // new GameObjects land in the active scene
+                rt = new RenderTexture(f.w, f.h, 24, RenderTextureFormat.ARGB32);
+                rt.antiAliasing = 1;
+                rt.Create();
+                foreach (var spec in f.cards)
+                {
+                    string file = Path.Combine(outDir, spec.id + ".png");
+                    RenderCard(spec, f, font, rt, file);
+                    Debug.Log("[TRAILER] card=" + spec.id + " file=" + file);
+                    count++;
+                }
+            }
+            catch (Exception e) { return "error: " + e.Message; }
+            finally
+            {
+                RenderTexture.active = null;
+                if (rt != null) { rt.Release(); UnityEngine.Object.DestroyImmediate(rt); }
+                if (prevActive.IsValid() && prevActive.isLoaded) SceneManager.SetActiveScene(prevActive);
+                if (scene.IsValid()) EditorSceneManager.CloseScene(scene, true);
+            }
+            return "rendered " + count + " cards to " + outDir;
+        }
+
+        static void RenderCard(CardSpec spec, CardsFile f, UnityEngine.Object font, RenderTexture rt, string file)
+        {
+            var created = new List<UnityEngine.Object>();
+            Texture2D png = null;
+            try
+            {
+                Color bg = ParseColor(spec.bg, new Color(0f, 0f, 0f, 0f));
+                var camGo = new GameObject("TrailerCardCamera");
+                created.Add(camGo);
+                // Far from anything in the user's open scenes, and culling only the UI layer the card lives on.
+                camGo.transform.position = FarAway;
+                var cam = camGo.AddComponent<Camera>();
+                cam.cullingMask = 1 << CardLayer;
+                cam.clearFlags = CameraClearFlags.SolidColor;
+                cam.backgroundColor = bg;
+                cam.orthographic = true;
+                cam.orthographicSize = f.h * 0.5f;
+                cam.allowHDR = false;
+                cam.allowMSAA = false;
+                cam.targetTexture = rt;
+                cam.enabled = false; // rendered manually
+
+                var canvasGo = new GameObject("TrailerCardCanvas", typeof(RectTransform));
+                created.Add(canvasGo);
+                var canvas = canvasGo.AddComponent<Canvas>();
+                canvas.renderMode = RenderMode.ScreenSpaceCamera;
+                canvas.worldCamera = cam;
+                canvas.planeDistance = 5f;
+                var scaler = canvasGo.AddComponent<CanvasScaler>();
+                scaler.uiScaleMode = CanvasScaler.ScaleMode.ScaleWithScreenSize;
+                scaler.referenceResolution = new Vector2(f.w, f.h);
+                scaler.screenMatchMode = CanvasScaler.ScreenMatchMode.MatchWidthOrHeight;
+                scaler.matchWidthOrHeight = 0.5f;
+
+                float m = Mathf.Max(0f, spec.margin);
+                var content = NewRect("Content", canvasGo.transform);
+                content.anchorMin = Vector2.zero;
+                content.anchorMax = Vector2.one;
+                content.offsetMin = new Vector2(m, m);
+                content.offsetMax = new Vector2(-m, -m);
+
+                float ax = spec.align == "left" ? 0f : spec.align == "right" ? 1f : 0.5f;
+                float imgH = 0f;
+                Texture2D tex = string.IsNullOrEmpty(spec.image) ? null : AssetDatabase.LoadAssetAtPath<Texture2D>(spec.image);
+                if (!string.IsNullOrEmpty(spec.image) && tex == null) Debug.LogWarning("[TRAILER] card " + spec.id + ": image not found " + spec.image);
+                if (tex != null)
+                {
+                    imgH = Mathf.Clamp01(spec.image_h <= 0f ? 0.4f : spec.image_h) * f.h;
+                    float imgW = imgH * tex.width / Mathf.Max(1, tex.height);
+                    float maxW = f.w - 2f * m;
+                    if (imgW > maxW && imgW > 0f) { imgH *= maxW / imgW; imgW = maxW; }
+                    var r = NewRect("Image", content);
+                    r.anchorMin = r.anchorMax = r.pivot = new Vector2(ax, 1f);
+                    r.sizeDelta = new Vector2(imgW, imgH);
+                    r.anchoredPosition = Vector2.zero;
+                    var raw = r.gameObject.AddComponent<RawImage>();
+                    raw.texture = tex;
+                    raw.raycastTarget = false;
+                }
+                if (!string.IsNullOrEmpty(spec.text))
+                {
+                    var tr = NewRect("Text", content);
+                    tr.anchorMin = Vector2.zero;
+                    tr.anchorMax = Vector2.one;
+                    tr.offsetMin = Vector2.zero;
+                    tr.offsetMax = new Vector2(0f, imgH > 0f ? -(imgH + f.h * 0.03f) : 0f);
+                    AddText(tr.gameObject, spec, font);
+                }
+
+                SetLayer(canvasGo.transform, CardLayer);
+                Canvas.ForceUpdateCanvases();
+                LayoutRebuilder.ForceRebuildLayoutImmediate(canvasGo.GetComponent<RectTransform>());
+                Canvas.ForceUpdateCanvases();
+                cam.Render();
+
+                RenderTexture.active = rt;
+                png = new Texture2D(f.w, f.h, TextureFormat.RGBA32, false);
+                png.ReadPixels(new Rect(0, 0, f.w, f.h), 0, 0);
+                png.Apply(false);
+                RenderTexture.active = null;
+                File.WriteAllBytes(file, png.EncodeToPNG());
+            }
+            finally
+            {
+                RenderTexture.active = null;
+                foreach (var o in created)
+                {
+                    if (o == null) continue;
+                    var go = o as GameObject;
+                    if (go != null) { var c = go.GetComponent<Camera>(); if (c != null) c.targetTexture = null; }
+                    UnityEngine.Object.DestroyImmediate(o);
+                }
+                if (png != null) UnityEngine.Object.DestroyImmediate(png);
+            }
+        }
+
+        const int CardLayer = 5; // Unity's built-in "UI" layer
+        static readonly Vector3 FarAway = new Vector3(0f, -100000f, -10f);
+
+        static void SetLayer(Transform t, int layer)
+        {
+            t.gameObject.layer = layer;
+            for (int i = 0; i < t.childCount; i++) SetLayer(t.GetChild(i), layer);
+        }
+
+        static RectTransform NewRect(string name, Transform parent)
+        {
+            var go = new GameObject(name, typeof(RectTransform));
+            go.transform.SetParent(parent, false);
+            return (RectTransform)go.transform;
+        }
+
+        static void AddText(GameObject go, CardSpec spec, UnityEngine.Object font)
+        {
+            Color col = ParseColor(spec.color, Color.white);
+            int h = spec.align == "left" ? 0 : spec.align == "right" ? 2 : 1; // 0 left, 1 center, 2 right
+            int v = spec.valign == "top" ? 0 : spec.valign == "bottom" ? 2 : 1; // 0 top, 1 middle, 2 bottom
+#if HARNESS_TMP
+            var tmpFont = font as TMP_FontAsset;
+            if (tmpFont != null)
+            {
+                var tmp = go.AddComponent<TextMeshProUGUI>();
+                tmp.font = tmpFont;
+                tmp.text = spec.text;
+                tmp.fontSize = spec.size;
+                tmp.color = col;
+                tmp.raycastTarget = false;
+                TextAlignmentOptions[,] map =
+                {
+                    { TextAlignmentOptions.TopLeft, TextAlignmentOptions.Top, TextAlignmentOptions.TopRight },
+                    { TextAlignmentOptions.Left, TextAlignmentOptions.Center, TextAlignmentOptions.Right },
+                    { TextAlignmentOptions.BottomLeft, TextAlignmentOptions.Bottom, TextAlignmentOptions.BottomRight },
+                };
+                tmp.alignment = map[v, h];
+                tmp.ForceMeshUpdate();
+                return;
+            }
+#endif
+            var t = go.AddComponent<Text>();
+            t.font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
+            t.text = spec.text;
+            t.fontSize = Mathf.RoundToInt(spec.size);
+            t.color = col;
+            t.raycastTarget = false;
+            t.horizontalOverflow = HorizontalWrapMode.Wrap;
+            t.verticalOverflow = VerticalWrapMode.Overflow;
+            TextAnchor[,] amap =
+            {
+                { TextAnchor.UpperLeft, TextAnchor.UpperCenter, TextAnchor.UpperRight },
+                { TextAnchor.MiddleLeft, TextAnchor.MiddleCenter, TextAnchor.MiddleRight },
+                { TextAnchor.LowerLeft, TextAnchor.LowerCenter, TextAnchor.LowerRight },
+            };
+            t.alignment = amap[v, h];
+        }
+
+        /// <summary>TMP font asset (project asset, else the TMP default) or null to use the legacy UI Text.</summary>
+        static UnityEngine.Object LoadFont(string fontPath)
+        {
+#if HARNESS_TMP
+            TMP_FontAsset fa = null;
+            if (!string.IsNullOrEmpty(fontPath)) fa = AssetDatabase.LoadAssetAtPath<TMP_FontAsset>(fontPath);
+            if (fa == null && !string.IsNullOrEmpty(fontPath)) Debug.LogWarning("[TRAILER] font asset not found: " + fontPath + " (using TMP default)");
+            if (fa == null)
+            {
+                try { fa = TMP_Settings.defaultFontAsset; } catch (Exception) { fa = null; } // TMP Essentials may be missing
+            }
+            return fa;
+#else
+            return null;
+#endif
+        }
+
+        static Color ParseColor(string s, Color fallback)
+        {
+            Color c;
+            return !string.IsNullOrEmpty(s) && ColorUtility.TryParseHtmlString(s, out c) ? c : fallback;
+        }
+    }
+#endif
+}
diff --git a/skills/trailer-maker/templates/Harness.Trailer/Editor/TrailerJob.cs b/skills/trailer-maker/templates/Harness.Trailer/Editor/TrailerJob.cs
new file mode 100644
index 0000000..5909919
--- /dev/null
+++ b/skills/trailer-maker/templates/Harness.Trailer/Editor/TrailerJob.cs
@@ -0,0 +1,275 @@
+// Harness.Trailer: data models and job persistence for the trailer capture tool.
+//
+// Entry points live in TrailerCapture (Start/Status/Cancel/RunFromCli) and TrailerCards (Render).
+// This file holds:
+//   - JsonUtility models that mirror shots.json (TrailerShotList) and report.json (TrailerReport),
+//   - JobState, the state machine record persisted to Temp/HarnessTrailer/job.json and mirrored in SessionState so the
+//     job survives the domain reload that entering Play Mode triggers,
+//   - helpers: Load/validate, project-relative path resolution, reflection type lookup.
+//
+// Why Game View capture: the harness pins the URP 2D renderer, which has no capture pass for the Recorder's
+// "Targeted Camera" input; Game View (or a Render Texture) is the supported source.
+// Why output must be outside Assets/: multi-hundred-MB videos inside Assets/ get imported by the AssetDatabase
+// (slow, bloats Library/, triggers reimports and can break the L1 gate). Paths are relative to the Unity project root.
+
+using System;
+using System.Collections.Generic;
+using System.IO;
+using UnityEditor;
+using UnityEngine;
+
+namespace Harness.Trailer
+{
+    // ---- shots.json ------------------------------------------------------------------------------------------
+
+    [Serializable] public class TrailerResolution { public int w = 1920; public int h = 1080; }
+    [Serializable] public class TrailerAudio { public bool capture; public string[] mute_mixer_params = new string[0]; }
+    [Serializable] public class TrailerHide { public string[] objects = new string[0]; public bool cursor; }
+    [Serializable] public class TrailerCameraSpec { public string cinemachine = ""; public float ortho_size; }
+
+    [Serializable]
+    public class TrailerShot
+    {
+        public string id = "";
+        public string beat = "";
+        public string scene = "";
+        public string setup = "";
+        public string setup_arg = "";
+        public string input = "";
+        public float warmup_s;
+        public float duration_s;
+        public float time_scale = 1f; // 0 means 1
+        public int takes = 1;
+        public TrailerHide hide = new TrailerHide();
+        public TrailerCameraSpec camera = new TrailerCameraSpec();
+        public string notes = "";
+    }
+
+    [Serializable]
+    public class TrailerShotList
+    {
+        public int version = 1;
+        public int fps = 60;
+        public TrailerResolution resolution = new TrailerResolution();
+        public string source = "game_view"; // "game_view" | "render_texture" (render_texture falls back to game_view)
+        public string codec = "mp4";        // "mp4" | "prores"
+        public string output_dir = "";
+        public TrailerAudio audio = new TrailerAudio();
+        public TrailerShot[] shots = new TrailerShot[0];
+    }
+
+    // ---- report.json -----------------------------------------------------------------------------------------
+
+    [Serializable]
+    public class TrailerTakeReport
+    {
+        public int take;
+        public string file = "";
+        public int frames;
+        public int fps;
+        public float duration_s;          // planned length from shots.json (frames / fps is what was recorded)
+        public string status = "failed"; // "ok" | "failed"
+        public int errors;
+        public string message = "";
+    }
+
+    [Serializable] public class TrailerShotReport { public string id = ""; public List<TrailerTakeReport> takes = new List<TrailerTakeReport>(); }
+    [Serializable] public class TrailerReport { public List<TrailerShotReport> shots = new List<TrailerShotReport>(); }
+
+    // ---- job state (Temp/HarnessTrailer/job.json + SessionState) -----------------------------------------------
+
+    public static class TrailerPhase
+    {
+        public const string EnterPlay = "enter_play"; // waiting for Play Mode after Start()
+        public const string BeginTake = "begin_take"; // pick the next shot/take, start the scene load
+        public const string Loading = "loading";
+        public const string Setup = "setup";          // setup method, time scale, hide, input
+        public const string Warmup = "warmup";
+        public const string Recording = "recording";
+        public const string Finalize = "finalize";    // recorder stopped, waiting for the encoder/file
+        public const string Done = "done";
+    }
+
+    [Serializable]
+    public class JobState
+    {
+        public string shots_path = "";
+        public string only = "";
+        public bool cli;               // launched via RunFromCli: exit the editor when done
+        public bool exit_requested;
+        public string phase = "";
+        public int shot_index;
+        public int take_index;         // 0-based
+        public double phase_started;   // EditorApplication.timeSinceStartup
+        public int load_frame;
+        public int rec_start_frame;
+        public int rec_target;
+        public int rec_frames;
+        public int errors;             // errors/exceptions logged during the current take
+        public int ok;
+        public int failed;
+        public string message = "";
+        public string report_path = "";
+        public TrailerReport report = new TrailerReport();
+
+        public bool Active { get { return !string.IsNullOrEmpty(phase) && phase != TrailerPhase.Done; } }
+    }
+
+    public static class TrailerJob
+    {
+        public const string TempDir = "Temp/HarnessTrailer";
+        const string SessionKey = "Harness.Trailer.JobState";
+        // Set by RunFromCli in THIS editor session (SessionState survives domain reloads, not editor restarts), so a
+        // stale job.json with cli=true left in Temp/ by an earlier run never makes a normal editor session exit.
+        const string CliSessionKey = "Harness.Trailer.CliStartedThisSession";
+
+        public static bool CliStartedThisSession
+        {
+            get { return SessionState.GetBool(CliSessionKey, false); }
+            set { SessionState.SetBool(CliSessionKey, value); }
+        }
+
+        public static string ProjectRoot { get { return Directory.GetParent(Application.dataPath).FullName; } }
+        public static string JobFile { get { return Path.Combine(ProjectRoot, TempDir, "job.json"); } }
+
+        /// <summary>Project-relative (or absolute) path to an absolute, normalized path.</summary>
+        public static string Resolve(string p)
+        {
+            if (string.IsNullOrEmpty(p)) return "";
+            return Path.GetFullPath(Path.IsPathRooted(p) ? p : Path.Combine(ProjectRoot, p));
+        }
+
+        public static bool IsUnderAssets(string absPath)
+        {
+            string assets = Path.GetFullPath(Application.dataPath).TrimEnd('/', '\\');
+            string p = Path.GetFullPath(absPath).TrimEnd('/', '\\');
+            return p.Equals(assets, StringComparison.OrdinalIgnoreCase)
+                || p.StartsWith(assets + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase)
+                || p.StartsWith(assets + "/", StringComparison.OrdinalIgnoreCase);
+        }
+
+        public static Type FindType(string fullName)
+        {
+            foreach (var asm in AppDomain.CurrentDomain.GetAssemblies())
+            {
+                try { var t = asm.GetType(fullName, false); if (t != null) return t; }
+                catch (Exception) { /* dynamic/partial assemblies can throw; skip */ }
+            }
+            return null;
+        }
+
+        public static string ReportPath(TrailerShotList list) { return Path.Combine(Resolve(list.output_dir), "report.json"); }
+
+        // ---- loading / validation ----
+
+        public static bool TryLoad(string shotsPath, out TrailerShotList list, out string error)
+        {
+            list = null;
+            error = null;
+            string abs = Resolve(shotsPath);
+            if (string.IsNullOrEmpty(abs) || !File.Exists(abs)) { error = "shots file not found: " + shotsPath; return false; }
+            try { list = JsonUtility.FromJson<TrailerShotList>(File.ReadAllText(abs)); }
+            catch (Exception e) { error = "invalid JSON in " + shotsPath + ": " + e.Message; return false; }
+            if (list == null) { error = "empty shots file: " + shotsPath; return false; }
+            Normalize(list);
+            error = Validate(list);
+            if (error != null) { list = null; return false; }
+            return true;
+        }
+
+        static void Normalize(TrailerShotList l)
+        {
+            if (l.resolution == null) l.resolution = new TrailerResolution();
+            if (l.audio == null) l.audio = new TrailerAudio();
+            if (l.audio.mute_mixer_params == null) l.audio.mute_mixer_params = new string[0];
+            if (l.shots == null) l.shots = new TrailerShot[0];
+            if (string.IsNullOrEmpty(l.codec)) l.codec = "mp4";
+            l.codec = l.codec.ToLowerInvariant();
+            if (string.IsNullOrEmpty(l.source)) l.source = "game_view";
+            foreach (var s in l.shots)
+            {
+                if (s == null) continue;
+                if (s.hide == null) s.hide = new TrailerHide();
+                if (s.hide.objects == null) s.hide.objects = new string[0];
+                if (s.camera == null) s.camera = new TrailerCameraSpec();
+                if (s.time_scale <= 0f) s.time_scale = 1f;
+                if (s.takes <= 0) s.takes = 1;
+                if (s.setup == null) s.setup = "";
+                if (s.setup_arg == null) s.setup_arg = "";
+                if (s.input == null) s.input = "";
+            }
+        }
+
+        static string Validate(TrailerShotList l)
+        {
+            var errs = new List<string>();
+            if (l.fps < 1 || l.fps > 240) errs.Add("fps must be 1..240");
+            if (l.resolution.w < 16 || l.resolution.h < 16 || l.resolution.w > 8192 || l.resolution.h > 8192) errs.Add("resolution out of range");
+            if (l.codec != "mp4" && l.codec != "prores") errs.Add("codec must be mp4 or prores");
+            if (l.source != "game_view" && l.source != "render_texture") errs.Add("source must be game_view or render_texture");
+            else if (l.source == "render_texture") Debug.LogWarning("[TRAILER] source=render_texture is not implemented; using game_view");
+            if (string.IsNullOrEmpty(l.output_dir)) errs.Add("output_dir is required");
+            else if (IsUnderAssets(Resolve(l.output_dir))) errs.Add("capture output must be outside Assets/");
+            if (l.shots.Length == 0) errs.Add("no shots");
+            var seen = new HashSet<string>();
+            foreach (var s in l.shots)
+            {
+                if (s == null || string.IsNullOrEmpty(s.id)) { errs.Add("shot without id"); continue; }
+                if (s.id.IndexOfAny(new[] { '/', '\\', ':' }) >= 0 || s.id.Contains("..")) errs.Add("bad shot id '" + s.id + "'");
+                if (!seen.Add(s.id)) errs.Add("duplicate shot id " + s.id);
+                if (string.IsNullOrEmpty(s.scene) || !File.Exists(Resolve(s.scene))) errs.Add(s.id + ": scene not found '" + s.scene + "'");
+                if (s.duration_s <= 0f) errs.Add(s.id + ": duration_s must be > 0");
+                if (s.warmup_s < 0f) errs.Add(s.id + ": warmup_s must be >= 0");
+            }
+            return errs.Count == 0 ? null : string.Join("; ", errs.ToArray());
+        }
+
+        /// <summary>Shots to run, in file order, optionally filtered by a comma/semicolon separated id list.</summary>
+        public static List<TrailerShot> Filter(TrailerShotList l, string only, out string error)
+        {
+            error = null;
+            var result = new List<TrailerShot>();
+            if (string.IsNullOrWhiteSpace(only)) { result.AddRange(l.shots); return result; }
+            var wanted = new List<string>(only.Split(new[] { ',', ';', ' ' }, StringSplitOptions.RemoveEmptyEntries));
+            foreach (var s in l.shots) if (wanted.Remove(s.id)) result.Add(s);
+            if (wanted.Count > 0) error = "unknown shot id(s): " + string.Join(",", wanted.ToArray());
+            return result;
+        }
+
+        // ---- persistence ----
+
+        public static void SaveState(JobState s)
+        {
+            string json = JsonUtility.ToJson(s, true);
+            SessionState.SetString(SessionKey, json);
+            try
+            {
+                Directory.CreateDirectory(Path.GetDirectoryName(JobFile));
+                File.WriteAllText(JobFile, json);
+            }
+            catch (Exception e) { Debug.LogWarning("[TRAILER] could not write job.json: " + e.Message); }
+        }
+
+        public static JobState LoadState()
+        {
+            string json = SessionState.GetString(SessionKey, "");
+            if (string.IsNullOrEmpty(json))
+            {
+                try { if (File.Exists(JobFile)) json = File.ReadAllText(JobFile); } catch (Exception) { json = ""; }
+            }
+            if (string.IsNullOrEmpty(json)) return null;
+            try { return JsonUtility.FromJson<JobState>(json); } catch (Exception) { return null; }
+        }
+
+        public static void WriteReport(JobState s)
+        {
+            if (string.IsNullOrEmpty(s.report_path)) return;
+            try
+            {
+                Directory.CreateDirectory(Path.GetDirectoryName(s.report_path));
+                File.WriteAllText(s.report_path, JsonUtility.ToJson(s.report, true));
+            }
+            catch (Exception e) { Debug.LogWarning("[TRAILER] could not write report: " + e.Message); }
+        }
+    }
+}
diff --git a/skills/trailer-maker/templates/beats.template.json b/skills/trailer-maker/templates/beats.template.json
new file mode 100644
index 0000000..7280ae3
--- /dev/null
+++ b/skills/trailer-maker/templates/beats.template.json
@@ -0,0 +1,29 @@
+{
+  "version": 1,
+  "type": "gameplay",
+  "target_s": 60,
+  "bpm": null,
+  "core_message": "One sentence: what the player does and why it is exciting.",
+  "cta": "Wishlist on Steam",
+  "beats": [
+    {"id": "thumbstopper", "start": 0, "end": 5, "hook": true,
+     "intent": "late-game chaos that already shows the hook, gameplay in motion from frame 1",
+     "shots": ["s01", "s02"], "card": null, "vo": null, "music": "cold open, already at full energy"},
+    {"id": "title-flash", "start": 5, "end": 7,
+     "intent": "logo on a music hit, then straight back to gameplay",
+     "shots": [], "card": "GAME TITLE", "vo": null, "music": "hit + short breath"},
+    {"id": "genre-hook", "start": 7, "end": 20, "hook": true,
+     "intent": "genre in 1-2 shots, then the core verbs and the hook again, clearly framed",
+     "shots": ["s03", "s04", "s05"], "card": null, "vo": null, "music": "groove settles, steady pulse"},
+    {"id": "escalation", "start": 20, "end": 45,
