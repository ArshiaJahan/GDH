+def process_image(pid: int) -> Path | None:
+    """The executable a Windows process runs (the app, so the helper can start it again)."""
+    if sys.platform != "win32":
+        return None
+    import ctypes
+    from ctypes import wintypes
+
+    k32 = ctypes.windll.kernel32  # type: ignore[attr-defined]
+    h = k32.OpenProcess(0x1000, False, pid)  # PROCESS_QUERY_LIMITED_INFORMATION
+    if not h:
+        return None
+    try:
+        buf = ctypes.create_unicode_buffer(32768)
+        n = wintypes.DWORD(len(buf))
+        if not k32.QueryFullProcessImageNameW(h, 0, buf, ctypes.byref(n)):
+            return None
+        return Path(buf.value)
+    finally:
+        k32.CloseHandle(h)
+
+
+def windows_helper_script(*, app_pid: int, backend_pid: int, installer: Path, app_exe: Path | None) -> str:
+    """PowerShell: stop the app (its backend follows via the parent watcher), run the NSIS
