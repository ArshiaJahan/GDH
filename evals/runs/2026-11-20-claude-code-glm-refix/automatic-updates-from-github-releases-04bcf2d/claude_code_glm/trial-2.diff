@@ -0,0 +1,164 @@
+"""Updates from GitHub Releases, for builds on the "github" update channel.
+
+The release workflow (.github/workflows/release.yml) publishes `v<version>` with one asset per
+platform (see `asset_name`). `ReleaseFeed.poll` asks GitHub for the latest release at most every
+`interval_s`; when it's newer than the running version it downloads this platform's asset and
+lays it out like `make release` does (`<dir>/<version>/…` + `release.json`, then `latest.json`
+last), so the folder updater in updates.py finds it, announces it and installs it.
+
+Local builds (channel "local") never create a feed, so they never call GitHub.
+"""
+from __future__ import annotations
+
+import json
+import logging
+import os
+import shutil
+import subprocess
+import sys
+import time
+import urllib.request
+import zipfile
+from pathlib import Path
+from typing import Any, Callable
+
+log = logging.getLogger(__name__)
+
+API = "https://api.github.com"
+APP_NAME = "GameDevWorkstation.app"
+DOWNLOADS = ".downloads"
+
+Fetch = Callable[[str], bytes]
+
+
+def _http_get(url: str) -> bytes:
+    req = urllib.request.Request(url, headers={"Accept": "application/vnd.github+json, application/octet-stream",
+                                               "User-Agent": "GameDevWorkstation-updater",
+                                               "X-GitHub-Api-Version": "2022-11-28"})
+    with urllib.request.urlopen(req, timeout=60) as r:  # noqa: S310 — fixed https URLs
+        return r.read()
+
+
+def asset_name(version: str, platform: str | None = None) -> str | None:
+    """The release asset the app on `platform` (default: this one) installs, or None if there's none."""
+    v = str(version).removeprefix("v")
+    platform = platform or sys.platform
+    if platform == "darwin":
+        return f"GameDevWorkstation-{v}-macos-arm64.zip"
+    if platform == "win32":
+        return f"GameDevWorkstation-{v}-x64-setup.exe"
+    return None
+
+
+def latest_release(repo: str, fetch: Fetch = _http_get) -> dict | None:
+    """GitHub's latest published release of `repo` (drafts and pre-releases excluded), or None."""
+    try:
+        data = json.loads(fetch(f"{API}/repos/{repo}/releases/latest"))
+    except Exception as e:  # noqa: BLE001 — offline, rate-limited, no release yet: all just "nothing"
+        log.info("couldn't read the latest release of %s: %s", repo, e)
+        return None
+    if not isinstance(data, dict) or not data.get("tag_name") or data.get("draft") or data.get("prerelease"):
+        return None
+    return data
+
+
+def download(url: str, dest: Path, size: int | None, fetch: Fetch = _http_get) -> Path:
+    """Fetch `url` into `dest` via a temp file; raise ValueError if the size isn't the advertised one."""
+    data = fetch(url)
+    if size is not None and len(data) != int(size):
+        raise ValueError(f"Downloaded {len(data)} bytes from {url}, expected {size}.")
+    dest.parent.mkdir(parents=True, exist_ok=True)
+    tmp = dest.with_name(f".{dest.name}.part")
+    try:
+        tmp.write_bytes(data)
+        os.replace(tmp, dest)
+    except BaseException:
+        tmp.unlink(missing_ok=True)
+        raise
+    return dest
+
+
+def _extract_app(archive: Path, folder: Path) -> Path:
+    """Unpack a zipped .app into `folder`; ditto keeps symlinks and the code signature intact."""
+    tmp = folder.with_name(f".{folder.name}.extracting")
+    shutil.rmtree(tmp, ignore_errors=True)
+    tmp.mkdir(parents=True)
+    try:
+        if shutil.which("ditto"):
+            r = subprocess.run(["ditto", "-x", "-k", str(archive), str(tmp)], capture_output=True, text=True,
+                               timeout=600)
+            if r.returncode != 0:
+                raise OSError(f"ditto failed: {r.stderr.strip()[:300]}")
+        else:
+            with zipfile.ZipFile(archive) as z:
+                root = tmp.resolve()
+                for m in z.namelist():
+                    if root not in (tmp / m).resolve().parents and (tmp / m).resolve() != root:
+                        raise OSError(f"{archive} has an entry outside the archive: {m}")
+                z.extractall(tmp)
+        if not (tmp / APP_NAME / "Contents" / "Info.plist").is_file():
+            raise OSError(f"{archive} doesn't contain {APP_NAME}.")
+        folder.mkdir(parents=True, exist_ok=True)
+        dst = folder / APP_NAME
+        shutil.rmtree(dst, ignore_errors=True)
+        os.replace(tmp / APP_NAME, dst)
+        return dst
+    finally:
+        shutil.rmtree(tmp, ignore_errors=True)
+
+
+class ReleaseFeed:
+    """Polls one GitHub repo's releases and drops new versions into the updates folder."""
+
+    def __init__(self, repo: str, *, interval_s: float = 3600.0, fetch: Fetch = _http_get,
+                 platform: str | None = None):
+        self.repo, self.interval_s, self.fetch = repo, float(interval_s), fetch
+        self.platform = platform or sys.platform
+        self.last_poll: float | None = None
+        self.last_error: str | None = None
+
+    def due(self, now: float | None = None) -> bool:
+        now = time.time() if now is None else now
+        return self.last_poll is None or now - self.last_poll >= self.interval_s
+
+    def poll(self, d: Path, current: str, *, is_newer: Callable[[Any, Any], bool],
+             now: float | None = None) -> dict | None:
+        """Download the latest release into `d` if it's newer than `current` and not there yet.
+        Returns the release record written (as in release.json), or None."""
+        from .updates import read_json, write_json_atomic  # updates.py imports this module
+
+        self.last_poll = time.time() if now is None else now
+        self.last_error = None
+        rel = latest_release(self.repo, self.fetch)
+        if not rel:
+            return None
+        version = str(rel["tag_name"]).removeprefix("v")
+        if not is_newer(version, current):
+            return None
+        name = asset_name(version, self.platform)
+        asset = next((a for a in rel.get("assets") or [] if isinstance(a, dict) and a.get("name") == name), None)
+        if not name or not asset or not asset.get("browser_download_url"):
+            return None
+        folder = d / version
+        existing = read_json(folder / "release.json")
+        if existing and str(existing.get("version")) == version:
+            return None  # already downloaded
+        try:
+            file = download(asset["browser_download_url"], d / DOWNLOADS / name, asset.get("size"), self.fetch)
+            record: dict = {"version": version, "built_at": rel.get("published_at"), "git_commit": None,
+                            "notes": str(rel.get("body") or ""), "source": "github", "tag": rel["tag_name"]}
+            if name.endswith(".exe"):
+                folder.mkdir(parents=True, exist_ok=True)
+                os.replace(file, folder / name)
+                record["installer"] = f"{version}/{name}"
+            else:
+                _extract_app(file, folder)
+                file.unlink(missing_ok=True)
+                record["app"] = f"{version}/{APP_NAME}"
+        except Exception as e:  # noqa: BLE001 — try again on the next poll
+            self.last_error = str(e)
+            log.warning("couldn't download release %s: %s", version, e)
+            return None
+        write_json_atomic(folder / "release.json", record)
+        write_json_atomic(d / "latest.json", record)  # last: only a complete release is advertised
+        return record
