+def test_windows_helper_script_quotes_paths():
+    s = U.windows_helper_script(app_pid=11, backend_pid=22, installer=Path("C:/it's/setup.exe"), app_exe=None)
+    assert "$AppPid = 11" in s and "$BackendPid = 22" in s and "'C:/it''s/setup.exe'" in s and "'/S'" in s
+    assert "$AppExe = $null" in s
+
