+def windows_helper_script(*, app_pid: int, backend_pid: int, installer: Path, app_exe: Path | None) -> str:
+    """PowerShell: stop the app and its backend, run the NSIS installer silently, start the app again.
+    Values are baked in as single-quoted literals (a ' is doubled), so paths can't break out."""
+    def lit(v: Any) -> str:
+        return "'" + str(v).replace("'", "''") + "'"
+
+    exe = lit(app_exe) if app_exe else "$null"
+    return f"""# GameDevWorkstation update helper (generated by the backend). Runs detached from the app.
+$ErrorActionPreference = 'Continue'
+$AppPid = {int(app_pid)}
+$BackendPid = {int(backend_pid)}
+$Installer = {lit(installer)}
+$AppExe = {exe}
+function Log($m) {{ Write-Output ((Get-Date -Format 'yyyy-MM-dd HH:mm:ss') + ' ' + $m) }}
+
+Log "update: $Installer (app pid $AppPid)"
+if (-not (Test-Path -LiteralPath $Installer)) {{ Log 'ERROR: the installer is missing; nothing changed'; exit 1 }}
+Start-Sleep -Seconds 1  # let the backend answer the request first
+
+# 1. Stop the app (it stops the backend), then the backend if it's still there.
+foreach ($id in @($AppPid, $BackendPid)) {{
+  if ($id -le 0) {{ continue }}
+  $p = Get-Process -Id $id -ErrorAction SilentlyContinue
+  if (-not $p) {{ continue }}
+  Log "stopping pid $id"
+  if ($id -eq $AppPid) {{ $null = $p.CloseMainWindow() }}
+  if (-not $p.WaitForExit(15000)) {{ Stop-Process -Id $id -Force -ErrorAction SilentlyContinue; $null = $p.WaitForExit(10000) }}
+}}
+Start-Sleep -Milliseconds 500
+
+# 2. Install silently (NSIS /S); it replaces the app in place.
+Log 'running the installer'
+$proc = Start-Process -FilePath $Installer -ArgumentList '/S' -PassThru -Wait
+$code = $proc.ExitCode
+if ($code -ne 0) {{ Log "ERROR: the installer exited with $code" }} else {{ Log 'installed' }}
+
+# 3. Start the app again (the new version, or the old one if the install failed).
+if ($AppExe -and (Test-Path -LiteralPath $AppExe)) {{
+  Log "starting $AppExe"
+  Start-Process -FilePath $AppExe
+}} else {{
+  Log 'note: start GameDevWorkstation from the Start menu'
+}}
+exit $code
+"""
+
