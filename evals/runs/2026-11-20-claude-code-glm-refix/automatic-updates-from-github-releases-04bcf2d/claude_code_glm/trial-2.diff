+# ------------------------------------------------------------- GitHub Releases
+
+
+def _fake_github(version: str, assets: dict[str, bytes]):
+    from gamedevworkstation.features import release_feed as R
+
+    calls = []
+
+    def fetch(url: str) -> bytes:
+        calls.append(url)
+        if url == f"{R.API}/repos/o/r/releases/latest":
+            return json.dumps({"tag_name": f"v{version}", "body": "Notes", "assets": [
+                {"name": n, "browser_download_url": f"https://dl/{n}", "size": len(b)} for n, b in assets.items()]}).encode()
+        return assets[url.removeprefix("https://dl/")]
+
+    return fetch, calls
+
+
+def test_asset_names_per_platform():
+    from gamedevworkstation.features import release_feed as R
+
+    assert R.asset_name("v1.2.3", "darwin") == "GameDevWorkstation-1.2.3-macos-arm64.zip"
+    assert R.asset_name("1.2.3", "win32") == "GameDevWorkstation-1.2.3-x64-setup.exe"
+    assert R.asset_name("1.2.3", "linux") is None
+
+
+def test_feed_downloads_windows_installer_into_the_folder(tmp_path):
+    from gamedevworkstation.features import release_feed as R
+
+    name = R.asset_name("9.0.0", "win32")
+    fetch, calls = _fake_github("9.0.0", {name: b"MZ-installer"})
+    feed = R.ReleaseFeed("o/r", fetch=fetch, platform="win32", interval_s=3600)
+    assert feed.due(0)
+    rel = feed.poll(tmp_path, "0.1.0", is_newer=U.is_newer, now=1000)
+    assert rel and rel["installer"] == f"9.0.0/{name}"
+    assert not feed.due(1001) and feed.due(1000 + 3600)
+    latest = U.validate_release(tmp_path, U.read_json(tmp_path / "latest.json"))
+    assert latest["version"] == "9.0.0" and latest["installer"] and Path(latest["app_path"]).read_bytes() == b"MZ-installer"
+    n = len(calls)
+    assert feed.poll(tmp_path, "0.1.0", is_newer=U.is_newer) is None and len(calls) == n + 1  # no second download
+    assert feed.poll(tmp_path, "9.0.0", is_newer=U.is_newer) is None
+
+
+def test_feed_rejects_a_short_download(tmp_path):
+    from gamedevworkstation.features import release_feed as R
+
+    with pytest.raises(ValueError):
+        R.download("u", tmp_path / "f", 10, fetch=lambda url: b"123")
+    assert not (tmp_path / "f").exists()
+
