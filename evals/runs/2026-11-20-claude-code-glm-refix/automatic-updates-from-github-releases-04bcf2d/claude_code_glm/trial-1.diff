+def windows_helper_script(*, app_pid: int, backend_pid: int, installer: Path, app_exe: Path | None) -> str:
+    """The Windows install-and-relaunch script (PowerShell). Values are baked in as single-quoted
+    literals. It stops the app (close, then kill), waits for the backend, runs the installer
+    silently and starts the app again, also when the installer failed (the old version is
+    then still in place)."""
+    def ps(s: str) -> str:
+        return "'" + s.replace("'", "''") + "'"
+
+    exe = ps(str(app_exe)) if app_exe else "''"
+    return f"""# GameDevWorkstation update helper (generated by the backend). Runs detached from the app.
+$ErrorActionPreference = 'Continue'
+$AppPid = {int(app_pid)}
+$BackendPid = {int(backend_pid)}
+$Installer = {ps(str(installer))}
+$AppExe = {exe}
+function Log($m) {{ Write-Output "$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') $m" }}
+
+Log "update: $Installer (app pid $AppPid)"
+if (-not (Test-Path -LiteralPath $Installer)) {{ Log "ERROR: the installer is missing; nothing changed"; exit 1 }}
+Start-Sleep -Seconds 1  # let the backend answer the request first
+
+# 1. Stop the app: ask its window to close, then kill it (with its children).
+$p = Get-Process -Id $AppPid -ErrorAction SilentlyContinue
+if ($p) {{
+  Log "asking the app to quit"
+  $null = $p.CloseMainWindow()
+  if (-not $p.WaitForExit(15000)) {{
+    Log "still running; stopping it"
+    & taskkill.exe /PID $AppPid /T /F | Out-Null
+    $null = $p.WaitForExit(10000)
+  }}
+}}
+if ($BackendPid -gt 0) {{
+  $b = Get-Process -Id $BackendPid -ErrorAction SilentlyContinue
+  if ($b -and -not $b.WaitForExit(15000)) {{
+    Log "the old backend (pid $BackendPid) is still running; stopping it"
+    & taskkill.exe /PID $BackendPid /T /F | Out-Null
+  }}
+}}
+Start-Sleep -Milliseconds 500
+
+# 2. Run the installer silently (NSIS: /S).
+Log "running the installer"
+$code = 1
+try {{
+  $r = Start-Process -FilePath $Installer -ArgumentList '/S' -Wait -PassThru
+  $code = $r.ExitCode
+}} catch {{
+  Log "ERROR: couldn't run the installer: $_"
+}}
+if ($code -eq 0) {{ Log "installed" }} else {{ Log "ERROR: the installer exited with $code" }}
+
+# 3. Start the app again (the new version, or the old one if the install failed).
+if ($AppExe -and (Test-Path -LiteralPath $AppExe)) {{
+  Log "starting the app"
+  Start-Process -FilePath $AppExe
+}} else {{
+  Log "note: couldn't find the app to start it; open GameDevWorkstation from the Start menu"
+}}
+if ($code -eq 0) {{ exit 0 }} else {{ exit 1 }}
+"""
+
