@@ -0,0 +1,206 @@
+"""Updates from GitHub Releases, for builds on the "github" update channel.
+
+The release workflow publishes every new version as GitHub Release v<version> with one asset
+per platform (see `asset_name`). A "github" build polls the repo's latest release now and then;
+when it's newer than the running version it downloads this platform's asset into the updates
+folder in the layout `make release` uses (`<dir>/<version>/` + `release.json`, then
+`latest.json` last), so the folder updater in updates.py takes it from there.
+
+- macOS: the asset is a zip of GameDevWorkstation.app, unpacked to `<dir>/<version>/`.
+- Windows: the asset is the NSIS installer, kept as `<dir>/<version>/<asset>`; release.json
+  points at it with "installer" instead of "app".
+
+Local builds (channel "local") never construct a ReleaseFeed, so they never call GitHub.
+"""
+from __future__ import annotations
+
+import json
+import logging
+import os
+import shutil
+import stat
+import subprocess
+import sys
+import time
+import urllib.request
+import zipfile
+from pathlib import Path
+from typing import Any, Callable
+
+from .. import __version__
+
+log = logging.getLogger(__name__)
+
+API = "https://api.github.com"
+APP_NAME = "GameDevWorkstation.app"
+DOWNLOADS = ".downloads"
+
+Fetch = Callable[[str], bytes]
+
+
+def _http_get(url: str) -> bytes:
+    req = urllib.request.Request(url, headers={"Accept": "application/vnd.github+json" if url.startswith(API) else "*/*",
+                                               "User-Agent": f"GameDevWorkstation/{__version__}"})
+    with urllib.request.urlopen(req, timeout=600) as r:  # noqa: S310 — fixed https URLs from GitHub
+        return r.read()
+
+
+def asset_name(version: str, platform: str | None = None) -> str | None:
+    """The release asset this platform installs from, or None where there is none."""
+    platform = platform or sys.platform
+    v = str(version).removeprefix("v")
+    if platform == "darwin":
+        return f"GameDevWorkstation-{v}-macos-arm64.zip"
+    if platform == "win32":
+        return f"GameDevWorkstation-{v}-x64-setup.exe"
+    return None
+
+
+def latest_release(repo: str, fetch: Fetch = _http_get) -> dict | None:
+    """The repo's latest published release as {version, tag, notes, published_at, assets}, or None
+    (no release, a draft or pre-release, the network is down, or the reply doesn't parse)."""
+    try:
+        data = json.loads(fetch(f"{API}/repos/{repo}/releases/latest"))
+    except Exception as e:  # noqa: BLE001 — offline or rate-limited is normal, not an error
+        log.info("couldn't read the latest release of %s: %s", repo, e)
+        return None
+    if not isinstance(data, dict) or data.get("draft") or data.get("prerelease"):
+        return None
+    tag = str(data.get("tag_name") or "")
+    if not tag:
+        return None
+    assets = {}
+    for a in data.get("assets") or []:
+        if isinstance(a, dict) and a.get("name") and a.get("browser_download_url"):
+            size = a.get("size")
+            assets[str(a["name"])] = {"url": str(a["browser_download_url"]),
+                                      "size": size if isinstance(size, int) else None}
+    return {"version": tag.removeprefix("v"), "tag": tag, "notes": str(data.get("body") or ""),
+            "published_at": data.get("published_at"), "assets": assets}
+
+
+def download(url: str, dest: Path, size: int | None, fetch: Fetch = _http_get) -> Path:
+    """Fetch `url` to `dest` via a .part file, so `dest` is only ever complete.
+    Raises ValueError when the size doesn't match what the release says."""
+    data = fetch(url)
+    if size is not None and len(data) != size:
+        raise ValueError(f"{dest.name}: got {len(data)} bytes, expected {size}")
+    dest.parent.mkdir(parents=True, exist_ok=True)
+    part = dest.with_name(dest.name + ".part")
+    try:
+        with part.open("wb") as f:
+            f.write(data)
+            f.flush()
+            os.fsync(f.fileno())
+        os.replace(part, dest)
+    except BaseException:
+        part.unlink(missing_ok=True)
+        raise
+    return dest
+
+
+def _unzip(archive: Path, dest: Path) -> None:
+    """Unpack keeping symlinks, permissions and the code signature: ditto when there, else zipfile
+    with the unix mode bits applied by hand. Entries may not leave `dest`."""
+    dest.mkdir(parents=True, exist_ok=True)
+    if shutil.which("ditto"):
+        r = subprocess.run(["ditto", "-x", "-k", str(archive), str(dest)], capture_output=True, text=True, timeout=600)
+        if r.returncode != 0:
+            raise OSError(f"ditto couldn't unpack {archive.name}: {r.stderr.strip()[:300]}")
+        return
+    root = dest.resolve()
+    with zipfile.ZipFile(archive) as z:
+        for info in z.infolist():
+            target = (dest / info.filename).resolve()
+            if target != root and root not in target.parents:
+                raise ValueError(f"{archive.name} has an entry outside the folder: {info.filename}")
+            mode = info.external_attr >> 16
+            if info.is_dir():
+                target.mkdir(parents=True, exist_ok=True)
+            elif stat.S_ISLNK(mode):
+                target.parent.mkdir(parents=True, exist_ok=True)
+                os.symlink(z.read(info).decode(), target)
+            else:
+                target.parent.mkdir(parents=True, exist_ok=True)
+                with z.open(info) as src, target.open("wb") as out:
+                    shutil.copyfileobj(src, out)
+                if mode & 0o777:
+                    os.chmod(target, mode & 0o777)
+
+
+class ReleaseFeed:
+    """Polls one repo's latest release at most every `interval_s` seconds."""
+
+    def __init__(self, repo: str, interval_s: float = 3600.0, fetch: Fetch = _http_get):
+        self.repo, self.interval_s, self.fetch = repo, max(60.0, float(interval_s)), fetch
+        self.last_check: float | None = None
+        self.last_error: str | None = None
+
+    def due(self, now: float | None = None) -> bool:
+        now = time.time() if now is None else now
+        return self.last_check is None or now - self.last_check >= self.interval_s
+
+    def poll(self, d: Path, current: str, *, is_newer: Callable[[Any, Any], bool],
+             platform: str | None = None, now: float | None = None, force: bool = False) -> dict | None:
+        """When due (or forced): download a newer release into `d` and advertise it in latest.json.
+        Returns the release.json written (or already there), else None. Never raises."""
+        if not force and not self.due(now):
+            return None
+        self.last_check = time.time() if now is None else now
+        try:
+            rel = self._poll(d, current, is_newer=is_newer, platform=platform)
+            self.last_error = None
+            return rel
+        except Exception as e:  # noqa: BLE001 — a bad download must never take the app down
+            log.warning("GitHub release update failed: %s", e)
+            self.last_error = str(e)
+            return None
+
+    def _poll(self, d: Path, current: str, *, is_newer: Callable[[Any, Any], bool],
+              platform: str | None) -> dict | None:
+        from .updates import read_json, validate_release, write_json_atomic
+
+        rel = latest_release(self.repo, self.fetch)
+        if not rel or not is_newer(rel["version"], current):
+            return None
+        version = rel["version"]
+        name = asset_name(version, platform)
+        asset = rel["assets"].get(name) if name else None
+        if not asset:
+            log.info("release %s has no %s asset", rel["tag"], name or "asset for this platform")
+            return None
+        folder = d / version
+        record = read_json(folder / "release.json")
+        if not validate_release(d, record):
+            record = self._fetch_into(d, folder, version, name, asset, rel, platform or sys.platform)
+            write_json_atomic(folder / "release.json", record)
+        latest = validate_release(d, read_json(d / "latest.json"))
+        if not latest or is_newer(version, latest["version"]):  # never hide a newer `make release` build
+            write_json_atomic(d / "latest.json", record)
+        return record
+
+    def _fetch_into(self, d: Path, folder: Path, version: str, name: str, asset: dict, rel: dict,
+                    platform: str) -> dict:
+        downloads = d / DOWNLOADS
+        if folder.exists() and not (folder / "release.json").exists():
+            shutil.rmtree(folder)  # a half-finished earlier attempt of ours (release.json is written last)
+        record: dict = {"version": version, "built_at": rel.get("published_at"), "git_commit": None,
+                        "notes": rel.get("notes") or "", "source": f"github:{self.repo}"}
+        if platform == "win32":
+            download(asset["url"], folder / name, asset["size"], self.fetch)
+            record["installer"] = f"{version}/{name}"
+            return record
+        archive = download(asset["url"], downloads / name, asset["size"], self.fetch)
+        tmp = downloads / f"{version}.unpack"
+        shutil.rmtree(tmp, ignore_errors=True)
+        try:
+            _unzip(archive, tmp)
+            if not (tmp / APP_NAME / "Contents" / "Info.plist").is_file():
+                raise ValueError(f"{name} doesn't contain {APP_NAME}")
+            folder.mkdir(parents=True, exist_ok=True)
+            os.replace(tmp / APP_NAME, folder / APP_NAME)
+        finally:
+            shutil.rmtree(tmp, ignore_errors=True)
+            archive.unlink(missing_ok=True)
+        record["app"] = f"{version}/{APP_NAME}"
+        return record
