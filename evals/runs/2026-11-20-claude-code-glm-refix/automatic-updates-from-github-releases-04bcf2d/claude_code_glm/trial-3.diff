+def windows_helper_script(*, app_pid: int, backend_pid: int, installer: Path, app_exe: Path | None) -> str:
+    """PowerShell helper for Windows: stop the app (and the backend), run the NSIS installer
+    silently, then start the app again. Values are baked in as single-quoted literals."""
+    def ps(v: Any) -> str:
+        return "'" + str(v).replace("'", "''") + "'"
+
+    return f"""# GameDevWorkstation update helper (generated by the backend). Runs detached from the app.
+$ErrorActionPreference = 'Continue'
+$AppPid = {int(app_pid)}
+$BackendPid = {int(backend_pid)}
+$Installer = {ps(installer)}
+$AppExe = {ps(app_exe or "")}
+function Log($m) {{ Write-Output ("{{0}} {{1}}" -f (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'), $m) }}
+
+Log "update: $Installer (app pid $AppPid)"
+if (-not (Test-Path -LiteralPath $Installer -PathType Leaf)) {{ Log 'ERROR: the installer is missing; nothing changed'; exit 1 }}
+Start-Sleep -Seconds 1  # let the backend answer the request first
+
+foreach ($id in @($AppPid, $BackendPid)) {{
+  if ($id -le 0) {{ continue }}
+  $p = Get-Process -Id $id -ErrorAction SilentlyContinue
+  if (-not $p) {{ continue }}
+  if ($id -eq $AppPid) {{ [void]$p.CloseMainWindow() }}
+  if (-not $p.WaitForExit(15000)) {{ Log "stopping pid $id"; Stop-Process -Id $id -Force -ErrorAction SilentlyContinue; [void]$p.WaitForExit(10000) }}
+}}
+Start-Sleep -Milliseconds 500
+
+Log 'running the installer'
+$code = 1
+try {{
+  $r = Start-Process -FilePath $Installer -ArgumentList '/S' -Wait -PassThru
+  $code = $r.ExitCode
+}} catch {{ Log "ERROR: couldn't run the installer: $_" }}
+if ($code -ne 0) {{ Log "ERROR: the installer exited with $code" }} else {{ Log 'installed' }}
+
+if ($AppExe -and (Test-Path -LiteralPath $AppExe -PathType Leaf)) {{
+  Log 'starting the app'
+  Start-Process -FilePath $AppExe
+}}
+exit $code
+"""
+
+
+def launch_windows_helper(script: str, log_path: Path) -> int:
+    """Run the PowerShell helper detached, so it outlives the app it stops."""
+    d = data_dir() / "updates-tmp"
+    d.mkdir(parents=True, exist_ok=True)
+    path = d / f"install-{int(time.time())}.ps1"
+    path.write_text(script, encoding="utf-8")
+    log_path.parent.mkdir(parents=True, exist_ok=True)
+    flags = getattr(subprocess, "DETACHED_PROCESS", 0) | getattr(subprocess, "CREATE_NEW_PROCESS_GROUP", 0) \
