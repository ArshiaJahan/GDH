@@ -0,0 +1,128 @@
+name: Release
+
+# When main carries a VERSION that has no GitHub Release yet, build the macOS app (zip + .dmg)
+# and the Windows installer on the "github" update channel and publish them as Release v<version>.
+# Asset names must match backend/gamedevworkstation/features/release_feed.py:asset_name.
+
+on:
+  push:
+    branches: [main]
+  workflow_dispatch:
+
+permissions:
+  contents: write
+
+concurrency:
+  group: release
+  cancel-in-progress: false
+
+jobs:
+  check:
+    name: Is this version released?
+    runs-on: ubuntu-latest
+    outputs:
+      version: ${{ steps.v.outputs.version }}
+      needed: ${{ steps.v.outputs.needed }}
+    steps:
+      - uses: actions/checkout@v4
+      - id: v
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          v="$(tr -d '[:space:]' < VERSION)"
+          echo "version=$v" >> "$GITHUB_OUTPUT"
+          if gh release view "v$v" --repo "$GITHUB_REPOSITORY" >/dev/null 2>&1; then
+            echo "needed=false" >> "$GITHUB_OUTPUT"; echo "v$v is already released"
+          else
+            echo "needed=true" >> "$GITHUB_OUTPUT"; echo "v$v has no release yet"
+          fi
+
+  macos:
+    needs: check
+    if: needs.check.outputs.needed == 'true'
+    runs-on: macos-latest
+    timeout-minutes: 60
+    env:
+      UV_PYTHON: "3.13"
+      GDW_UPDATE_CHANNEL: github
+    steps:
+      - uses: actions/checkout@v4
+      - uses: astral-sh/setup-uv@v6
+        with:
+          enable-cache: true
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: npm
+          cache-dependency-path: frontend/package-lock.json
+      - uses: dtolnay/rust-toolchain@stable
+        with:
+          targets: aarch64-apple-darwin
+      - uses: Swatinem/rust-cache@v2
+        with:
+          workspaces: src-tauri
+      - run: uv sync --frozen --all-extras
+      - run: ./scripts/build_mac.sh
+      - name: Zip the app for the updater
+        run: |
+          v="${{ needs.check.outputs.version }}"
+          ditto -c -k --keepParent dist/GameDevWorkstation.app "dist/GameDevWorkstation-$v-macos-arm64.zip"
+          mv dist/GameDevWorkstation.dmg "dist/GameDevWorkstation-$v-macos-arm64.dmg"
+      - uses: actions/upload-artifact@v4
+        with:
+          name: macos
+          path: |
+            dist/*-macos-arm64.zip
+            dist/*-macos-arm64.dmg
+          if-no-files-found: error
+
+  windows:
+    needs: check
+    if: needs.check.outputs.needed == 'true'
+    runs-on: windows-latest
+    timeout-minutes: 60
+    env:
+      UV_PYTHON: "3.13"
+      GDW_UPDATE_CHANNEL: github
+    steps:
+      - uses: actions/checkout@v4
+      - uses: astral-sh/setup-uv@v6
+        with:
+          enable-cache: true
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: npm
+          cache-dependency-path: frontend/package-lock.json
+      - uses: dtolnay/rust-toolchain@stable
+      - uses: Swatinem/rust-cache@v2
+        with:
+          workspaces: src-tauri
+      - name: Build the installer
+        shell: pwsh
+        run: |
+          uv sync --frozen --all-extras
+          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
+          ./scripts/build_windows.ps1
+      - uses: actions/upload-artifact@v4
+        with:
+          name: windows
+          path: dist/*-x64-setup.exe
+          if-no-files-found: error
+
+  publish:
+    needs: [check, macos, windows]
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/download-artifact@v4
+        with:
+          path: assets
+          merge-multiple: true
+      - name: Publish GitHub Release
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          v="${{ needs.check.outputs.version }}"
+          gh release create "v$v" assets/* --repo "$GITHUB_REPOSITORY" --target "$GITHUB_SHA" \
+            --title "GameDevWorkstation $v" --generate-notes
