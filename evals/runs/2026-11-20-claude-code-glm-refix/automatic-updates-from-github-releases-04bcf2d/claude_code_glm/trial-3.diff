diff --git a/tests/test_release_feed.py b/tests/test_release_feed.py
new file mode 100644
index 0000000..29b12d7
--- /dev/null
+++ b/tests/test_release_feed.py
@@ -0,0 +1,130 @@
+"""Updates from GitHub Releases: asset names, the feed laying releases out in the updates
+folder, auto-install (once per version, only when idle) and the Windows helper script."""
+import asyncio
+import io
+import json
+import plistlib
+import zipfile
+from pathlib import Path
+
+import pytest
+
+from gamedevworkstation.features import release_feed as RF
+from gamedevworkstation.features import updates as U
+
+from .test_updates import env, publish  # noqa: F401 — fixture
+
+
+def fake_github(tag: str, name: str, data: bytes):
+    rel = {"tag_name": tag, "body": "- Notes", "published_at": "2026-11-20T10:00:00Z",
+           "assets": [{"name": name, "browser_download_url": f"https://example.invalid/{name}", "size": len(data)}]}
+    calls = []
+
+    def fetch(url: str) -> bytes:
+        calls.append(url)
+        return json.dumps(rel).encode() if url.startswith(RF.API) else data
+
+    return fetch, calls
+
+
+def zipped_app(version: str) -> bytes:
+    buf = io.BytesIO()
+    with zipfile.ZipFile(buf, "w") as z:
+        z.writestr("GameDevWorkstation.app/Contents/Info.plist", plistlib.dumps(
+            {"CFBundleShortVersionString": version, "CFBundleIdentifier": U.BUNDLE_ID}))
+    return buf.getvalue()
+
+
+def test_asset_names():
+    assert RF.asset_name("v1.2.3", "darwin") == "GameDevWorkstation-1.2.3-macos-arm64.zip"
+    assert RF.asset_name("1.2.3", "win32") == "GameDevWorkstation-1.2.3-x64-setup.exe"
+    assert RF.asset_name("1.2.3", "linux") is None
+
+
+def test_latest_release_handles_errors_and_drafts():
+    def boom(url):
+        raise OSError("offline")
+
+    assert RF.latest_release("o/r", boom) is None
+    assert RF.latest_release("o/r", lambda u: b"not json") is None
+    assert RF.latest_release("o/r", lambda u: json.dumps({"tag_name": "v1.0.0", "draft": True}).encode()) is None
+    assert RF.latest_release("o/r", lambda u: json.dumps({"tag_name": "v1.0.0"}).encode())["tag_name"] == "v1.0.0"
+
+
+def test_download_checks_size(tmp_path):
+    with pytest.raises(ValueError):
+        RF.download("https://x/a", tmp_path / "a", 3, lambda u: b"four")
+    assert not list(tmp_path.iterdir())
+    assert RF.download("https://x/a", tmp_path / "a", 4, lambda u: b"four").read_bytes() == b"four"
+
+
+def test_poll_lays_out_a_mac_release(tmp_path):
+    d = tmp_path / "updates"
+    fetch, calls = fake_github("v9.1.0", RF.asset_name("9.1.0", "darwin"), zipped_app("9.1.0"))
+    feed = RF.ReleaseFeed("o/r", interval_s=3600, platform="darwin", fetch=fetch)
+    assert feed.due()
+    rec = feed.poll(d, "0.1.0", is_newer=U.is_newer, now=1000.0)
+    assert rec["version"] == "9.1.0" and not feed.due(now=1001.0) and feed.due(now=1000.0 + 3600)
+    rel = U.validate_release(d, U.read_json(d / "latest.json"))
+    assert rel["version"] == "9.1.0" and rel["notes"] == "- Notes"
+    assert [r["version"] for r in U.history(d)] == ["9.1.0"]
+    assert not list(d.glob(".download-*")) and not list((d / "9.1.0").glob("*.zip"))
+    n = len(calls)
+    feed.poll(d, "0.1.0", is_newer=U.is_newer)  # already there: no second download
+    assert len(calls) == n + 1
+
+
+def test_poll_skips_older_and_missing_assets(tmp_path):
+    fetch, calls = fake_github("v0.1.0", RF.asset_name("0.1.0", "darwin"), b"x")
+    assert RF.ReleaseFeed("o/r", platform="darwin", fetch=fetch).poll(tmp_path, "0.5.0", is_newer=U.is_newer) is None
+    fetch, calls = fake_github("v9.0.0", "something-else.zip", b"x")
+    assert RF.ReleaseFeed("o/r", platform="darwin", fetch=fetch).poll(tmp_path, "0.5.0", is_newer=U.is_newer) is None
+    assert len(calls) == 1 and not (tmp_path / "latest.json").exists()
+
+
+def test_poll_lays_out_a_windows_installer(tmp_path):
+    d = tmp_path / "updates"
+    fetch, _ = fake_github("v9.0.0", RF.asset_name("9.0.0", "win32"), b"MZ installer")
+    RF.ReleaseFeed("o/r", platform="win32", fetch=fetch).poll(d, "0.1.0", is_newer=U.is_newer)
+    rel = U.validate_release(d, U.read_json(d / "latest.json"))
+    assert rel["version"] == "9.0.0" and Path(rel["installer_path"]).read_bytes() == b"MZ installer"
+
+
+def test_local_builds_have_no_feed(env):  # noqa: F811
+    _, s, _ = env
+    assert s.extensions["updates"].feed is None  # never calls GitHub
+
+
+def test_auto_install_once_per_version_and_only_when_idle(env, monkeypatch):  # noqa: F811
+    _, s, d = env
+    up = s.extensions["updates"]
+    publish(d, "99.0.0")
+    up.check()
+    assert up.auto_install_enabled()
+    assert asyncio.run(up.maybe_auto_install()) is None  # from source: install unsupported
+    monkeypatch.setattr(up, "support", lambda: (True, None))
+    tries = []
+
+    async def fake_install(version, **kw):
+        tries.append(version)
+        raise U.HTTPException(500, "boom")
+
+    monkeypatch.setattr(up, "install", fake_install)
+    monkeypatch.setattr(up, "busy", lambda: 1)
+    assert asyncio.run(up.maybe_auto_install()) is None and tries == []
+    monkeypatch.setattr(up, "busy", lambda: 0)
+    assert asyncio.run(up.maybe_auto_install())["ok"] is False
+    assert asyncio.run(up.maybe_auto_install()) is None  # a failed version isn't retried
+    assert tries == ["99.0.0"]
+    s.config.updates["auto_install"] = False
+    publish(d, "99.1.0")
+    up.check()
+    assert asyncio.run(up.maybe_auto_install()) is None and tries == ["99.0.0"]
+
+
+def test_windows_helper_script_quotes_values():
+    script = U.windows_helper_script(app_pid=12, backend_pid=34, installer=Path("C:/It's here/setup.exe"),
+                                     app_exe=Path("C:/App/GameDevWorkstation.exe"))
+    assert "$AppPid = 12" in script and "$BackendPid = 34" in script
+    assert "'C:/It''s here/setup.exe'" in script and "'/S'" in script
+    assert "GameDevWorkstation.exe" in script
