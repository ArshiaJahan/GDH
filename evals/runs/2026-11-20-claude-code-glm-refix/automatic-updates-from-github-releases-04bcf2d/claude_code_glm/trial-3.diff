index 0000000..43215e3
--- /dev/null
+++ b/backend/gamedevworkstation/features/release_feed.py
@@ -0,0 +1,155 @@
+"""Updates from GitHub Releases (builds on the "github" update channel only).
+
+The release workflow publishes each version as GitHub Release `v<version>` with one asset per
+platform (see `asset_name`). This module looks at the latest release now and then, downloads
+the asset for this platform and lays it out in the updates folder exactly like `make release`
+does (`<dir>/<version>/` + `release.json`, then `latest.json` last), so the folder updater in
+updates.py takes it from there. Local builds never construct a feed, so they never call GitHub.
+"""
+from __future__ import annotations
+
+import json
+import logging
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+import urllib.error
+import urllib.request
+from pathlib import Path
+from typing import Any, Callable
+
+log = logging.getLogger(__name__)
+
+API = "https://api.github.com"
+APP_NAME = "GameDevWorkstation.app"
+
+Fetch = Callable[[str], bytes]
+
+
+def _http_get(url: str) -> bytes:
+    req = urllib.request.Request(url, headers={"Accept": "application/vnd.github+json" if url.startswith(API)
+                                               else "application/octet-stream",
+                                               "User-Agent": "GameDevWorkstation-updater"})
+    with urllib.request.urlopen(req, timeout=60) as r:  # noqa: S310 — fixed https URLs
+        return r.read()
+
+
+def asset_name(version: str, platform: str | None = None) -> str | None:
+    """The release asset this platform installs from, or None where updates aren't built."""
+    v = str(version).removeprefix("v")
+    p = platform or sys.platform
+    if p == "darwin":
+        return f"GameDevWorkstation-{v}-macos-arm64.zip"
+    if p == "win32":
+        return f"GameDevWorkstation-{v}-x64-setup.exe"
+    return None
+
+
+def latest_release(repo: str, fetch: Fetch = _http_get) -> dict | None:
+    """The newest published (non-draft, non-prerelease) release, or None (none yet, offline, bad reply)."""
+    try:
+        data = json.loads(fetch(f"{API}/repos/{repo}/releases/latest"))
+    except (OSError, ValueError, urllib.error.URLError) as e:
+        log.info("couldn't read the latest release of %s: %s", repo, e)
+        return None
+    if not isinstance(data, dict) or data.get("draft") or data.get("prerelease") or not data.get("tag_name"):
+        return None
+    return data
+
+
+def download(url: str, dest: Path, size: int | None, fetch: Fetch = _http_get) -> Path:
+    """Fetch `url` into `dest` (tmp file + rename). Raises ValueError if the size doesn't match."""
+    data = fetch(url)
+    if size is not None and len(data) != int(size):
+        raise ValueError(f"{url}: got {len(data)} bytes, expected {size}")
+    dest.parent.mkdir(parents=True, exist_ok=True)
+    fd, tmp = tempfile.mkstemp(dir=dest.parent, prefix=f".{dest.name}.", suffix=".part")
+    try:
+        with os.fdopen(fd, "wb") as f:
+            f.write(data)
+        os.replace(tmp, dest)
+    except BaseException:
+        Path(tmp).unlink(missing_ok=True)
+        raise
+    return dest
+
+
+def _unzip_app(zip_path: Path, into: Path) -> Path:
+    """Extract a zipped app bundle; ditto keeps symlinks, permissions and the signature."""
+    if shutil.which("ditto"):
+        r = subprocess.run(["ditto", "-x", "-k", str(zip_path), str(into)], capture_output=True, text=True,
+                           timeout=600)
+        if r.returncode != 0:
+            raise OSError(f"ditto failed: {r.stderr.strip()[:300]}")
+    else:
+        shutil.unpack_archive(str(zip_path), str(into), "zip")
+    app = into / APP_NAME
+    if not (app / "Contents" / "Info.plist").is_file():
+        raise ValueError(f"{zip_path.name} doesn't contain {APP_NAME}")
+    return app
+
+
+def _write_json(p: Path, data: dict) -> None:
+    from .updates import write_json_atomic
+
+    write_json_atomic(p, data)
+
+
+class ReleaseFeed:
+    def __init__(self, repo: str, interval_s: float = 3600.0, platform: str | None = None,
+                 fetch: Fetch = _http_get):
+        self.repo, self.platform, self.fetch = repo, platform or sys.platform, fetch
+        self.interval_s = max(60.0, float(interval_s))
+        self.last_checked: float | None = None
+        self.last_error: str | None = None
+
+    def due(self, now: float | None = None) -> bool:
+        now = time.time() if now is None else now
+        return self.last_checked is None or now - self.last_checked >= self.interval_s
+
+    def poll(self, d: Path, current: str, *, is_newer: Callable[[Any, Any], bool],
+             now: float | None = None) -> dict | None:
+        """Download the latest release into `d` when it's newer than `current`.
+        Returns the release record written (or already there), else None."""
+        self.last_checked = time.time() if now is None else now
+        rel = latest_release(self.repo, self.fetch)
+        if not rel:
+            return None
+        version = str(rel["tag_name"]).removeprefix("v")
+        if not is_newer(version, current):
+            return None
+        name = asset_name(version, self.platform)
+        asset = next((a for a in rel.get("assets") or [] if isinstance(a, dict) and a.get("name") == name), None)
+        if not name or not asset or not asset.get("browser_download_url"):
+            return None
+        record = {"version": version, "notes": str(rel.get("body") or ""), "built_at": rel.get("published_at"),
+                  "git_commit": None, "source": "github"}
+        record["installer" if self.platform == "win32" else "app"] = f"{version}/{name if self.platform == 'win32' else APP_NAME}"
+        final = d / version
+        if (final / "release.json").is_file():
+            existing = json.loads((final / "release.json").read_text())
+            _write_json(d / "latest.json", existing)
+            return existing
+        stage = d / f".download-{version}"
+        try:
+            shutil.rmtree(stage, ignore_errors=True)
+            stage.mkdir(parents=True)
+            got = download(asset["browser_download_url"], stage / name, asset.get("size"), self.fetch)
+            if self.platform != "win32":
+                _unzip_app(got, stage)
+                got.unlink()
+            _write_json(stage / "release.json", record)
+            if final.exists():
+                shutil.rmtree(final)
+            os.replace(stage, final)
+        except (OSError, ValueError, urllib.error.URLError) as e:
+            self.last_error = str(e)
+            log.warning("couldn't download update %s: %s", version, e)
+            shutil.rmtree(stage, ignore_errors=True)
+            return None
+        self.last_error = None
+        _write_json(d / "latest.json", record)  # last, so a half-download is never advertised
+        return record
