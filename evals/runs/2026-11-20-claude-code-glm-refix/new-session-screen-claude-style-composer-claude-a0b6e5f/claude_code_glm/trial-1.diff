@@ -0,0 +1,150 @@
+// The New screen: a greeting with the Mac account's first name and a large composer (Chat only /
+// Folder, folder chip, Claude model, effort, mode, Tools) with recent-folder pills. Nothing is made
+// until Send: then the session is created (on [sessions].default_harness, the Claude subscription by
+// default) and the message goes to it. A failed send keeps the text and reuses the session made.
+import { ArrowUp, Folder, MessageSquare, Wrench, X } from "lucide-react";
+import { useEffect, useRef, useState } from "react";
+import { get, patch, post } from "../lib/api";
+import { pickFolder } from "../lib/native";
+import { actions, upsertSession, useStore, type Session } from "../lib/store";
+import { ClaudeStatusNotice, useClaudeStatus } from "./ClaudeCode";
+import { SetupChecklist } from "./SetupChecklist";
+
+export const RECENT_MAX = 5;
+const MODES: [string, string][] = [["plan", "Plan"], ["ask", "Ask"], ["accept_edits", "Accept edits"]];
+
+type EnvModel = { id: string; display_name: string; provider: string; efforts: string[] };
+
+/** The session folders used most recently (newest first, no duplicates, Trash left out). */
+export function recentFolders(sessions: Session[], max = RECENT_MAX): string[] {
+  const out: string[] = [];
+  const sorted = [...sessions].filter((s) => s.folder && !s.deleted)
+    .sort((a, b) => (b.activity_at ?? b.updated_at ?? 0) - (a.activity_at ?? a.updated_at ?? 0));
+  for (const s of sorted) {
+    if (out.length >= max) break;
+    if (!out.includes(s.folder!)) out.push(s.folder!);
+  }
+  return out;
+}
+
+const baseName = (p: string) => p.replace(/\/+$/, "").split("/").pop() || p;
+
+export function NewSession() {
+  const sessions = useStore((s) => s.sessions);
+  const groupId = useStore((s) => s.newGroupId);
+  const [name, setName] = useState<string | null>(null);
+  const [env, setEnv] = useState<{ models: EnvModel[]; harnesses: Record<string, boolean> } | null>(null);
+  const [st, recheck] = useClaudeStatus(true);
+  const [text, setText] = useState("");
+  const [folder, setFolder] = useState<string | null>(null);
+  const [model, setModel] = useState("");
+  const [effort, setEffort] = useState("high");
+  const [mode, setMode] = useState("ask");
+  const [sharedTools, setSharedTools] = useState(false);
+  const [toolsOpen, setToolsOpen] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const made = useRef<Session | null>(null); // created by a send whose message then failed
+  const ta = useRef<HTMLTextAreaElement>(null);
+
+  useEffect(() => {
+    get<{ name: string | null }>("/greeting").then((r) => setName(r?.name ?? null)).catch(() => setName(null));
+    get("/environment").then((e) => setEnv(e ?? null)).catch(() => setEnv(null));
+  }, []);
+  const claudeModels = (env?.models ?? []).filter((m) => m.provider === "anthropic");
+  const current = claudeModels.find((m) => m.id === model) ?? claudeModels[0];
+  useEffect(() => { if (!model && claudeModels[0]) setModel(claudeModels[0].id); }, [claudeModels.length]);
+  const efforts = current?.efforts ?? ["none", "low", "medium", "high"];
+  const recent = recentFolders(sessions);
+
+  const send = async () => {
+    const t = text.trim();
+    if (!t || busy) return;
+    setBusy(true);
+    try {
+      let s = made.current;
+      if (!s || (s.folder ?? null) !== folder) {
+        s = await post<Session>("/sessions", {
+          ...(folder ? { folder } : {}), ...(current ? { model: current.id } : {}),
+          ...(efforts.includes(effort) ? { effort } : {}), mode, ...(groupId ? { group_id: groupId } : {}),
+        });
+        if (sharedTools) s = (await patch<Session>(`/sessions/${s.id}`, { settings: { shared_tools: true } })) ?? s;
+        made.current = s;
+        upsertSession(s);
+      }
+      await post(`/sessions/${s.id}/messages`, { text: t, attachments: [] });
+      made.current = null;
+      setText("");
+      useStore.setState({ newGroupId: null });
+      await actions.openSession(s.id);
+    } catch (e: any) {
+      actions.toast(e.message, "error"); // the text stays in the composer
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const choose = async () => {
+    const f = await pickFolder(folder ?? undefined);
+    if (f) setFolder(f);
+  };
+
+  return (
+    <div className="h-full overflow-y-auto scroll-thin" data-testid="new-session">
+      <div className="mx-auto flex min-h-full w-full max-w-[720px] flex-col justify-center gap-4 px-5 py-10">
+        <SetupChecklist />
+        <h1 className="text-center text-[26px] font-medium">{name ? `Hi ${name}, what are we making?` : "What are we making?"}</h1>
+        <ClaudeStatusNotice st={st} refresh={recheck} />
+        <div className="rounded-xl border border-line surface-raised p-3 shadow-sm">
+          <textarea id="composer" ref={ta} autoFocus rows={4} value={text} aria-label="Message"
+            placeholder={folder ? `Ask about ${baseName(folder)}, or hand over a job…` : "Ask anything…"}
+            className="w-full resize-none bg-transparent text-[14px] outline-none"
+            onChange={(e) => setText(e.target.value)}
+            onKeyDown={(e) => { if (e.key === "Enter" && !e.shiftKey && !e.nativeEvent.isComposing) { e.preventDefault(); send(); } }} />
+          <div className="mt-2 flex flex-wrap items-center gap-1.5 text-[12.5px]">
+            <div className="flex rounded-md border border-line" role="group" aria-label="Where it works">
+              <button className={`btn btn-ghost py-0.5 ${folder ? "" : "bg-sunken"}`} aria-pressed={!folder} onClick={() => setFolder(null)}><MessageSquare size={12} /> Chat only</button>
+              <button className={`btn btn-ghost py-0.5 ${folder ? "bg-sunken" : ""}`} aria-pressed={!!folder} onClick={choose}><Folder size={12} /> Folder</button>
+            </div>
+            {folder && (
+              <span className="chip max-w-[220px] gap-1" title={folder} data-testid="folder-chip">
+                <Folder size={12} aria-hidden /><span className="truncate">{baseName(folder)}</span>
+                <button aria-label="Remove folder" onClick={() => setFolder(null)}><X size={11} /></button>
+              </span>
+            )}
+            <select className="input py-0.5" aria-label="Model" value={current?.id ?? ""} onChange={(e) => setModel(e.target.value)}>
+              {claudeModels.map((m) => <option key={m.id} value={m.id}>{m.display_name}</option>)}
+            </select>
+            <select className="input py-0.5" aria-label="Effort" value={efforts.includes(effort) ? effort : efforts[efforts.length - 1]} onChange={(e) => setEffort(e.target.value)}>
+              {efforts.map((x) => <option key={x} value={x}>{x}</option>)}
+            </select>
+            <select className="input py-0.5" aria-label="Mode" value={mode} onChange={(e) => setMode(e.target.value)}>
+              {MODES.map(([v, l]) => <option key={v} value={v}>{l}</option>)}
+            </select>
+            <span className="relative">
+              <button className="btn btn-ghost py-0.5" aria-expanded={toolsOpen} onClick={() => setToolsOpen((o) => !o)}><Wrench size={12} /> Tools</button>
+              {toolsOpen && (
+                <div className="absolute left-0 top-full z-10 mt-1 w-[240px] rounded-md border border-line surface-raised p-2 shadow">
+                  <label className="flex items-center gap-2">
+                    <input type="checkbox" checked={sharedTools} onChange={(e) => setSharedTools(e.target.checked)} />
+                    Shared tools
+                  </label>
+                  <p className="mt-1 text-faint">Skills and MCP servers are in the side panel once the session starts.</p>
+                </div>
+              )}
+            </span>
+            <button className="btn btn-primary ml-auto px-2" aria-label="Send" disabled={!text.trim() || busy} onClick={send}><ArrowUp size={14} /></button>
+          </div>
+        </div>
+        {recent.length > 0 && (
+          <div className="flex flex-wrap justify-center gap-1.5" aria-label="Recent folders">
+            {recent.map((f) => (
+              <button key={f} className={`chip max-w-[200px] ${folder === f ? "border-action" : ""}`} title={f} onClick={() => setFolder(f)}>
+                <Folder size={12} aria-hidden /><span className="truncate">{baseName(f)}</span>
+              </button>
+            ))}
+          </div>
+        )}
+      </div>
+    </div>
+  );
+}
