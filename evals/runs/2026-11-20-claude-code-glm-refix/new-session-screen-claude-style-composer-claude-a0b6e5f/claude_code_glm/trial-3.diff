+// The New screen: a greeting, a large composer (Chat only / Folder, model, effort, mode, Tools) and
+// recent-folder pills. Nothing is created until Send: then POST /sessions, then the first message.
+import { ArrowUp, Folder, MessageSquare, Wrench, X } from "lucide-react";
+import { useEffect, useMemo, useState } from "react";
+import { get, post } from "../lib/api";
+import { pickFolder } from "../lib/native";
+import { actions, useStore, type Session } from "../lib/store";
+import { ClaudeStatusNotice, HarnessSelect, harnessName, useClaudeStatus } from "./ClaudeCode";
+import { Popover } from "./Popover";
+import { SetupChecklist } from "./SetupChecklist";
+import { modelLabel } from "./ui";
+
+const RECENT_MAX = 5;
+const EFFORTS = ["none", "low", "medium", "high", "xhigh", "max"];
+const MODES: [string, string][] = [["plan", "Plan"], ["ask", "Ask"], ["accept_edits", "Accept edits"]];
+const tilde = (f: string) => f.replace(/^\/Users\/[^/]+/, "~");
+
+/** The folders of the most recently active sessions (newest first, no repeats, Trash left out). */
+export function recentFolders(sessions: Session[], max = RECENT_MAX): string[] {
+  const out: string[] = [];
+  const sorted = sessions.filter((s) => s.folder && !s.deleted)
+    .sort((a, b) => (b.activity_at ?? b.created_at) - (a.activity_at ?? a.created_at));
+  for (const s of sorted) {
+    if (out.length >= max) break;
+    if (!out.includes(s.folder!)) out.push(s.folder!);
+  }
+  return out;
+}
+
+export function NewSession() {
+  const appState = useStore((s) => s.appState);
+  const sessions = useStore((s) => s.sessions);
+  const composing = useStore((s) => s.composing);
+  const [name, setName] = useState<string | null>(null);
+  const [env, setEnv] = useState<any>(null);
+  const [st, refreshSt] = useClaudeStatus(true);
+  const [text, setText] = useState("");
+  const [folder, setFolder] = useState<string | null>(null);
+  const [chatOnly, setChatOnly] = useState(true);
+  const [model, setModel] = useState("");
+  const [effort, setEffort] = useState("");
+  const [mode, setMode] = useState("ask");
+  const defaultHarness: string = appState?.sessions?.default_harness ?? "claude_code";
+  const [harness, setHarness] = useState<string>(defaultHarness);
+  const [tools, setTools] = useState(false);
+  const [busy, setBusy] = useState(false);
+  // A session made before its first message failed: Send again reuses it instead of making another.
+  const [made, setMade] = useState<Session | null>(null);
+
+  useEffect(() => {
+    get<{ name: string | null }>("/greeting").then((r) => setName(r?.name ?? null)).catch(() => {});
+    get("/environment").then(setEnv).catch(() => {});
+  }, []);
+  const ccReady = !!st?.installed && st.logged_in;
+  // No claude CLI here: the session falls back to the built-in loop (the backend does the same).
+  const effHarness = harness === "claude_code" && env && !env.harnesses?.claude_code ? "builtin" : harness;
+  const models: { id: string; display_name: string; provider: string; efforts: string[] }[] = env?.models ?? [];
+  const shownModels = effHarness === "claude_code" ? models.filter((m) => m.provider === "anthropic") : models;
+  const efforts = models.find((m) => m.id === model)?.efforts ?? EFFORTS;
+  const recent = useMemo(() => recentFolders(sessions), [sessions]);
+
+  const choose = async () => {
+    const f = await pickFolder(folder ?? undefined);
+    if (f === null) return;
+    setFolder(f || null);
+    setChatOnly(!f);
+  };
+
+  const send = async () => {
+    const t = text.trim();
+    if (!t || busy) return;
+    setBusy(true);
+    try {
+      const s = made ?? await post<Session>("/sessions", {
+        ...(chatOnly || !folder ? {} : { folder }), ...(model ? { model } : {}), ...(effort ? { effort } : {}),
+        mode, ...(harness !== defaultHarness ? { harness: effHarness } : {}), // the default: the backend falls back without the CLI
+        ...(composing?.group_id ? { group_id: composing.group_id } : {}),
+      });
+      setMade(s);
+      await post(`/sessions/${s.id}/messages`, { text: t, attachments: [] });
+      setText("");
+      await actions.openSession(s.id);
+    } catch (e: any) {
+      // The text stays here so nothing typed is lost; Send again reuses the session.
+      actions.toast(e.message, "error");
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <div className="h-full overflow-y-auto scroll-thin" data-testid="new-session">
+      <div className="max-w-[720px] mx-auto px-5 pt-[12vh] pb-10 flex flex-col gap-4">
+        <h1 className="text-[28px] font-medium text-center">{name ? `Hi ${name}, what are we building?` : "What are we building?"}</h1>
+        {effHarness === "claude_code" && !ccReady && <ClaudeStatusNotice st={st} onRefresh={refreshSt} />}
+        <div className="rounded-xl border border-line surface-raised shadow-sm">
+          <textarea id="new-session-input" autoFocus className="w-full resize-none bg-transparent px-4 pt-3 pb-2 text-[15px] outline-none min-h-[110px]"
+            placeholder="How can I help?" aria-label="First message" value={text} disabled={busy}
+            onChange={(e) => setText(e.target.value)}
+            onKeyDown={(e) => { if (e.key === "Enter" && !e.shiftKey && !e.nativeEvent.isComposing) { e.preventDefault(); send(); } }} />
+          <div className="flex flex-wrap items-center gap-1.5 px-2 pb-2 text-[12.5px]">
+            <div className="flex rounded-md border border-line overflow-hidden" role="group" aria-label="Where the session works">
+              <button className={`px-2 py-0.5 flex items-center gap-1 ${chatOnly ? "bg-sunken text-text" : "text-muted"}`} aria-pressed={chatOnly}
+                onClick={() => setChatOnly(true)}><MessageSquare size={12} aria-hidden />Chat only</button>
+              <button className={`px-2 py-0.5 flex items-center gap-1 ${!chatOnly ? "bg-sunken text-text" : "text-muted"}`} aria-pressed={!chatOnly}
+                onClick={() => (folder ? setChatOnly(false) : choose())}><Folder size={12} aria-hidden />Folder</button>
+            </div>
+            {!chatOnly && folder && (
+              <span className="chip max-w-[260px]" data-testid="folder-chip" title={folder}>
+                <button className="truncate hover:text-action" onClick={choose}>{tilde(folder)}</button>
+                <button aria-label="Remove folder" onClick={() => { setFolder(null); setChatOnly(true); }}><X size={11} /></button>
+              </span>
+            )}
+            <select className="input py-0.5 w-auto" aria-label="Model" value={model} onChange={(e) => setModel(e.target.value)}>
+              <option value="">{effHarness === "claude_code" ? "Claude (default)" : "Default model"}</option>
+              {shownModels.map((m) => <option key={m.id} value={m.id}>{m.display_name || modelLabel(m.id)}</option>)}
+            </select>
+            <select className="input py-0.5 w-auto" aria-label="Effort" value={effort} onChange={(e) => setEffort(e.target.value)}>
+              <option value="">Effort (default)</option>
+              {efforts.map((x) => <option key={x} value={x}>{x}</option>)}
+            </select>
+            <div className="flex rounded-md border border-line overflow-hidden" role="group" aria-label="Mode">
+              {MODES.map(([v, l]) => (
+                <button key={v} className={`px-2 py-0.5 ${mode === v ? "bg-sunken text-text" : "text-muted"}`} aria-pressed={mode === v} onClick={() => setMode(v)}>{l}</button>
+              ))}
+            </div>
+            <div className="relative">
+              <button className="btn btn-ghost py-0.5 px-1.5" aria-expanded={tools} onClick={() => setTools((x) => !x)}><Wrench size={12} aria-hidden /> Tools</button>
+              <Popover open={tools} onClose={() => setTools(false)} label="Tools" className="w-[280px] p-3 text-[13px] flex flex-col gap-2">
+                <label className="flex flex-col gap-1">
+                  <span className="label">Runs on</span>
+                  <HarnessSelect value={effHarness} available={env?.harnesses} onChange={setHarness} />
+                </label>
+                <span className="text-faint text-[12px]">
+                  {effHarness === "claude_code" ? "Your Claude subscription through the claude CLI. Workflows need the built-in loop." : `${harnessName(effHarness)}: API billing and spend limits apply.`}
+                </span>
+              </Popover>
+            </div>
+            <span className="ml-auto text-faint hidden sm:inline">{harnessName(effHarness)}</span>
+            <button className="btn btn-primary px-2 py-1" aria-label="Send" disabled={!text.trim() || busy} onClick={send}><ArrowUp size={14} /></button>
+          </div>
+        </div>
+        {recent.length > 0 && (
+          <div className="flex flex-wrap justify-center gap-1.5" aria-label="Recent folders">
+            {recent.map((f) => (
+              <button key={f} className={`chip hover:text-action ${!chatOnly && folder === f ? "text-text" : ""}`} title={f}
+                onClick={() => { setFolder(f); setChatOnly(false); }}><Folder size={11} aria-hidden />{tilde(f).split("/").pop() || tilde(f)}</button>
+            ))}
+          </div>
+        )}
+        <div className="pt-4"><SetupChecklist /></div>
+      </div>
+    </div>
+  );
+}
