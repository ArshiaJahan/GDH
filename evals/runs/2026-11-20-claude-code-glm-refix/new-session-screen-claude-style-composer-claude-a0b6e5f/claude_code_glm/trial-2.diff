+// The New session screen (⌘N): a greeting with the Mac account's first name, a large composer with
+// Chat only / Folder, the folder chip, Claude model, effort, mode and Tools (the harness), and pills for
+// recent folders. Nothing exists until Send: then the session is created and the first message sent.
+// A failed send keeps the text, so nothing typed is lost.
+import { ArrowUp, Folder, MessageSquare, Wrench, X } from "lucide-react";
+import { useEffect, useMemo, useState } from "react";
+import { get, post } from "../lib/api";
+import { pickFolder } from "../lib/native";
+import { actions, useStore, type Session } from "../lib/store";
+import { ClaudeStatusNotice, HarnessSelect, harnessName, useClaudeStatus } from "./ClaudeCode";
+import { SetupChecklist } from "./SetupChecklist";
+import { LEVELS, providerModels, useModelCatalog } from "./ui";
+
+const RECENT_MAX = 5;
+const MODES: [string, string][] = [["plan", "Plan"], ["ask", "Ask"], ["accept_edits", "Accept edits"]];
+
+/** The folders of the most recently active sessions, newest first, without repeats or Trash. */
+export function recentFolders(sessions: Session[], max = RECENT_MAX): string[] {
+  const out: string[] = [];
+  const order = [...sessions].filter((s) => s.folder && !s.deleted)
+    .sort((a, b) => (b.activity_at ?? b.updated_at ?? 0) - (a.activity_at ?? a.updated_at ?? 0));
+  for (const s of order) {
+    if (out.length >= max) break;
+    if (!out.includes(s.folder!)) out.push(s.folder!);
+  }
+  return out;
+}
+
+const baseName = (p: string) => p.replace(/\/+$/, "").split("/").pop() || p;
+
+function partOfDay(d = new Date()): string {
+  const h = d.getHours();
+  return h < 5 ? "Good evening" : h < 12 ? "Good morning" : h < 18 ? "Good afternoon" : "Good evening";
+}
+
+export function NewSession() {
+  useModelCatalog();
+  const sessions = useStore((s) => s.sessions);
+  const group_id = useStore((s) => s.composeGroup ?? null);
+  const models = providerModels("anthropic");
+  const [name, setName] = useState<string | null>(null);
+  const [env, setEnv] = useState<any>(null);
+  const [text, setText] = useState("");
+  const [folderMode, setFolderMode] = useState(false);
+  const [folder, setFolder] = useState<string | null>(null);
+  const [model, setModel] = useState("");
+  const [effort, setEffort] = useState("medium");
+  const [mode, setMode] = useState("ask");
+  const [harness, setHarness] = useState("claude_code");
+  const [picked, setPicked] = useState(false); // unpicked: the server's [sessions].default_harness
+  const [toolsOpen, setToolsOpen] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [st, refresh] = useClaudeStatus(harness === "claude_code");
+  const recent = useMemo(() => recentFolders(sessions), [sessions]);
+
+  useEffect(() => { get<{ name: string | null }>("/greeting").then((r) => setName(r?.name ?? null)).catch(() => setName(null)); }, []);
+  useEffect(() => {
+    get<any>("/environment").then((e) => {
+      setEnv(e);
+      if (e?.harnesses && !e.harnesses.claude_code) setHarness("builtin"); // no claude CLI: the built-in loop
+    }).catch(() => setEnv(null));
+  }, []);
+  useEffect(() => { if (!model && models.length) setModel(models[0].id); }, [models.length]);
+
+  const chooseFolder = async () => {
+    const f = await pickFolder(folder ?? undefined);
+    if (f) { setFolder(f); setFolderMode(true); }
+  };
+
+  const send = async () => {
+    const t = text.trim();
+    if (!t || busy) return;
+    if (folderMode && !folder) return actions.toast("Pick a folder first, or switch to Chat only.", "error");
+    setBusy(true);
+    let s: Session | null = null;
+    try {
+      s = await post<Session>("/sessions", {
+        ...(folderMode && folder ? { folder } : {}), ...(model ? { model } : {}), effort, mode,
+        ...(picked ? { harness } : {}), ...(group_id ? { group_id } : {}),
+      });
+      await post(`/sessions/${s.id}/messages`, { text: t, attachments: [] });
+      setText("");
+      await actions.openSession(s.id);
+    } catch (e: any) {
+      // Keep the text; a session already made opens so the message can be sent again from there.
+      actions.toast(e?.message ?? "Couldn't start the session", "error");
+      if (s) {
+        await actions.openSession(s.id);
+        actions.setComposerText(t);
+      }
+    } finally { setBusy(false); }
+  };
+
+  return (
+    <div className="h-full overflow-y-auto scroll-thin" data-testid="new-session">
+      <div className="max-w-[720px] mx-auto px-5 pt-[14vh] pb-10 flex flex-col gap-4">
+        <SetupChecklist />
+        <h1 className="text-[28px] font-serif text-center">{partOfDay()}{name ? `, ${name}` : ""}</h1>
+        <div className="rounded-xl border border-line surface-raised shadow-sm">
+          <textarea id="new-session-composer" className="w-full resize-none bg-transparent px-4 pt-4 pb-2 text-[15px] outline-none min-h-[110px]"
+            placeholder="How can I help you today?" aria-label="Message" value={text} disabled={busy}
+            onChange={(e) => setText(e.target.value)}
+            onKeyDown={(e) => { if (e.key === "Enter" && !e.shiftKey && !e.nativeEvent.isComposing) { e.preventDefault(); send(); } }} />
+          <div className="flex flex-wrap items-center gap-1.5 px-3 pb-3 text-[12.5px]">
+            <div role="group" aria-label="Where it works" className="flex rounded-md border border-line overflow-hidden">
+              <button className={`px-2 py-0.5 flex items-center gap-1 ${!folderMode ? "bg-sunken" : ""}`} aria-pressed={!folderMode} onClick={() => setFolderMode(false)}>
+                <MessageSquare size={12} aria-hidden /> Chat only
+              </button>
+              <button className={`px-2 py-0.5 flex items-center gap-1 ${folderMode ? "bg-sunken" : ""}`} aria-pressed={folderMode}
+                onClick={() => (folder ? setFolderMode(true) : chooseFolder())}>
+                <Folder size={12} aria-hidden /> Folder
+              </button>
+            </div>
+            {folderMode && folder && (
+              <span className="chip gap-1 min-w-0 max-w-[220px]" title={folder} data-testid="folder-chip">
+                <button className="truncate" onClick={chooseFolder} aria-label="Change folder">{baseName(folder)}</button>
+                <button aria-label="Clear folder" onClick={() => { setFolder(null); setFolderMode(false); }}><X size={11} /></button>
+              </span>
+            )}
+            <select className="input py-0.5" aria-label="Model" value={model} onChange={(e) => setModel(e.target.value)}>
+              {models.map((m) => <option key={m.id} value={m.id}>{m.name}</option>)}
+            </select>
+            <select className="input py-0.5" aria-label="Effort" value={effort} onChange={(e) => setEffort(e.target.value)}>
+              {LEVELS.map((l) => <option key={l} value={l}>{l}</option>)}
+            </select>
+            <select className="input py-0.5" aria-label="Mode" value={mode} onChange={(e) => setMode(e.target.value)}>
+              {MODES.map(([v, l]) => <option key={v} value={v}>{l}</option>)}
+            </select>
+            <button className="btn btn-ghost py-0.5" aria-expanded={toolsOpen} onClick={() => setToolsOpen(!toolsOpen)} title={harnessName(harness)}>
+              <Wrench size={12} aria-hidden /> Tools
+            </button>
+            <button className="btn btn-primary ml-auto px-2 py-1" aria-label="Send" disabled={busy || !text.trim()} onClick={send}>
+              <ArrowUp size={14} />
+            </button>
+          </div>
+          {toolsOpen && (
+            <div className="flex items-center gap-2 border-t border-line px-3 py-2 text-[12.5px]" data-testid="new-session-tools">
+              <span className="text-muted">Run with</span>
+              <HarnessSelect value={harness} available={env?.harnesses} onChange={(v) => { setHarness(v); setPicked(true); }} />
+            </div>
+          )}
+        </div>
+        {harness === "claude_code" && <ClaudeStatusNotice st={st} onRefresh={refresh} />}
+        {recent.length > 0 && (
+          <div className="flex flex-wrap justify-center gap-1.5" aria-label="Recent folders">
+            {recent.map((f) => (
+              <button key={f} className={`chip gap-1 ${folderMode && folder === f ? "border-action" : ""}`} title={f}
+                aria-pressed={folderMode && folder === f} onClick={() => { setFolder(f); setFolderMode(true); }}>
+                <Folder size={11} aria-hidden /> {baseName(f)}
+              </button>
+            ))}
+          </div>
+        )}
+      </div>
+    </div>
+  );
+}
