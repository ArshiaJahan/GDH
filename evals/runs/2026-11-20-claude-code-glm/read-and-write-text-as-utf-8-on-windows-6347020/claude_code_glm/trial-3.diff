diff --git a/tests/test_utf8_io.py b/tests/test_utf8_io.py
new file mode 100644
index 0000000..4eaf551
--- /dev/null
+++ b/tests/test_utf8_io.py
@@ -0,0 +1,78 @@
+"""Text I/O names its encoding: Windows decodes with the ANSI code page (cp1252) by default, so a UTF-8
+SKILL.md with a curly quote crashed sessions there. These checks run on every platform."""
+import ast
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from gamedevworkstation.skills import parse_skill
+
+ROOT = Path(__file__).resolve().parents[1]
+SOURCES = sorted([*(ROOT / "backend").rglob("*.py"), *(ROOT / "scripts").rglob("*.py"),
+                  *(ROOT / "packaging").rglob("*.py")])
+SUBPROCESS_TEXT = {"run", "Popen", "check_output", "check_call", "call"}
+
+
+def _kw(call: ast.Call, name: str) -> ast.expr | None:
+    return next((k.value for k in call.keywords if k.arg == name), None)
+
+
+def _truthy(node: ast.expr | None) -> bool:
+    return node is not None and not (isinstance(node, ast.Constant) and not node.value)
+
+
+def _mode(call: ast.Call, pos: int) -> ast.expr | None:
+    return _kw(call, "mode") or (call.args[pos] if len(call.args) > pos else None)
+
+
+def _problem(call: ast.Call) -> str | None:
+    f = call.func
+    name = f.id if isinstance(f, ast.Name) else f.attr if isinstance(f, ast.Attribute) else None
+    owner = f.value.id if isinstance(f, ast.Attribute) and isinstance(f.value, ast.Name) else None
+    has_enc = _kw(call, "encoding") is not None or any(k.arg is None for k in call.keywords)
+    if name in ("read_text", "write_text"):
+        return None if has_enc else name
+    if name == "fdopen" or (name == "open" and owner not in ("os", "webbrowser", "self")):
+        mode = _mode(call, 1 if isinstance(f, ast.Name) or name == "fdopen" else 0)
+        if mode is not None and not isinstance(mode, ast.Constant):
+            return None  # not a file-mode call (zipfile member, terminal tab, ...)
+        if mode is not None and "b" in str(mode.value):
+            return None
+        return None if has_enc else name
+    if owner == "subprocess" and name in SUBPROCESS_TEXT:
+        if _truthy(_kw(call, "text")) or _truthy(_kw(call, "universal_newlines")):
+            return None if has_enc else f"subprocess.{name}(text=True)"
+    return None
+
+
+def test_every_text_io_call_names_its_encoding():
+    bad = []
+    for p in SOURCES:
+        for node in ast.walk(ast.parse(p.read_text(encoding="utf-8"), str(p))):
+            if isinstance(node, ast.Call) and (what := _problem(node)):
+                bad.append(f"{p.relative_to(ROOT)}:{node.lineno}: {what} without encoding=")
+    assert not bad, "\n".join(bad)
+
+
+def test_bundled_skills_load_without_the_default_encoding(tmp_path):
+    """Listing and loading every bundled skill never falls back to the locale's encoding (cp1252 on Windows)."""
+    code = ("from gamedevworkstation.skills import get_skill, list_skills\n"
+            "skills = [s for s in list_skills() if s['source'] == 'builtin']\n"
+            "assert skills\n"
+            "for s in skills:\n"
+            "    assert get_skill(s['name'])['content']\n")
+    env = {**os.environ, "GDW_HOME": str(tmp_path), "PYTHONUTF8": "0", "PYTHONPATH": str(ROOT / "backend")}
+    r = subprocess.run([sys.executable, "-X", "warn_default_encoding", "-W", "error::EncodingWarning", "-c", code],
+                       capture_output=True, text=True, encoding="utf-8", errors="replace", env=env, cwd=tmp_path)
+    assert r.returncode == 0, r.stderr
+
+
+@pytest.mark.parametrize("text", ["“curly” quotes — dash", "émoji 🎮"])
+def test_skill_files_round_trip_utf8(text, tmp_path):
+    p = tmp_path / "SKILL.md"
+    p.write_text(f"---\nname: x\ndescription: {text}\n---\nbody {text}\n", encoding="utf-8")
+    meta, body = parse_skill(p.read_text(encoding="utf-8"))
+    assert meta["description"] == text and text in body
