             Assert.AreEqual(2, board.CoinsCollected);
             Assert.AreEqual(2 * ScoreBoard.PointsPerCoin, board.Score);
         }
+
+        [Test]
+        public void M0_S02_EveryFifthCoinIsWorthDouble()
+        {
+            var board = new ScoreBoard(12);
+            for (int i = 0; i < 4; i++) board.Collect();
+            Assert.AreEqual(4 * ScoreBoard.PointsPerCoin, board.Score);
+            board.Collect(); // 5th
+            Assert.AreEqual(4 * ScoreBoard.PointsPerCoin + 2 * ScoreBoard.PointsPerCoin, board.Score);
+            for (int i = 0; i < 5; i++) board.Collect(); // 6th..10th
+            Assert.AreEqual(10, board.CoinsCollected);
+            Assert.AreEqual(120, board.Score); // 8 coins x 10 + 2 streak coins x 20
+            board.Collect(); // 11th
+            Assert.AreEqual(130, board.Score);
+        }
+
+        [Test]
+        public void M0_S02_PickupsAfterWinningScoreNothing()
+        {
+            var board = new ScoreBoard(4);
+            for (int i = 0; i < 4; i++) board.Collect();
+            Assert.IsTrue(board.Won);
+            board.Collect(); // would be the 5th, but the game is already won
+            Assert.AreEqual(4, board.CoinsCollected);
+            Assert.AreEqual(4 * ScoreBoard.PointsPerCoin, board.Score);
+        }
     }
 }
