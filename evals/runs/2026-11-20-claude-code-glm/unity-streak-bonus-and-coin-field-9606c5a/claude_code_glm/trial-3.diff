+        [Test]
+        public void M0_S02_EveryFifthCoinIsWorthDouble()
+        {
+            var board = new ScoreBoard(10);
+            for (int i = 0; i < 4; i++) board.Collect();
+            Assert.AreEqual(40, board.Score);
+            board.Collect();
+            Assert.AreEqual(60, board.Score);
+            for (int i = 0; i < 5; i++) board.Collect();
+            Assert.AreEqual(120, board.Score);
+            Assert.IsTrue(board.Won);
+            board.Collect();
+            Assert.AreEqual(120, board.Score);
+        }
     }
