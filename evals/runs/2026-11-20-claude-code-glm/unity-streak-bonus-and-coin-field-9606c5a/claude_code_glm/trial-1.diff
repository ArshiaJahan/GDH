diff --git a/examples/unity-sample/Assets/Tests/Editor/ScoreBoardTests.cs b/examples/unity-sample/Assets/Tests/Editor/ScoreBoardTests.cs
index c8d6c83..2eaf4c7 100644
--- a/examples/unity-sample/Assets/Tests/Editor/ScoreBoardTests.cs
+++ b/examples/unity-sample/Assets/Tests/Editor/ScoreBoardTests.cs
@@ -26,5 +26,29 @@ namespace CoinDash.Tests
             Assert.AreEqual(2, board.CoinsCollected);
             Assert.AreEqual(2 * ScoreBoard.PointsPerCoin, board.Score);
         }
+
+        [Test]
+        public void M0_S02_EveryFifthCoinScoresDouble()
+        {
+            var board = new ScoreBoard(12);
+            for (int i = 0; i < 4; i++) board.Collect();
+            Assert.AreEqual(4 * ScoreBoard.PointsPerCoin, board.Score);
+            board.Collect();
+            Assert.AreEqual(4 * 10 + 20, board.Score);
+            for (int i = 0; i < 5; i++) board.Collect();
+            Assert.AreEqual(2 * (4 * 10 + 20), board.Score);
+            board.Collect();
+            Assert.AreEqual(2 * (4 * 10 + 20) + 10, board.Score);
+        }
+
+        [Test]
+        public void M0_S02_StreakBonusStopsAfterWin()
+        {
+            var board = new ScoreBoard(4);
+            for (int i = 0; i < 5; i++) board.Collect();
+            Assert.IsTrue(board.Won);
+            Assert.AreEqual(4, board.CoinsCollected);
+            Assert.AreEqual(4 * ScoreBoard.PointsPerCoin, board.Score);
+        }
     }
 }
