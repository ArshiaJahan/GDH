+def _plan_file(inp: dict) -> bool:
+    """A Write/Edit target that is a markdown file directly inside plans_dir()."""
+    fp = inp.get("file_path") if isinstance(inp, dict) else None
+    if not isinstance(fp, str) or not fp or "\x00" in fp:
+        return False
+    try:
+        p = Path(os.path.expanduser(fp))
+        if not p.is_absolute():
+            return False
+        root = plans_dir().resolve()
+        target = p.parent.resolve() / p.name
+        if target.is_symlink():
+            return False
+        return target.parent == root and target.suffix == ".md"
+    except (OSError, ValueError, RuntimeError):
+        return False
