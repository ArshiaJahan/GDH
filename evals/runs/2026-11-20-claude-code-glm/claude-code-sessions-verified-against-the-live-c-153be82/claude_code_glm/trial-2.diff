+def _is_builtin_plugin(p: Any) -> bool:
+    """A plugin that ships inside the CLI itself (no settings file loads it): `name@builtin`, a
+    builtin source/marketplace, or a path inside the CLI's own install."""
+    if isinstance(p, str):
+        return p.endswith("@builtin")
+    if not isinstance(p, dict):
+        return False
+    if p.get("builtin") is True or p.get("isBuiltin") is True:
+        return True
+    if any(str(p.get(k) or "").lower() in ("builtin", "built-in")
+           for k in ("source", "type", "marketplace", "scope")):
+        return True
+    if str(p.get("name") or "").endswith("@builtin"):
+        return True
+    return False
+
+
+def user_plugins(plugins: Any) -> list:
+    """The plugins an init event reports that came from the user's settings (the CLI's built-in
+    plugins are always there and load nothing of the user's)."""
+    if not isinstance(plugins, list):
+        return [plugins] if plugins else []
+    return [p for p in plugins if p and not _is_builtin_plugin(p)]
+
+
+def plans_dir() -> Path:
+    """Where Plan mode writes its plan file (~/.claude/plans); the only path GDW lets it write outside
+    the session's folders, and only in Plan mode."""
+    return Path.home() / ".claude" / "plans"
+
+
+def _is_plan_file(inp: dict) -> bool:
+    fp = inp.get("file_path") if isinstance(inp, dict) else None
+    if not isinstance(fp, str) or not fp or "\x00" in fp:
+        return False
+    try:
+        path = Path(os.path.expanduser(fp))
+        if not path.is_absolute():
+            return False
+        root = plans_dir().resolve()
+        target = path.resolve()
+    except (OSError, RuntimeError, ValueError):
+        return False
+    return target.parent == root and target.suffix == ".md" and not path.is_symlink()
+
