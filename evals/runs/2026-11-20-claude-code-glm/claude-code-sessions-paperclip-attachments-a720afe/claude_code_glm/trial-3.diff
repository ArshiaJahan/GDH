+def _user_content(msgs: list[Message], recap: str | None) -> list[dict]:
+    """The stream-json user message content for these GDW user messages: Anthropic content blocks, each
+    attachment (image, PDF, text file) inline after an `[Attached <kind>: name]` label, so Claude Code
+    reads it without a path outside its folder; text runs joined. A recap of earlier turns leads."""
+    out: list[dict] = []
+
+    def text(t: str) -> None:
+        if not t:
+            return
+        if out and out[-1].get("type") == "text":
+            out[-1]["text"] += f"\n\n{t}"
+        else:
+            out.append({"type": "text", "text": t})
+
+    for m in msgs:
+        for b in m.content:
+            if isinstance(b, TextBlock):
+                text(b.text)
+                continue
+            if b.type not in ("image", "file", "audio"):
+                continue
+            text(f"[Attached {b.type}: {b.name or (Path(b.path).name if b.path else b.type)}]")
+            if (w := block_to_wire(b, "user")) is None:
+                continue
+            if w.get("type") == "text":
+                text(w["text"])
+            else:
+                out.append(w)
+    if recap:
+        head = f"Earlier in this conversation:\n{recap}\n\nNow:"
+        if out and out[0].get("type") == "text":
+            out[0]["text"] = f"{head} {out[0]['text']}"
+        else:
+            out.insert(0, {"type": "text", "text": head})
+    cap_media([{"role": "user", "content": out}], MAX_TURN_MEDIA)
+    return out
+
