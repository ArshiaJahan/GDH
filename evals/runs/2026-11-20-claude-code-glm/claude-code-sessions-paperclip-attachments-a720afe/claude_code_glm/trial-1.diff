+def _user_content(msgs: list[Message], recap: str | None) -> list[dict]:
+    """The stream-json `content` of one turn: the messages' text, and each attached image, PDF or text
+    file inline as an Anthropic content block after an "[Attached <kind>: name]" label (so the CLI
+    needn't read a path outside its folder), after the recap when there is one. Over MAX_TURN_MEDIA
+    the oldest attachments become a note."""
+    out: list[dict] = []
+
+    def text(t: str) -> None:
+        if not t:
+            return
+        if out and out[-1]["type"] == "text":
+            out[-1]["text"] += "\n\n" + t
+        else:
+            out.append({"type": "text", "text": t})
+
+    for m in msgs:
+        for b in m.content:
+            if isinstance(b, TextBlock):
+                text(b.text)
+            elif isinstance(b, (ImageBlock, FileBlock, AudioBlock)):
+                kind = "PDF" if b.media_type == "application/pdf" else b.type
+                text(f"[Attached {kind}: {b.name or Path(b.path or '').name or b.type}]")
+                if (w := block_to_wire(b, "user")) is not None:
+                    if w["type"] == "text":
+                        text(w["text"])
+                    else:
+                        out.append(w)
+    if recap:
+        head = f"Earlier in this conversation:\n{recap}\n\nNow:"
+        if out and out[0]["type"] == "text":
+            out[0]["text"] = f"{head} {out[0]['text']}"
+        else:
+            out.insert(0, {"type": "text", "text": head})
+    if not out:
+        out.append({"type": "text", "text": "(no text)"})
+    cap_media([{"role": "user", "content": out}], MAX_TURN_MEDIA)
+    return out
+
+
