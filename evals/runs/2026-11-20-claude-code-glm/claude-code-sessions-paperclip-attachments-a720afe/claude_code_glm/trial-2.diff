 @pytest.mark.parametrize("sid", ["a", "A0_-", "a" * 64])
 def test_work_dir_accepts_valid_session_ids(sid):
     assert ccm.work_dir(sid) == data_dir() / "claude_code" / sid / "work"
+
+
+def test_user_content_sends_attachments_inline(tmp_path, monkeypatch):
+    """Images, PDFs and text files go inline after an [Attached …] label; over MAX_TURN_MEDIA the oldest become a note."""
+    import base64
+
+    from gamedevworkstation.core.types import FileBlock, ImageBlock, TextBlock
+    from gamedevworkstation.features import claude_code as ccm
+
+    png = base64.b64encode(b"\x89PNG\r\n\x1a\n" + b"\0" * 64).decode()
+    (tmp_path / "notes.txt").write_text("file content")
+    msg = Message(role="user", content=[
+        TextBlock(text="Look at these"),
+        ImageBlock(media_type="image/png", data=png, name="shot.png"),
+        FileBlock(media_type="application/pdf", data="JVBERi0=", name="spec.pdf"),
+        FileBlock(media_type="text/plain", path=str(tmp_path / "notes.txt"), name="notes.txt"),
+    ])
+    out = ccm._user_content([msg], "user: hi")
+    assert out[0] == {"type": "text", "text": "Earlier in this conversation:\nuser: hi\n\nNow: Look at these"}
+    assert [b.get("text") for b in out[1::2]] == ["[Attached image: shot.png]", "[Attached file: spec.pdf]", "[Attached file: notes.txt]"]
+    assert out[2]["type"] == "image" and out[2]["source"]["type"] == "base64"
+    assert out[4] == {"type": "document", "title": "spec.pdf", "source": {"type": "base64", "media_type": "application/pdf", "data": "JVBERi0="}}
+    assert out[6]["source"] == {"type": "text", "media_type": "text/plain", "data": "file content"}
+
+    monkeypatch.setattr(ccm, "MAX_TURN_MEDIA", len("JVBERi0="))
+    capped = ccm._user_content([msg], None)
+    assert capped[2]["type"] == "text" and "left out" in capped[2]["text"]  # the oldest (the image) is dropped
+    assert capped[4]["type"] == "document"
