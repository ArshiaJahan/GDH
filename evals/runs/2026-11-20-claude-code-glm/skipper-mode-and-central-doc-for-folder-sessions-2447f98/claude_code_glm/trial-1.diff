+    async def _quiet_turn(self, proc: Proc, turn: Turn, prompt: str) -> str:
+        """Ask the live conversation something on the app's behalf; the reply text (not shown)."""
+        q = Turn(sid=turn.sid, model=turn.model, effort=turn.effort, jid=turn.jid, gate=turn.gate, quiet=True)
