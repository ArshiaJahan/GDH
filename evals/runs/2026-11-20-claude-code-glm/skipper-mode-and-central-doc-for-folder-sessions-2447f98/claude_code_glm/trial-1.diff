+    async def _after_turn(self, sid: str, proc: Proc, turn: Turn) -> None:
+        """Modes of a folder session: Central doc (Claude Code updates one summary doc after each turn)
+        and Skipper (a handoff is saved and the next turn starts a fresh Claude Code conversation from it;
+        with Central doc on, the doc is the handoff). Both live in <folder>/.gdw/sessions/<id>/."""
+        s = self.app.store.get(sid) or {}
+        settings = s.get("settings") or {}
