diff --git a/scripts/setup_signing.sh b/scripts/setup_signing.sh
new file mode 100755
index 0000000..6075be0
--- /dev/null
+++ b/scripts/setup_signing.sh
@@ -0,0 +1,44 @@
+#!/usr/bin/env bash
+# Makes a stable code-signing identity for local builds ("GameDevWorkstation Local", self-signed, in
+# the login keychain). Ad-hoc signatures change on every build, so macOS treats each build as a new
+# app and asks again for folder and keychain access; one fixed identity keeps those grants.
+# Run once; scripts/build_mac.sh then finds it. Safe to run again (it does nothing if it exists).
+set -euo pipefail
+NAME="${GDW_SIGN_IDENTITY:-GameDevWorkstation Local}"
+KEYCHAIN="${GDW_KEYCHAIN:-$HOME/Library/Keychains/login.keychain-db}"
+
+[[ "$(uname -s)" == "Darwin" ]] || { echo "Code signing identities are a macOS thing; run this on your Mac."; exit 1; }
+if security find-identity -v -p codesigning "$KEYCHAIN" | grep -q "\"$NAME\""; then
+  echo "Signing identity \"$NAME\" is already in $KEYCHAIN."
+  exit 0
+fi
+command -v openssl >/dev/null 2>&1 || { echo "openssl is missing (it comes with macOS)."; exit 1; }
+
+TMP="$(mktemp -d)"
+trap 'rm -rf "$TMP"' EXIT
+cat >"$TMP/cert.cnf" <<EOF
+[req]
+distinguished_name = dn
+x509_extensions = ext
+prompt = no
+[dn]
+CN = $NAME
+[ext]
+basicConstraints = critical,CA:false
+keyUsage = critical,digitalSignature
+extendedKeyUsage = critical,codeSigning
+EOF
+echo "==> Making \"$NAME\" (self-signed, 10 years)"
+openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -config "$TMP/cert.cnf" \
+  -keyout "$TMP/key.pem" -out "$TMP/cert.pem" >/dev/null 2>&1
+PASS="$(openssl rand -hex 16)"
+# -legacy: macOS's security tool can't read OpenSSL 3's default PKCS#12 encryption.
+openssl pkcs12 -export -legacy -inkey "$TMP/key.pem" -in "$TMP/cert.pem" -name "$NAME" \
+  -out "$TMP/id.p12" -passout "pass:$PASS" 2>/dev/null \
+  || openssl pkcs12 -export -inkey "$TMP/key.pem" -in "$TMP/cert.pem" -name "$NAME" -out "$TMP/id.p12" -passout "pass:$PASS"
+security import "$TMP/id.p12" -k "$KEYCHAIN" -P "$PASS" -T /usr/bin/codesign >/dev/null
+echo "==> Trusting it for code signing (macOS may ask for your password)"
+security add-trusted-cert -r trustRoot -p codeSign -k "$KEYCHAIN" "$TMP/cert.pem"
+security find-identity -v -p codesigning "$KEYCHAIN" | grep -q "\"$NAME\"" \
+  && echo "Done: scripts/build_mac.sh will sign with \"$NAME\"." \
+  || { echo "The identity was imported but isn't valid for code signing; check Keychain Access."; exit 1; }
