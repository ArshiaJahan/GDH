+    async def _after_turn(self, s: dict, proc: Proc, model: str, effort: str | None, jid: str | None) -> str | None:
+        """Central doc / Skipper after a finished turn. Returns the handoff to continue from (Skipper),
+        or None when there's nothing to continue."""
+        app, sid = self.app, s["id"]
+        s = app.store.get(sid) or s
+        skipper, central = session_modes(s)
+        d = session_doc_dir(s)
+        if not (skipper or central) or d is None:
+            return None
+        doc_path = d / DOC_NAME
+        text = await self._quiet_turn(proc, s, model, effort, jid, doc_prompt(skipper, central, read_doc(doc_path)))
+        if not text:
+            self.notice(sid, "skipper" if skipper else "central_doc",
+                        "Claude Code didn't write the " + ("handoff" if skipper and not central else "central doc") + " this turn.")
+            return None
+        try:
+            d.mkdir(parents=True, exist_ok=True)
+            if central:
+                doc_path.write_text(text + "\n", encoding="utf-8")
+            if skipper:
+                n = int((s.get("settings") or {}).get("skipper_hops") or 0) + 1
+                hp = doc_path if central else d / f"handoff-{n:03d}.md"
+                if not central:
+                    hp.write_text(text + "\n", encoding="utf-8")
+                app.store.update(sid, settings={"skipper_hops": n, "skipper_handoff": str(hp)})
+        except OSError as e:
+            self._error(sid, f"Couldn't save to {d}: {e}")
+            return None
+        app.bus.publish("session.doc", {"path": str(doc_path if central else d), "skipper": skipper, "central_doc": central}, sid)
+        if not skipper:
+            return None
+        if SKIPPER_DONE.search(text):
+            self.notice(sid, "skipper", "Skipper: the handoff says the work is done.")
+            return None
+        return text
+
+    async def _quiet_turn(self, proc: Proc, s: dict, model: str, effort: str | None, jid: str | None, prompt: str) -> str:
+        """Ask the live conversation something without showing it in the transcript; its reply text."""
+        app, sid = self.app, s["id"]
+        if not proc.alive():
+            return ""
+        turn = Turn(sid=sid, model=model, effort=effort, jid=jid, quiet=True,
+                    gate=make_gate(app, lambda: app.store.get(sid) or s, session_cwd(s), []))
+        proc.turn = turn
+        proc.last_used = time.monotonic()
+        try:
+            await proc.send({"type": "user", "message": {"role": "user", "content": prompt},
+                             "parent_tool_use_id": None, "session_id": "default"})
+        except (BrokenPipeError, ConnectionResetError, RuntimeError):
+            pass
+        try:
+            res = await asyncio.shield(turn.done)
+        except asyncio.CancelledError:
+            self._stopping[sid] = asyncio.create_task(proc.interrupt(float(self.cfg.get("interrupt_wait_s", 5))))
+            raise
+        return "" if res.get("exited") else "\n\n".join(turn.reply).strip()
+
     async def _ensure(self, s: dict, model: str, effort: str | None, resume: str | None) -> Proc:
         sid = s["id"]
         lock = self._spawn_lock.setdefault(sid, asyncio.Lock())
