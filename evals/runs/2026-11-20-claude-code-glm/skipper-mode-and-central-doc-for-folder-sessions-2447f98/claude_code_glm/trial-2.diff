diff --git a/scripts/signing_identity.sh b/scripts/signing_identity.sh
new file mode 100755
index 0000000..eb66728
--- /dev/null
+++ b/scripts/signing_identity.sh
@@ -0,0 +1,55 @@
+#!/usr/bin/env bash
+# A stable code-signing identity for local builds. An ad-hoc signature changes with every build, so
+# macOS forgets the app's permissions (Files and Folders, Accessibility, keychain access) each time;
+# a build signed with the same certificate keeps them.
+#
+#   scripts/signing_identity.sh           print the identity build_mac.sh will use (exit 1 if none)
+#   scripts/signing_identity.sh --create  make a self-signed "GameDevWorkstation Local" code-signing
+#                                         certificate in the login keychain (once per Mac)
+#
+# GDW_SIGN_IDENTITY overrides the lookup (a Developer ID, or another certificate's name or SHA-1).
+set -euo pipefail
+NAME="${GDW_LOCAL_CERT_NAME:-GameDevWorkstation Local}"
+KEYCHAIN="$HOME/Library/Keychains/login.keychain-db"
+
+find_identity() {
+  if [[ -n "${GDW_SIGN_IDENTITY:-}" ]]; then echo "$GDW_SIGN_IDENTITY"; return 0; fi
+  # A Developer ID first, then the local certificate. Self-signed certificates aren't "valid" for
+  # policy checks (-v), but codesign signs with them.
+  local line
+  line="$(security find-identity -v -p codesigning 2>/dev/null | grep -m1 'Developer ID Application' || true)"
+  [[ -z "$line" ]] && line="$(security find-identity -p codesigning 2>/dev/null | grep -m1 "\"$NAME\"" || true)"
+  [[ -n "$line" ]] || return 1
+  awk '{print $2}' <<<"$line"
+}
+
+create() {
+  if find_identity >/dev/null; then echo "Already set up: $(find_identity)"; return 0; fi
+  local tmp; tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' RETURN
+  cat >"$tmp/cert.cnf" <<EOF
+[req]
+distinguished_name = dn
+x509_extensions = ext
+prompt = no
+[dn]
+CN = $NAME
+[ext]
+basicConstraints = critical,CA:false
+keyUsage = critical,digitalSignature
+extendedKeyUsage = critical,codeSigning
+EOF
+  openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -config "$tmp/cert.cnf" \
+    -keyout "$tmp/key.pem" -out "$tmp/cert.pem" >/dev/null 2>&1
+  local pass; pass="$(openssl rand -hex 16)"
+  openssl pkcs12 -export -legacy -inkey "$tmp/key.pem" -in "$tmp/cert.pem" -name "$NAME" \
+    -passout "pass:$pass" -out "$tmp/id.p12" 2>/dev/null \
+    || openssl pkcs12 -export -inkey "$tmp/key.pem" -in "$tmp/cert.pem" -name "$NAME" -passout "pass:$pass" -out "$tmp/id.p12"
+  security import "$tmp/id.p12" -k "$KEYCHAIN" -P "$pass" -T /usr/bin/codesign >/dev/null
+  echo "Created \"$NAME\" in the login keychain: $(find_identity)"
+}
+
+case "${1:-}" in
+  --create) create ;;
+  "") find_identity || { echo "No code-signing identity. Run: scripts/signing_identity.sh --create" >&2; exit 1; } ;;
+  *) echo "usage: $0 [--create]" >&2; exit 2 ;;
+esac
