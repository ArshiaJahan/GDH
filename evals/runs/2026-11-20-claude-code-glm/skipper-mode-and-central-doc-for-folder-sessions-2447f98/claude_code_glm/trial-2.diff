+# Modes of a Claude Code folder session (new-session screen, settings.skipper / settings.central_doc).
+# After each turn the app asks Claude Code (a quiet turn: its reply isn't shown) for the Central doc or
+# a Skipper handoff and saves it under <folder>/.gdw/sessions/<id>/. Skipper then continues the work in
+# a fresh Claude Code conversation that starts from the handoff; with Central doc on, the doc is the handoff.
+DOC_NAME = "central.md"
+DOC_KEEP = 40_000
+SKIPPER_DONE = re.compile(r"^\s*STATUS:\s*done\b", re.I)
+DOC_PROMPT = ("[GDW Central doc] Update this session's central doc: one Markdown summary of the session (goal, "
+              "decisions, current state, files that matter, next steps, open questions). Keep what is still true, "
+              "change what isn't. Don't use tools. Reply with only the full updated doc.")
+HANDOFF_PROMPT = ("[GDW Skipper] Write a handoff for a fresh Claude Code conversation that will continue this work "
+                  "without this conversation's history: goal, what's done, current state, files that matter, the "
+                  "exact next steps, open questions. If the work is finished and nothing is left to do, make the "
+                  "first line `STATUS: done`. Don't use tools. Reply with only the handoff in Markdown.")
+SKIPPER_START = ("[GDW Skipper] You're continuing work from an earlier Claude Code conversation. Its handoff:\n\n"
+                 "{handoff}\n\nContinue the work from the next steps.")
+
+
+def session_doc_dir(s: dict) -> Path | None:
+    """<folder>/.gdw/sessions/<id>/: where a folder session's Central doc and handoffs are saved."""
+    return Path(s["folder"]) / ".gdw" / "sessions" / s["id"] if s.get("folder") else None
+
+
+def session_modes(s: dict) -> tuple[bool, bool]:
+    """(skipper, central_doc): on for Claude Code folder sessions only."""
+    st = s.get("settings") or {}
+    ok = bool(s.get("folder")) and s.get("harness", HARNESS) == HARNESS
+    return ok and bool(st.get("skipper")), ok and bool(st.get("central_doc"))
+
+
+def read_doc(path: Path | str | None, limit: int = DOC_KEEP) -> str:
+    """The end of a saved doc ("" when there's none)."""
+    try:
+        return Path(str(path)).read_text(encoding="utf-8", errors="replace")[-limit:] if path else ""
+    except OSError:
+        return ""
+
+
+def doc_prompt(skipper: bool, central: bool, doc: str) -> str:
+    parts = [DOC_PROMPT] if central else []
+    if skipper:
+        parts.append(HANDOFF_PROMPT if not central else
+                     "[GDW Skipper] This doc is also the handoff: a fresh Claude Code conversation continues the work "
+                     "from it alone, so make the next steps exact. If the work is finished, make the first line `STATUS: done`.")
+    if central:
+        parts.append(f"The doc so far:\n<doc>\n{doc}\n</doc>" if doc.strip() else "There is no doc yet: write it.")
+    return "\n\n".join(parts)
