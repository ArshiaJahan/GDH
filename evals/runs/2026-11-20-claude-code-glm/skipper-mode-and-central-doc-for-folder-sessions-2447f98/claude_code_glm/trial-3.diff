+    async def _quiet_turn(self, sid: str, proc: Proc, prompt: str, model: str, effort: str | None, jid: str | None) -> str:
+        """Ask the session's Claude Code conversation for text that isn't shown in the transcript ("" on failure)."""
+        if not proc.alive or proc.turn is not None:
+            return ""
+        s = self.app.store.get(sid) or {}
+        turn = Turn(sid=sid, model=model, effort=effort, jid=jid, quiet=True,
+                    gate=make_gate(self.app, lambda: self.app.store.get(sid) or s, session_cwd(s), []))
+        proc.turn = turn
+        try:
+            await proc.send({"type": "user", "message": {"role": "user", "content": prompt},
+                             "parent_tool_use_id": None, "session_id": "default"})
+            res = await asyncio.wait_for(asyncio.shield(turn.done), float(self.cfg.get("handoff_timeout_s", 300)))
+        except asyncio.CancelledError:  # Stop during the handoff: end it like a turn
+            self._stopping[sid] = asyncio.create_task(proc.interrupt(float(self.cfg.get("interrupt_wait_s", 5))))
+            raise
+        except (BrokenPipeError, ConnectionResetError, RuntimeError, asyncio.TimeoutError):
+            if proc.turn is turn:
+                proc.turn = None
+            return ""
+        return "" if res.get("exited") else "\n".join(turn.text).strip()
+
+    async def _after_turn(self, sid: str, proc: Proc, model: str, effort: str | None, jid: str | None) -> None:
+        """After a finished turn: update the central doc, and with Skipper hand off to a fresh conversation."""
+        s = self.app.store.get(sid) or {}
+        modes, d = session_modes(s), session_doc_dir(s)
+        if d is None or not (modes["skipper"] or modes["central_doc"]):
+            return
+        try:
+            if modes["central_doc"]:
+                path = d / CENTRAL_DOC
+                text = await self._quiet_turn(sid, proc, CENTRAL_PROMPT.format(doc=read_doc(path) or "(empty: this is the first turn)"),
+                                              model, effort, jid)
+                if text:
+                    write_doc(d, CENTRAL_DOC, text)
+                    self.app.bus.publish("session.doc", {"path": str(path)}, sid)
+                handoff = path if text or path.is_file() else None  # with Skipper on, the doc is the handoff
+            else:
+                text = await self._quiet_turn(sid, proc, HANDOFF_PROMPT, model, effort, jid)
+                handoff = None
+                if text:
+                    n = len(list(d.glob("handoff-*.md"))) + 1 if d.is_dir() else 1
+                    write_doc(d, f"handoff-{n:03d}.md", text)
+                    handoff = write_doc(d, HANDOFF, text)
+        except OSError as e:
+            self._error(sid, f"Couldn't save the session doc in {d}: {e}")
+            return
+        if not modes["skipper"]:
+            return
+        if handoff is None:
+            self.notice(sid, "skipper", "Skipper: no handoff this turn, so the same Claude Code conversation continues.")
+            return
+        await self.close_session(sid)
+        self.app.store.update(sid, settings={"claude_code_session": None, "claude_code_totals": None,
+                                             "skipper_handoff": str(handoff)})
+        if jid:
+            self.app.jobs.log(jid, f"Skipper: handoff saved to {handoff}; the next turn starts a fresh conversation\n")
+
