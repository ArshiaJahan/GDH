+def session_doc_dir(s: dict) -> Path | None:
+    """<folder>/.gdw/sessions/<id>/: a folder session's Skipper handoffs and central doc (None in chat only)."""
+    if not s.get("folder") or not re.fullmatch(r"[A-Za-z0-9_-]{1,64}", str(s.get("id") or "")):
+        return None
+    return Path(s["folder"]) / GDW_DIR / "sessions" / s["id"]
+
+
+def session_modes(s: dict) -> dict:
+    """{"skipper": bool, "central_doc": bool} from the session's settings (folder sessions only)."""
+    st = s.get("settings") or {}
+    on = bool(s.get("folder"))
+    return {"skipper": on and bool(st.get("skipper")), "central_doc": on and bool(st.get("central_doc"))}
+
+
+def central_doc_path(s: dict) -> Path | None:
+    d = session_doc_dir(s)
+    return d / CENTRAL_DOC if d and session_modes(s)["central_doc"] else None
+
+
+def read_doc(path: Path | str | None, limit: int = DOC_LIMIT) -> str:
+    """The last `limit` characters of a doc ("" when there's none)."""
+    try:
+        return Path(str(path)).read_text(encoding="utf-8", errors="replace")[-limit:] if path else ""
+    except OSError:
+        return ""
+
+
+def write_doc(d: Path, name: str, text: str) -> Path:
+    d.mkdir(parents=True, exist_ok=True)
+    gi = d.parents[1] / ".gitignore"  # <folder>/.gdw/.gitignore: keep GDW's files out of the project's git
+    if not gi.exists():
+        gi.write_text("*\n", encoding="utf-8")
+    p = d / name
+    tmp = p.with_suffix(".tmp")
+    tmp.write_text(text.strip() + "\n", encoding="utf-8")
+    os.replace(tmp, p)
+    return p
+
