diff --git a/tests/test_claude_cli_windows.py b/tests/test_claude_cli_windows.py
new file mode 100644
index 0000000..aeadbac
--- /dev/null
+++ b/tests/test_claude_cli_windows.py
@@ -0,0 +1,91 @@
+"""Claude Code login detection on Windows: the profile and system variables reach `claude`, and
+claude.exe / claude.cmd are found outside PATH. The last test runs a real probe (Windows CI only)."""
+import asyncio
+import os
+from types import SimpleNamespace
+
+import pytest
+
+from gamedevworkstation.features import claude_cli as cc
+
+WINDOWS_ENV = {"USERPROFILE": r"C:\Users\x", "APPDATA": r"C:\Users\x\AppData\Roaming",
+               "LOCALAPPDATA": r"C:\Users\x\AppData\Local", "SystemRoot": r"C:\Windows",
+               "ComSpec": r"C:\Windows\system32\cmd.exe", "Path": r"C:\Windows\system32",
+               "PATHEXT": ".COM;.EXE;.BAT;.CMD", "TEMP": r"C:\Temp", "windir": r"C:\Windows",
+               "HOMEDRIVE": "C:", "HOMEPATH": r"\Users\x"}
+
+
+def test_child_env_passes_windows_profile_names_case_insensitively(monkeypatch):
+    monkeypatch.setattr(cc, "_windows", lambda: True)
+    env = cc.child_env({**WINDOWS_ENV, "ANTHROPIC_API_KEY": "sk-x", "CLAUDECODE": "1", "SECRET_TOKEN": "t"})
+    assert env == {**WINDOWS_ENV, "MCP_TOOL_TIMEOUT": str(cc.MCP_TOOL_TIMEOUT_MS)}
+
+
+def test_child_env_keeps_windows_names_out_on_posix(monkeypatch):
+    monkeypatch.setattr(cc, "_windows", lambda: False)
+    assert set(cc.child_env({**WINDOWS_ENV, "PATH": "/bin"})) == {"PATH", "MCP_TOOL_TIMEOUT"}
+
+
+@pytest.mark.parametrize("where,name", [("appdata", "claude.cmd"), ("local", "claude.exe"),
+                                        ("home", "claude.cmd"), ("claude_local", "claude.exe")])
+def test_find_cli_searches_windows_install_dirs(tmp_path, monkeypatch, where, name):
+    monkeypatch.setattr(cc, "_windows", lambda: True)
+    monkeypatch.setattr(cc.shutil, "which", lambda *_a, **_k: None)
+    monkeypatch.delenv("GDW_CLAUDE_CLI_SEARCH", raising=False)
+    home = tmp_path / "home"
+    for var in ("HOME", "USERPROFILE"):
+        monkeypatch.setenv(var, str(home))
+    monkeypatch.setenv("APPDATA", str(tmp_path / "Roaming"))
+    monkeypatch.setenv("LOCALAPPDATA", str(tmp_path / "Local"))
+    d = {"appdata": tmp_path / "Roaming" / "npm", "local": tmp_path / "Local" / "Programs" / "claude",
+         "home": home / ".local" / "bin", "claude_local": home / ".claude" / "local"}[where]
+    d.mkdir(parents=True)
+    (d / name).write_text("@echo off\n")
+    assert cc.find_cli(SimpleNamespace(claude_code={})) == str(d / name)
+
+
+def test_find_cli_skips_unset_windows_dirs(tmp_path, monkeypatch):
+    monkeypatch.setattr(cc, "_windows", lambda: True)
+    monkeypatch.setattr(cc.shutil, "which", lambda *_a, **_k: None)
+    monkeypatch.delenv("GDW_CLAUDE_CLI_SEARCH", raising=False)
+    for var in ("HOME", "USERPROFILE"):
+        monkeypatch.setenv(var, str(tmp_path))
+    monkeypatch.delenv("APPDATA", raising=False)
+    monkeypatch.delenv("LOCALAPPDATA", raising=False)
+    monkeypatch.chdir(tmp_path)
+    (tmp_path / "%APPDATA%" / "npm").mkdir(parents=True)
+    (tmp_path / "%APPDATA%" / "npm" / "claude.cmd").write_text("")
+    assert cc.find_cli(SimpleNamespace(claude_code={})) is None
+
+
+# A stand-in for `claude` that reports logged in only when it can see the user's profile, the way
+# the real CLI finds the credentials `claude auth login` saved under %USERPROFILE%\.claude.
+FAKE_CMD = r"""@echo off
+if "%1"=="--version" (
+  echo 9.9.9 ^(Claude Code^)
+  exit /b 0
+)
+if not defined USERPROFILE goto out
+if not defined APPDATA goto out
+if not defined SystemRoot goto out
+echo {"loggedIn": true, "authMethod": "claude.ai", "email": "someone@example.com"}
+exit /b 0
+:out
+echo {"loggedIn": false, "authMethod": "none"}
+exit /b 0
+"""
+
+
+@pytest.mark.skipif(os.name != "nt", reason="runs a real claude.cmd")
+def test_real_probe_through_fake_claude_cmd(tmp_path, monkeypatch):
+    monkeypatch.delenv("GDW_CLAUDE_CLI_SEARCH", raising=False)
+    monkeypatch.setattr(cc.shutil, "which", lambda *_a, **_k: None)
+    monkeypatch.setenv("APPDATA", str(tmp_path / "Roaming"))
+    npm = tmp_path / "Roaming" / "npm"
+    npm.mkdir(parents=True)
+    (npm / "claude.cmd").write_text(FAKE_CMD)
+    st = asyncio.run(cc.CliProbe(SimpleNamespace(claude_code={})).status(refresh=True))
+    assert st["path"] == str(npm / "claude.cmd"), st
+    assert st["version"] == "9.9.9 (Claude Code)", st
+    assert st["logged_in"] is True and st["auth_method"] == "claude.ai", st
+    assert "email" not in st["auth"]
