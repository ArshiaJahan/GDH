@@ -0,0 +1,89 @@
+"""claude_cli on Windows: the profile/system environment and the claude.exe / claude.cmd search.
+(This file also runs on the Windows CI job; the last test runs a real probe there.)"""
+import asyncio
+import os
+import sys
+from pathlib import Path
+
+import pytest
+
+from gamedevworkstation.features import claude_cli
+from gamedevworkstation.features.claude_cli import CliProbe, child_env, find_cli
+
+WIN_ENV = {"USERPROFILE": r"C:\Users\x", "APPDATA": r"C:\Users\x\AppData\Roaming",
+           "LOCALAPPDATA": r"C:\Users\x\AppData\Local", "SystemRoot": r"C:\Windows", "windir": r"C:\Windows",
+           "ComSpec": r"C:\Windows\system32\cmd.exe", "Path": r"C:\Windows", "PATHEXT": ".COM;.EXE;.CMD",
+           "TEMP": r"C:\t", "HOMEDRIVE": "C:", "HOMEPATH": r"\Users\x", "ProgramFiles": r"C:\Program Files"}
+LEAKY = {"ANTHROPIC_API_KEY": "sk-ant-x", "CLAUDE_CODE_USE_BEDROCK": "1", "AWS_SECRET_ACCESS_KEY": "s",
+         "GITHUB_TOKEN": "t"}
+
+
+class _Cfg:
+    def __init__(self, cli_path=""):
+        self.claude_code = {"cli_path": cli_path}
+
+
+def test_child_env_keeps_windows_names_case_insensitively(monkeypatch):
+    monkeypatch.setattr(claude_cli, "_windows", lambda: True)
+    env = child_env({**WIN_ENV, **LEAKY, "systemdrive": "C:"})
+    assert env == {**WIN_ENV, "systemdrive": "C:", "MCP_TOOL_TIMEOUT": str(claude_cli.MCP_TOOL_TIMEOUT_MS)}
+
+
+def test_child_env_drops_windows_names_elsewhere(monkeypatch):
+    monkeypatch.setattr(claude_cli, "_windows", lambda: False)
+    assert set(child_env({**WIN_ENV, **LEAKY, "HOME": "/h"})) == {"HOME", "MCP_TOOL_TIMEOUT"}
+
+
+@pytest.mark.parametrize("where,name", [("~/.local/bin", "claude.exe"), ("~/.claude/local", "claude.cmd"),
+                                        ("%APPDATA%/npm", "claude.cmd"),
+                                        ("%LOCALAPPDATA%/Programs/claude", "claude.exe")])
+def test_find_cli_searches_the_windows_install_dirs(tmp_path, monkeypatch, where, name):
+    monkeypatch.setattr(claude_cli, "_windows", lambda: True)
+    monkeypatch.delenv("GDW_CLAUDE_CLI_SEARCH")
+    monkeypatch.setattr(claude_cli.shutil, "which", lambda *a, **k: None)
+    home, appdata, local = tmp_path / "home", tmp_path / "roaming", tmp_path / "local"
+    for k, v in (("HOME", home), ("USERPROFILE", home), ("APPDATA", appdata), ("LOCALAPPDATA", local)):
+        monkeypatch.setenv(k, str(v))
+    d = Path(claude_cli._WIN_VAR.sub(lambda m: os.environ[m.group(1)], where)).expanduser()
+    d.mkdir(parents=True)
+    (d / name).write_text("")  # no execute bit: Windows has none
+    assert find_cli(_Cfg()) == str(d / name)
+
+
+def test_find_cli_skips_unset_windows_dirs(tmp_path, monkeypatch):
+    monkeypatch.setattr(claude_cli, "_windows", lambda: True)
+    monkeypatch.delenv("GDW_CLAUDE_CLI_SEARCH")
+    monkeypatch.setattr(claude_cli.shutil, "which", lambda *a, **k: None)
+    monkeypatch.setenv("HOME", str(tmp_path))
+    monkeypatch.setenv("USERPROFILE", str(tmp_path))
+    monkeypatch.delenv("APPDATA", raising=False)
+    monkeypatch.delenv("LOCALAPPDATA", raising=False)
+    assert find_cli(_Cfg()) is None
+
+
+FAKE = r'''import json, os, sys
+if sys.argv[1:] == ["--version"]:
+    print("9.9.9 (Claude Code)")
+elif sys.argv[1:] == ["auth", "status"]:
+    have = all(os.environ.get(k) for k in ("USERPROFILE", "APPDATA", "SystemRoot", "ComSpec"))
+    login = os.path.join(os.environ.get("USERPROFILE", ""), ".claude", "login")
+    ok = have and os.path.isfile(login) and "SECRET_FOR_TEST" not in os.environ
+    print(json.dumps({"loggedIn": ok, "authMethod": "claude.ai" if ok else "none"}))
+'''
+
+
+@pytest.mark.skipif(sys.platform != "win32", reason="runs claude.cmd through cmd.exe")
+def test_windows_probe_through_a_fake_claude_cmd(tmp_path, monkeypatch):
+    profile = tmp_path / "profile"
+    (profile / ".claude").mkdir(parents=True)
+    (profile / ".claude" / "login").write_text("")
+    monkeypatch.setenv("USERPROFILE", str(profile))
+    monkeypatch.setenv("SECRET_FOR_TEST", "x")
+    script = tmp_path / "fake_claude.py"
+    script.write_text(FAKE)
+    exe = tmp_path / "claude.cmd"
+    exe.write_text(f'@"{sys.executable}" "{script}" %*\r\n')
+    st = asyncio.run(CliProbe(_Cfg(str(exe))).status())
+    assert st["error"] is None, st
+    assert st["installed"] and st["version"] == "9.9.9 (Claude Code)"
+    assert st["logged_in"] is True and st["auth_method"] == "claude.ai"
