diff --git a/tests/test_claude_cli_windows.py b/tests/test_claude_cli_windows.py
new file mode 100644
index 0000000..f6aed03
--- /dev/null
+++ b/tests/test_claude_cli_windows.py
@@ -0,0 +1,84 @@
+"""The `claude` CLI on Windows: the profile and system variables reach the child, and claude.exe /
+claude.cmd are found outside PATH. The last test runs a real probe and only runs on Windows (CI)."""
+from __future__ import annotations
+
+import os
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from gamedevworkstation.features import claude_cli as cli
+
+WINDOWS_VARS = {"USERPROFILE": r"C:\Users\me", "APPDATA": r"C:\Users\me\AppData\Roaming",
+                "LOCALAPPDATA": r"C:\Users\me\AppData\Local", "SystemRoot": r"C:\Windows",
+                "ComSpec": r"C:\Windows\system32\cmd.exe", "PATHEXT": ".COM;.EXE;.BAT;.CMD",
+                "windir": r"C:\Windows", "TEMP": r"C:\Temp", "Path": r"C:\Windows\system32"}
+LEAKY = {"ANTHROPIC_API_KEY": "sk-ant-must-not-leak", "CLAUDE_CODE_OAUTH_TOKEN": "oauth-must-not-leak",
+         "GDW_TOKEN": "private", "anthropic_api_key": "sk-ant-lowercase"}
+
+
+def test_windows_env_keeps_profile_and_system_names_case_insensitively(monkeypatch):
+    monkeypatch.setattr(cli, "_windows", lambda: True)
+    env = cli.child_env({**WINDOWS_VARS, **LEAKY, "HTTPS_PROXY": "http://p", "systemdrive": "C:"})
+    assert env == {**WINDOWS_VARS, "HTTPS_PROXY": "http://p", "systemdrive": "C:",
+                   "MCP_TOOL_TIMEOUT": str(cli.MCP_TOOL_TIMEOUT_MS)}
+
+
+def test_windows_names_stay_out_elsewhere(monkeypatch):
+    monkeypatch.setattr(cli, "_windows", lambda: False)
+    env = cli.child_env({**WINDOWS_VARS, "PATH": "/usr/bin"})
+    assert env == {"PATH": "/usr/bin", "MCP_TOOL_TIMEOUT": str(cli.MCP_TOOL_TIMEOUT_MS)}
+
+
+@pytest.mark.parametrize("where, name", [("APPDATA/npm", "claude.cmd"),
+                                         ("LOCALAPPDATA/Programs/claude", "claude.exe"),
+                                         ("home/.local/bin", "claude.exe"),
+                                         ("home/.claude/local", "claude.cmd")])
+def test_windows_search_finds_claude_outside_path(monkeypatch, tmp_path, where, name):
+    monkeypatch.setattr(cli, "_windows", lambda: True)
+    monkeypatch.setattr(cli.shutil, "which", lambda *_a, **_k: None)
+    monkeypatch.delenv("GDW_CLAUDE_CLI_SEARCH", raising=False)
+    for var in ("APPDATA", "LOCALAPPDATA"):
+        monkeypatch.setenv(var, str(tmp_path / var))
+    monkeypatch.setenv("HOME", str(tmp_path / "home"))
+    monkeypatch.setenv("USERPROFILE", str(tmp_path / "home"))
+    exe = tmp_path / where / name
+    exe.parent.mkdir(parents=True)
+    exe.write_text("@echo off\n")
+    exe.chmod(0o755)
+    assert cli.find_cli(SimpleNamespace(claude_code={})) == str(exe)
+
+
+def test_windows_search_skips_unset_variables(monkeypatch, tmp_path):
+    monkeypatch.setattr(cli, "_windows", lambda: True)
+    monkeypatch.delenv("APPDATA", raising=False)
+    monkeypatch.setenv("LOCALAPPDATA", str(tmp_path))
+    paths = cli._search_paths()
+    assert not any("npm" in p.parts for p in paths)
+    assert tmp_path / "Programs" / "claude" / "claude.exe" in paths
+
+
+FAKE_CMD = """@echo off
+if "%~1"=="--version" goto version
+if not defined USERPROFILE goto out
+if not defined APPDATA goto out
+if not defined SystemRoot goto out
+echo {"loggedIn": true, "authMethod": "claude.ai"}
+exit /b 0
+:out
+echo {"loggedIn": false, "authMethod": "none"}
+exit /b 0
+:version
+echo 2.1.308 Claude Code
+"""
+
+
+@pytest.mark.skipif(os.name != "nt", reason="runs a real claude.cmd")
+async def test_windows_probe_through_a_fake_claude_cmd(tmp_path: Path):
+    exe = tmp_path / "claude.cmd"
+    exe.write_text(FAKE_CMD)
+    status = await cli.CliProbe(SimpleNamespace(claude_code={"cli_path": str(exe)}))._probe()
+    assert status["error"] is None, status
+    assert status["version"] == "2.1.308 Claude Code"
+    assert status["logged_in"] is True and status["auth_method"] == "claude.ai"
