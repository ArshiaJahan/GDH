@@ -0,0 +1,24 @@
+using System;
+
+namespace Gdw.Replay
+{
+    /// <summary>
+    /// Frame capture entry points for the PlayMode verification test. The capture backend
+    /// (ReplayCapture) lives in the Editor assembly, which the test assembly can't reference, so the
+    /// Editor assembly installs these hooks on load. All three stay null in a player build.
+    /// </summary>
+    public static class ReplayCaptureHooks
+    {
+        /// <summary>Start(outputDir, totalFrames, fps) -> "ok" or "error: ...".</summary>
+        public static Func<string, int, int, string> Start;
+
+        /// <summary>Capture the current frame -> "ok", "done" or "error: ...".</summary>
+        public static Func<string> CaptureFrame;
+
+        /// <summary>Stop capture and release its resources. Safe to call when idle.</summary>
+        public static Action Stop;
+
+        /// <summary>True when a capture backend is installed.</summary>
+        public static bool Available => Start != null && CaptureFrame != null && Stop != null;
+    }
+}
