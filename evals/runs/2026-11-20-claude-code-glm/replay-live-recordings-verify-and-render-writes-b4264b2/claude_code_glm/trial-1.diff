+                path.unlink()
+        outcome = replay_media.execute_steps(plan, capture=spec)
+    except (replay_media.ReplayMediaError, OSError) as exc:
+        return {"ok": False, "exports": [], "error": str(exc)}
+
+    formats = set(capture.get("formats") or [])
+    exports = [_rel_posix(root, p) for p in plan.outputs if p.is_file() and p.suffix.lstrip(".").lower() in formats]
+    errors = [str(r.get("error")) for r in outcome.get("results") or [] if r.get("error")]
