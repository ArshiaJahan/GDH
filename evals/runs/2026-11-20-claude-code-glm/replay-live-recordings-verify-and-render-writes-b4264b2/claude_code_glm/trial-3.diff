+++ b/skills/replay/templates/com.gdw.replay/Runtime/ReplayCaptureHooks.cs
@@ -0,0 +1,24 @@
+using System;
+
+namespace Gdw.Replay
+{
+    /// <summary>
+    /// Frame capture entry points for code that can't reference the Editor assembly (the PlayMode
+    /// verification test). Gdw.Replay.Editor's ReplayCapture installs them on load; they stay null in
+    /// a player build, where there is nothing to capture with.
+    /// </summary>
+    public static class ReplayCaptureHooks
+    {
+        /// <summary>Start(outputDir, totalFrames, fps): "ok" or "error: ...".</summary>
+        public static Func<string, int, int, string> Start;
+
+        /// <summary>Capture the current frame: "ok", "done" or "error: ...".</summary>
+        public static Func<string> CaptureFrame;
+
+        /// <summary>Stop capture and release its resources.</summary>
+        public static Action Stop;
+
+        /// <summary>True when the Editor installed the capture hooks.</summary>
+        public static bool Available => Start != null && CaptureFrame != null && Stop != null;
+    }
+}
