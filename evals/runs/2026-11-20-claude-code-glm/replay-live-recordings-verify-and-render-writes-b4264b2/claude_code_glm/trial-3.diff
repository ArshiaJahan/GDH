+def _export_capture(root: Path, run_id: str, request: dict) -> dict | None:
+    """Encode the PNGs the PlayMode test captured to the requested MP4/GIF (replay_media / ffmpeg).
+
+    Returns None when the request asked for no capture or no frames were captured, else
+    {ok, outputs, frames, warnings, error}; outputs are project-relative paths of the requested
+    formats only.
+    """
+    from . import replay_media
+
+    capture = request.get("capture")
+    if not isinstance(capture, dict) or not capture.get("formats"):
+        return None
+    formats = list(capture["formats"])
+    out_dir = _replay_output_dir(root, run_id)
+    frames_dir = out_dir / "capture" / "frames"
+    frames = sorted(frames_dir.glob("frame-*.png")) if frames_dir.is_dir() else []
+    if not frames:
+        log.warning("replay: render %s captured no frames in %s; nothing to export",
+                    run_id, _rel_posix(root, frames_dir))
+        return None
+    export_dir = out_dir / "exports"
+    for name in ("run.mp4", "run.gif"):
+        stale = export_dir / name
+        if stale.is_file():  # ffmpeg runs with -n and won't overwrite an earlier render's output
+            stale.unlink()
+    spec = {**capture, "run_id": run_id, "total_frames": len(frames)}
+    try:
+        plan = replay_media.build_export_steps(frames_dir, export_dir, spec,
+                                               replay_root=root / "Logs" / "harness" / "replay")
+        done = replay_media.execute_steps(plan, capture=spec, replay_root=root / "Logs" / "harness" / "replay")
+    except (replay_media.ReplayMediaError, OSError) as exc:
+        return {"ok": False, "outputs": [], "warnings": [], "error": str(exc)}
+    error = next((str(r.get("error")) for r in done.get("results") or [] if r.get("error")), "")
+    outputs: list[str] = []
+    for path in plan.outputs:
+        fmt = path.suffix.lstrip(".").lower()
+        if fmt not in formats:
+            # The GIF is encoded from the MP4; drop that intermediate when only a GIF was asked for.
+            if done.get("ok") and path.is_file():
+                path.unlink()
+            continue
+        if path.is_file():
+            outputs.append(_rel_posix(root, path))
+    ok = bool(done.get("ok")) and len(outputs) == len(formats)
+    if not ok and not error:
+        error = "ffmpeg did not write " + ", ".join(sorted(set(formats) - {Path(o).suffix.lstrip(".") for o in outputs}))
+    return {"ok": ok, "outputs": outputs, "frames": len(frames),
+            "warnings": list(done.get("warnings") or []), "error": error[:_MAX_REPORT_MESSAGE]}
+
