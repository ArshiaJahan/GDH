+def _add_exports_to_report(root: Path, run_id: str, report: dict, export: dict) -> dict:
+    """List a render's MP4/GIF in its report (rewritten in place; it was written during this op)."""
+    artifacts = dict(report.get("artifacts") or {})
+    artifacts["exports"] = sorted(set(artifacts.get("exports") or []) | set(export.get("outputs") or []))
+    capture_dir = _replay_output_dir(root, run_id) / "capture"
+    if capture_dir.is_dir():
+        artifacts["capture_dir"] = _rel_posix(root, capture_dir)
+    report = {**report, "artifacts": artifacts}
+    if not export.get("ok"):
+        note = f"export failed: {export.get('error') or 'unknown error'}"
+        report["message"] = "; ".join(x for x in (report.get("message") or "", note) if x)[:_MAX_REPORT_MESSAGE]
+    path = _replay_output_dir(root, run_id) / "report.json"
+    _atomic_write(path, (json.dumps(report, indent=2, sort_keys=True, ensure_ascii=False) + "\n").encode())
+    return report
+
