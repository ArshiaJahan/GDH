+def _export_capture(root: Path, run_id: str, request: dict) -> dict | None:
+    """Encode a render's captured PNG frames to the requested MP4/GIF with ffmpeg.
+
+    Returns None when the request has no capture, else {ok, exports, message[, warnings]}; exports are
+    project-relative paths. The PNGs are deleted only after every export step succeeded.
