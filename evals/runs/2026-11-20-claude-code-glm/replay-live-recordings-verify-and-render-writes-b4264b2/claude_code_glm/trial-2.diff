+        result = replay_media.execute_steps(plan, replay_root=root / "Logs" / "harness" / "replay")
+    except replay_media.ReplayMediaError as exc:
+        return {"ok": False, "exports": [], "message": str(exc)}
+    wanted = {f".{fmt}" for fmt in capture["formats"]}
+    exports = [_rel_posix(root, p) for p in plan.outputs if p.suffix in wanted and p.is_file()]
+    errors = [str(r.get("error")) for r in result.get("results") or [] if r.get("error")]
+    errors += [str(v["error"]) for v in result.get("verifications") or [] if v.get("error")]
+    ok = bool(result.get("ok")) and not errors and len(exports) == len(wanted)
+    message = (f"exported {', '.join(exports)} from {len(frames)} frames" if ok
+               else "export failed: " + ("; ".join(e[-300:] for e in errors) or "missing output"))
+    out: dict[str, Any] = {"ok": ok, "exports": exports, "message": message}
+    if result.get("warnings"):
+        out["warnings"] = list(result["warnings"])
+    return out
