+HARNESSES = ("builtin", "agent_sdk", "codex_cli", "claude_code")
+SESSION_ID = re.compile(r"^[A-Za-z0-9_-]{1,64}$")
+# Sessions that ran before chat-only sessions got their own work folder keep the session data
+# folder as their cwd, so `claude --resume` (keyed by cwd) still finds the conversation.
+LEGACY_CWD_KEYS = ("claude_code_session", "agent_sdk_session", "codex_thread")
+
+
+def work_dir(sid: str) -> Path:
+    """A chat-only session's private working folder (inside its data folder, away from attachments)."""
+    if not isinstance(sid, str) or not SESSION_ID.match(sid):
+        raise ValueError(f"Bad session id {sid!r}")
+    d = sessions_dir() / sid / "work"
     d.mkdir(parents=True, exist_ok=True)
     return d
 
 
+def session_cwd(s: dict) -> Path:
+    """Where a session's harness runs: its folder, else its private work folder (older chat-only
+    sessions that already started a conversation keep the session data folder)."""
+    if s.get("folder"):
+        return Path(s["folder"])
+    legacy = sessions_dir() / s["id"]
+    settings = s.get("settings") or {}
+    if any(settings.get(k) for k in LEGACY_CWD_KEYS) and not (legacy / "work").is_dir():
+        legacy.mkdir(parents=True, exist_ok=True)
+        return legacy
+    return work_dir(s["id"])
+
+
+
+def new_session_harness(config: Any) -> str:
+    """The harness a session made from the New screen starts on: [sessions].default_harness
+    (claude_code by default); scheduled tasks, campaigns, fleet and subagents keep the built-in loop."""
+    try:
+        h = (getattr(config, "sessions", None) or {}).get("default_harness")
+    except AttributeError:
+        h = None
+    return h if h in HARNESSES else "builtin"
+
