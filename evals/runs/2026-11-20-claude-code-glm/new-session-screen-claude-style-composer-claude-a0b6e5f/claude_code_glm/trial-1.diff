diff --git a/frontend/src/components/NewSession.tsx b/frontend/src/components/NewSession.tsx
new file mode 100644
index 0000000..ff01bec
--- /dev/null
+++ b/frontend/src/components/NewSession.tsx
@@ -0,0 +1,138 @@
+// The New screen: a greeting and a large composer. Nothing is created until Send: then the session is
+// made (Claude subscription by default, [sessions].default_harness) and the first message sent.
+import { Folder, MessageSquare, X } from "lucide-react";
+import { useEffect, useMemo, useState } from "react";
+import { get, post } from "../lib/api";
+import { pickFolder } from "../lib/native";
+import { actions, useStore, type Session } from "../lib/store";
+import { ClaudeStatusNotice, useClaudeStatus } from "./ClaudeCode";
+import { Composer, EFFORTS, MODES, type Att } from "./Composer";
+import { SetupChecklist } from "./SetupChecklist";
+import { modelLabel } from "./ui";
+
+const RECENT_MAX = 5;
+const NEW_MODES = ["plan", "ask", "accept_edits"];
+
+/** The folders of the most recently active sessions, newest first, without duplicates. */
+export function recentFolders(sessions: Session[], max = RECENT_MAX): string[] {
+  const seen = new Set<string>();
+  const out: string[] = [];
+  const order = [...sessions].filter((s) => s.folder && !s.deleted)
+    .sort((a, b) => (b.activity_at ?? b.updated_at) - (a.activity_at ?? a.updated_at));
+  for (const s of order) {
+    if (seen.has(s.folder!)) continue;
+    seen.add(s.folder!);
+    out.push(s.folder!);
+    if (out.length >= max) break;
+  }
+  return out;
+}
+
+const baseName = (f: string) => f.replace(/\/+$/, "").split("/").pop() || f;
+
+export function NewSession() {
+  const appState = useStore((s) => s.appState);
+  const sessions = useStore((s) => s.sessions);
+  const [name, setName] = useState<string | null>(null);
+  useEffect(() => { get<{ name: string | null }>("/greeting").then((r) => setName(r?.name ?? null)).catch(() => {}); }, []);
+  const [st, refresh] = useClaudeStatus(true);
+  const [chatOnly, setChatOnly] = useState(true);
+  const [folder, setFolder] = useState<string | null>(null);
+  const [model, setModel] = useState<string>("");
+  const [effort, setEffort] = useState<string>("");
+  const [mode, setMode] = useState<string>("ask");
+  const recent = useMemo(() => recentFolders(sessions), [sessions]);
+  const models = useMemo(() => Object.keys(appState?.models ?? {}).filter((m) => m.startsWith("claude")), [appState]);
+
+  // The composer's stand-in session: what Send will create.
+  const draftSession = {
+    id: "new", title: "New session", folder: chatOnly ? null : folder, model, effort, mode, harness: "claude_code",
+    settings: {}, account: "", location: "local", status: "idle", created_at: 0, updated_at: 0, pinned: false,
+    group_id: null, sort_order: 0, archived: false, archived_at: null, deleted: false, deleted_at: null,
+    activity_at: null, last_read_at: null, unread: false, last_error: null, forked_from: null,
+  } as unknown as Session;
+
+  const choose = async () => {
+    const f = await pickFolder(folder ?? undefined);
+    if (f) { setFolder(f); setChatOnly(false); }
+  };
+
+  const onSend = async (text: string, atts: Att[], skill: string | null): Promise<boolean> => {
+    if (!chatOnly && !folder) { actions.toast("Pick a folder first, or switch to Chat only.", "error"); return false; }
+    let s: Session;
+    try {
+      s = await post<Session>("/sessions", {
+        ...(chatOnly ? {} : { folder }), ...(model ? { model } : {}), ...(effort ? { effort } : {}), mode,
+      });
+    } catch (e: any) { actions.toast(e.message, "error"); return false; }
+    useStore.setState((x) => ({ sessions: x.sessions.some((y) => y.id === s.id) ? x.sessions : [s, ...x.sessions] }));
+    try {
+      await post(`/sessions/${s.id}/messages`, { text, attachments: atts, ...(skill ? { skill } : {}) });
+    } catch (e: any) {
+      // The session exists but the message didn't go: open it with the text back in its composer.
+      actions.toast(e.message, "error");
+      await actions.openSession(s.id);
+      actions.setComposerText(text);
+      return false;
+    }
+    await actions.openSession(s.id);
+    return true;
+  };
+
+  const controls = (
+    <div className="flex-1 min-w-0 flex flex-wrap items-center gap-1.5">
+      <div className="flex rounded-md border border-line overflow-hidden" role="group" aria-label="Where the session works">
+        <button className={`px-2 py-0.5 flex items-center gap-1 ${chatOnly ? "bg-sunken text-text" : ""}`} aria-pressed={chatOnly} onClick={() => setChatOnly(true)}>
+          <MessageSquare size={12} aria-hidden />Chat only</button>
+        <button className={`px-2 py-0.5 flex items-center gap-1 ${!chatOnly ? "bg-sunken text-text" : ""}`} aria-pressed={!chatOnly}
+          onClick={() => (folder ? setChatOnly(false) : choose())}><Folder size={12} aria-hidden />Folder</button>
+      </div>
+      {!chatOnly && folder && (
+        <span className="chip text-text max-w-[220px]" title={folder}>
+          <Folder size={12} aria-hidden /><button className="truncate" onClick={choose}>{baseName(folder)}</button>
+          <button aria-label="Remove folder" onClick={() => { setFolder(null); setChatOnly(true); }}><X size={12} /></button>
+        </span>
+      )}
+      <select className="input py-0.5" aria-label="Model" value={model} onChange={(e) => setModel(e.target.value)}>
+        <option value="">Default model</option>
+        {models.map((m) => <option key={m} value={m}>{modelLabel(m)}</option>)}
+      </select>
+      <select className="input py-0.5" aria-label="Effort" value={effort} onChange={(e) => setEffort(e.target.value)}>
+        <option value="">Default effort</option>
+        {EFFORTS.map((x) => <option key={x} value={x}>{x}</option>)}
+      </select>
+      <select className="input py-0.5" aria-label="Mode" value={mode} onChange={(e) => setMode(e.target.value)}>
+        {NEW_MODES.map((x) => <option key={x} value={x}>{x === "plan" ? "Plan" : x === "ask" ? "Ask" : "Accept edits"}</option>)}
+      </select>
+    </div>
+  );
+
+  return (
+    <div className="h-full overflow-y-auto">
+      <div className="max-w-[780px] mx-auto px-4 pt-[12vh] pb-8 flex flex-col gap-4">
+        <h1 className="text-[28px] font-semibold text-center">{name ? `Hello, ${name}` : "Hello"}</h1>
+        <ClaudeStatusNotice st={st} onRefresh={refresh} />
+        <div className="rounded-xl border border-line surface-raised">
+          <Composer session={draftSession} running={false} draft={{
+            controls,
+            onSend,
+            onChange: (b) => {
+              if (b.model !== undefined) setModel(b.model);
+              if (b.effort !== undefined) setEffort(b.effort);
+              if (b.mode !== undefined && MODES[b.mode]) setMode(b.mode);
+            },
+          }} />
+        </div>
+        {recent.length > 0 && (
+          <div className="flex flex-wrap justify-center gap-1.5" aria-label="Recent folders">
+            {recent.map((f) => (
+              <button key={f} className={`chip ${!chatOnly && folder === f ? "text-text" : ""}`} title={f}
+                onClick={() => { setFolder(f); setChatOnly(false); }}><Folder size={12} aria-hidden />{baseName(f)}</button>
+            ))}
+          </div>
+        )}
+        <SetupChecklist />
+      </div>
+    </div>
+  );
+}
