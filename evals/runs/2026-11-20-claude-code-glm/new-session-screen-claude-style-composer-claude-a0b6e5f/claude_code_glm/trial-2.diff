+def account_full_name() -> str:
+    """This Mac account's full name (System Settings → Users & Groups), or "" if unknown."""
+    try:
+        name = pwd.getpwuid(os.getuid()).pw_gecos.split(",")[0].strip()
+    except (KeyError, OSError):
+        name = ""
+    if not name and shutil.which("id"):
+        try:
+            name = subprocess.run(["id", "-F"], capture_output=True, text=True, timeout=2).stdout.strip()
+        except (OSError, subprocess.SubprocessError):
+            name = ""
+    return name
+
+
+def greeting_name(full: str) -> str | None:
+    """The first name to greet the user with, or None for a generic greeting."""
+    parts = (full or "").strip().split()
+    if not parts:
+        return None
+    first = parts[0].strip(",.")
+    if not first or not any(c.isalpha() for c in first) or len(first) > 40:
+        return None
+    return first
+
