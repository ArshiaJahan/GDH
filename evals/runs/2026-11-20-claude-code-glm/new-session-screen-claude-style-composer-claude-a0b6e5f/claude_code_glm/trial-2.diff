@@ -0,0 +1,134 @@
+// The New screen (⌘N): a greeting with the Mac account's first name, a large composer and the
+// settings for the session it makes: Chat only or a Folder, Claude model, effort and mode, plus
+// recent-folder pills. Nothing is created until Send; new sessions run on the Claude Code harness
+// (the user's Claude subscription, [sessions].default_harness).
+import { Folder, MessageSquare, X } from "lucide-react";
+import { useEffect, useMemo, useRef, useState } from "react";
+import { get, post } from "../lib/api";
+import { pickFolder } from "../lib/native";
+import { newSessionGroup } from "../lib/sessions";
+import { actions, useStore, type Session } from "../lib/store";
+import { ClaudeStatusNotice, useClaudeStatus } from "./ClaudeCode";
+import { Composer, type ComposerDraft } from "./Composer";
+import { SetupChecklist } from "./SetupChecklist";
+import { modelLabel } from "./ui";
+
+export const RECENT_MAX = 5;
+const EFFORTS = ["low", "medium", "high", "xhigh", "max"];
+const MODES: [string, string][] = [["plan", "Plan"], ["ask", "Ask"], ["accept_edits", "Accept edits"]];
+
+/** Folders of the most recently used sessions, newest first, each once (Trash left out). */
+export function recentFolders(sessions: Session[], max = RECENT_MAX): string[] {
+  const seen = new Set<string>();
+  const sorted = [...sessions].filter((s) => s.folder && !s.deleted)
+    .sort((a, b) => (b.activity_at ?? b.updated_at) - (a.activity_at ?? a.updated_at));
+  for (const s of sorted) {
+    if (seen.size >= max) break;
+    seen.add(s.folder!);
+  }
+  return [...seen];
+}
+
+const base = (p: string) => p.replace(/\/+$/, "").split("/").pop() || p;
+
+function greetingText(name: string | null): string {
+  const h = new Date().getHours();
+  const part = h < 5 ? "Working late" : h < 12 ? "Good morning" : h < 18 ? "Good afternoon" : "Good evening";
+  return name ? `${part}, ${name}` : part;
+}
+
+export function NewSession() {
+  const appState = useStore((s) => s.appState);
+  const sessions = useStore((s) => s.sessions);
+  const [name, setName] = useState<string | null>(null);
+  useEffect(() => { get<{ name: string | null }>("/greeting").then((r) => setName(r?.name ?? null)).catch(() => setName(null)); }, []);
+  const [st, refresh] = useClaudeStatus(true);
+
+  const claudeModels = useMemo(() => Object.entries<any>(appState?.models ?? {})
+    .filter(([, m]) => (m?.provider ?? "anthropic") === "anthropic").map(([id]) => id), [appState]);
+  const [chatOnly, setChatOnly] = useState(true);
+  const [folder, setFolder] = useState<string | null>(null);
+  const [model, setModel] = useState<string>("");
+  const [effort, setEffort] = useState("medium");
+  const [mode, setMode] = useState("ask");
+  useEffect(() => { if (!model && claudeModels.length) setModel(claudeModels[0]); }, [claudeModels, model]);
+  const recent = useMemo(() => recentFolders(sessions), [sessions]);
+  const made = useRef<Session | null>(null); // a session made by a Send whose message then failed
+
+  const choose = async () => {
+    const f = await pickFolder(folder ?? undefined);
+    if (f) { setFolder(f); setChatOnly(false); }
+  };
+  const useFolder = folder && !chatOnly ? folder : null;
+
+  const draft: ComposerDraft = {
+    set: (b) => {
+      if (b.model) setModel(b.model);
+      if (b.effort) setEffort(b.effort);
+      if (b.mode) setMode(b.mode);
+    },
+    create: async () => {
+      if (made.current && (made.current.folder ?? null) === useFolder) return made.current;
+      const s = await post<Session>("/sessions", {
+        folder: useFolder, harness: "claude_code", effort, mode, ...(model ? { model } : {}),
+        ...(newSessionGroup ? { group_id: newSessionGroup } : {}),
+      });
+      made.current = s;
+      return s;
+    },
+    sent: (s) => { made.current = null; actions.openSession(s.id); },
+    placeholder: "How can I help you today?",
+    controls: (
+      <>
+        <div className="inline-flex rounded-md border border-line overflow-hidden" role="group" aria-label="Where the session works">
+          <button className={`px-2 py-0.5 inline-flex items-center gap-1 ${chatOnly ? "bg-sunken text-text" : ""}`} aria-pressed={chatOnly} onClick={() => setChatOnly(true)}>
+            <MessageSquare size={12} aria-hidden />Chat only
+          </button>
+          <button className={`px-2 py-0.5 inline-flex items-center gap-1 ${!chatOnly ? "bg-sunken text-text" : ""}`} aria-pressed={!chatOnly}
+            onClick={() => (folder ? setChatOnly(false) : choose())}>
+            <Folder size={12} aria-hidden />Folder
+          </button>
+        </div>
+        {!chatOnly && folder && (
+          <span className="chip text-text" title={folder} data-testid="folder-chip">
+            <Folder size={12} aria-hidden /><button onClick={choose}>{base(folder)}</button>
+            <button aria-label="Chat only (no folder)" onClick={() => { setFolder(null); setChatOnly(true); }}><X size={12} /></button>
+          </span>
+        )}
+        <select className="input py-0.5 w-auto" aria-label="Model" value={model} onChange={(e) => setModel(e.target.value)}>
+          {claudeModels.map((m) => <option key={m} value={m}>{modelLabel(m)}</option>)}
+        </select>
+        <select className="input py-0.5 w-auto" aria-label="Effort" value={effort} onChange={(e) => setEffort(e.target.value)}>
+          {EFFORTS.map((x) => <option key={x} value={x}>{x}</option>)}
+        </select>
+        <select className="input py-0.5 w-auto" aria-label="Mode" value={mode} onChange={(e) => setMode(e.target.value)}>
+          {MODES.map(([v, l]) => <option key={v} value={v}>{l}</option>)}
+        </select>
+      </>
+    ),
+  };
+
+  // Composer needs a session shape; this one only exists until Send.
+  const pseudo = { id: "new", title: "New session", folder: useFolder, model, effort, mode, harness: "claude_code", settings: {} } as unknown as Session;
+
+  return (
+    <div className="h-full overflow-y-auto scroll-thin" data-testid="new-session">
+      <div className="max-w-[780px] mx-auto px-1 pt-[12vh] pb-10 flex flex-col gap-4">
+        <div className="px-4"><SetupChecklist /></div>
+        <h1 className="px-4 text-[28px] font-serif text-text text-center">{greetingText(name)}</h1>
+        <div className="px-4"><ClaudeStatusNotice st={st} onRefresh={refresh} /></div>
+        <Composer session={pseudo} running={false} draft={draft} />
+        {recent.length > 0 && (
+          <div className="px-4 flex flex-wrap justify-center gap-1.5 text-[12.5px]" aria-label="Recent folders">
+            {recent.map((f) => (
+              <button key={f} className={`chip ${useFolder === f ? "text-action" : "text-muted"}`} title={f}
+                onClick={() => { setFolder(f); setChatOnly(false); }}>
+                <Folder size={12} aria-hidden />{base(f)}
+              </button>
+            ))}
+          </div>
+        )}
+      </div>
+    </div>
+  );
+}
