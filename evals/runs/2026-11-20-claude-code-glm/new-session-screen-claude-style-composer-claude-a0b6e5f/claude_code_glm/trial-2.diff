+SAFE_SID = re.compile(r"[A-Za-z0-9_-]{1,64}")
+DEFAULT_NEW_HARNESS = "claude_code"
+NEW_SESSION_HARNESSES = ("builtin", "agent_sdk", "codex_cli", "claude_code")
+
+
+def work_dir(sid: str) -> Path:
+    """A chat-only session's private working folder (sessions/<sid>/work, owner-only), created on
+    first use and removed with the session."""
+    if not isinstance(sid, str) or not SAFE_SID.fullmatch(sid):
+        raise ValueError(f"Bad session id {sid!r}")
+    d = sessions_dir() / sid / "work"
+    d.mkdir(parents=True, exist_ok=True, mode=0o700)
+    for p in (d.parent, d):
+        try:
+            p.chmod(0o700)
+        except OSError:
+            pass
     return d
 
 
+def session_cwd(s: dict) -> Path:
+    """The folder a session's tools run in: its chosen folder, else a private per-session folder.
+    Chat-only sessions from before work_dir ran in sessions/<sid> itself and keep it, so the
+    claude CLI's `--resume` (keyed on the working folder) still finds their conversation."""
+    if s.get("folder"):
+        return Path(s["folder"])
+    sid = s["id"]
+    if not isinstance(sid, str) or not SAFE_SID.fullmatch(sid):
+        raise ValueError(f"Bad session id {sid!r}")
+    legacy = sessions_dir() / sid
+    if legacy.is_dir() and not (legacy / "work").is_dir():
+        return legacy
+    return work_dir(sid)
+
+
+_cwd = session_cwd  # kept for importers
+
+
+def new_session_harness(config: Any) -> str:
+    """The harness a session made from the New screen starts on ([sessions].default_harness, by
+    default the Claude Code harness on the user's Claude subscription). Scheduled tasks, campaigns,
+    fleet and subagents create sessions through the store and keep the built-in loop."""
+    sessions = getattr(config, "sessions", None) or {}
+    h = sessions.get("default_harness", DEFAULT_NEW_HARNESS) if isinstance(sessions, dict) else DEFAULT_NEW_HARNESS
+    return h if h in NEW_SESSION_HARNESSES else "builtin"
+
+
