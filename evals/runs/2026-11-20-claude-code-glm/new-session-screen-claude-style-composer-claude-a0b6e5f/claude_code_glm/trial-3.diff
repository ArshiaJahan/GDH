+def work_dir(sid: str) -> Path:
+    """A chat-only session's private working folder, data_dir/sessions/<sid>/work (created, 0700).
+    It has no CLAUDE.md or project files above it that belong to anyone else."""
+    if not isinstance(sid, str) or not sid or Path(sid).name != sid or sid in (".", ".."):
+        raise ValueError(f"Bad session id {sid!r}")
+    p = sessions_dir() / sid / "work"
+    p.mkdir(parents=True, exist_ok=True, mode=0o700)
+    return p
+
+
