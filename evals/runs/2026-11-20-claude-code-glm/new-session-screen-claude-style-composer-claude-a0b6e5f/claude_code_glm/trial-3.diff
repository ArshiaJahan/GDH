diff --git a/frontend/src/components/NewSession.tsx b/frontend/src/components/NewSession.tsx
new file mode 100644
index 0000000..04b3410
--- /dev/null
+++ b/frontend/src/components/NewSession.tsx
@@ -0,0 +1,156 @@
+// The New screen (⌘N, or no session open): a greeting with the Mac account's first name, a large
+// composer with Chat only / Folder, the folder chip, model, effort, mode and Tools, and pills for
+// recently used folders. Nothing is created until Send: then POST /sessions with these choices
+// (the harness is the server's [sessions].default_harness, the Claude subscription by default).
+import { Folder, MessageSquare, Wrench, X } from "lucide-react";
+import { useEffect, useMemo, useState } from "react";
+import { get, post } from "../lib/api";
+import { pickFolder } from "../lib/native";
+import { newSessionGroup } from "../lib/sessions";
+import { actions, useStore, type Session } from "../lib/store";
+import { ClaudeStatusNotice, harnessName, useClaudeStatus } from "./ClaudeCode";
+import { Composer, type ComposerDraft } from "./Composer";
+import { Popover } from "./Popover";
+import { SetupChecklist } from "./SetupChecklist";
+import { modelLabel } from "./ui";
+
+const RECENT_MAX = 5;
+const EFFORTS = ["low", "medium", "high", "xhigh", "max"];
+const MODES: [string, string][] = [["plan", "Plan"], ["ask", "Ask"], ["accept_edits", "Accept edits"]];
+const CLAUDE_MODELS = /^claude[-.]/;
+
+/** The folders of the most recently active sessions, newest first, without duplicates. */
+export function recentFolders(sessions: Session[], max = RECENT_MAX): string[] {
+  const seen = new Set<string>();
+  const out: string[] = [];
+  const ordered = [...sessions].filter((s) => !s.deleted && s.folder)
+    .sort((a, b) => (b.activity_at ?? b.updated_at ?? 0) - (a.activity_at ?? a.updated_at ?? 0));
+  for (const s of ordered) {
+    const f = s.folder as string;
+    if (seen.has(f)) continue;
+    seen.add(f);
+    out.push(f);
+    if (out.length >= max) break;
+  }
+  return out;
+}
+
+const baseName = (f: string) => f.replace(/\/+$/, "").split("/").pop() || f;
+
+function greetingText(name: string | null): string {
+  const h = new Date().getHours();
+  const part = h < 5 ? "Good evening" : h < 12 ? "Good morning" : h < 18 ? "Good afternoon" : "Good evening";
+  return name ? `${part}, ${name}` : part;
+}
+
+export function NewSession() {
+  const appState = useStore((s) => s.appState);
+  const sessions = useStore((s) => s.sessions);
+  const [name, setName] = useState<string | null>(null);
+  useEffect(() => { get<{ name: string | null }>("/greeting").then((r) => setName(r?.name ?? null)).catch(() => setName(null)); }, []);
+  const [cli, refreshCli] = useClaudeStatus(true);
+  const defaults = appState?.orchestrator ?? {};
+  const [folderMode, setFolderMode] = useState(false);
+  const [folder, setFolder] = useState<string | null>(null);
+  const [model, setModel] = useState<string>(defaults.model ?? "claude-opus-5-5");
+  const [effort, setEffort] = useState<string>(defaults.effort ?? "medium");
+  const [mode, setMode] = useState<string>(appState?.modes?.default ?? "ask");
+  const [toolsOpen, setToolsOpen] = useState(false);
+  const recent = useMemo(() => recentFolders(sessions), [sessions]);
+  // Claude subscription sessions run Claude models; the list falls back to every model when none match.
+  const models = useMemo(() => {
+    const all = [...Object.keys(appState?.tiers ?? {}), ...Object.keys(appState?.models ?? {})];
+    const claude = all.filter((m) => CLAUDE_MODELS.test(m));
+    return claude.length ? claude : all;
+  }, [appState]);
+
+  const choose = async () => {
+    const f = await pickFolder(folder ?? undefined);
+    if (f) { setFolder(f); setFolderMode(true); }
+  };
+
+  const draftSession = {
+    id: "new", title: "New session", folder: folderMode ? folder : null, model, effort, mode,
+    harness: "claude_code", settings: {}, status: "idle", group_id: newSessionGroup.current,
+  } as unknown as Session;
+
+  const draft: ComposerDraft = {
+    async create() {
+      if (folderMode && !folder) throw new Error("Pick a folder first, or switch to Chat only.");
+      const group_id = newSessionGroup.current;
+      return await post<Session>("/sessions", {
+        folder: folderMode ? folder : null, model, effort, mode,
+        ...(group_id ? { group_id } : {}),
+      });
+    },
+    update(body) {
+      if (body.model) setModel(body.model);
+      if (body.effort) setEffort(body.effort);
+      if (body.mode) setMode(body.mode);
+    },
+    open(sid) {
+      newSessionGroup.current = null;
+      actions.openSession(sid);
+    },
+  };
+
+  const toolbar = (
+    <div className="mt-2 flex flex-wrap items-center gap-1.5 text-[12.5px]" data-testid="new-session-toolbar">
+      <div className="inline-flex rounded-md border border-line overflow-hidden" role="group" aria-label="Where this session works">
+        <button className={`px-2 py-0.5 flex items-center gap-1 ${!folderMode ? "bg-sunken text-text" : "text-muted"}`} aria-pressed={!folderMode}
+          onClick={() => setFolderMode(false)}><MessageSquare size={12} />Chat only</button>
+        <button className={`px-2 py-0.5 flex items-center gap-1 ${folderMode ? "bg-sunken text-text" : "text-muted"}`} aria-pressed={folderMode}
+          onClick={() => (folder ? setFolderMode(true) : choose())}><Folder size={12} />Folder</button>
+      </div>
+      {folderMode && folder && (
+        <span className="chip max-w-[240px]" title={folder}>
+          <Folder size={12} /><button className="truncate" onClick={choose} aria-label="Change folder">{baseName(folder)}</button>
+          <button aria-label="Remove folder" onClick={() => { setFolder(null); setFolderMode(false); }}><X size={12} /></button>
+        </span>
+      )}
+      <span className="flex-1" />
+      <select className="input py-0.5 w-auto" aria-label="Model" value={model} onChange={(e) => setModel(e.target.value)}>
+        {!models.includes(model) && <option value={model}>{modelLabel(model)}</option>}
+        {models.map((m) => <option key={m} value={m}>{modelLabel(m)}</option>)}
+      </select>
+      <select className="input py-0.5 w-auto" aria-label="Effort" value={effort} onChange={(e) => setEffort(e.target.value)}>
+        {EFFORTS.map((x) => <option key={x} value={x}>{x}</option>)}
+      </select>
+      <select className="input py-0.5 w-auto" aria-label="Mode" value={mode} onChange={(e) => setMode(e.target.value)}>
+        {MODES.map(([v, l]) => <option key={v} value={v}>{l}</option>)}
+      </select>
+      <div className="relative">
+        <button className="btn btn-ghost px-1.5 py-0.5 flex items-center gap-1" aria-haspopup="dialog" aria-expanded={toolsOpen}
+          onClick={() => setToolsOpen((o) => !o)}><Wrench size={12} />Tools</button>
+        <Popover open={toolsOpen} onClose={() => setToolsOpen(false)} above label="Tools" className="w-[280px] p-3 text-[13px]">
+          <p className="text-muted">
+            Sessions run on {harnessName("claude_code")} with GameDevWorkstation's tools (task board, Unity, gallery).
+            Skills and connectors can be changed in the side panel after the first message.
+          </p>
+        </Popover>
+      </div>
+    </div>
+  );
+
+  return (
+    <div className="h-full overflow-y-auto scroll-thin" data-testid="new-session">
+      <div className="min-h-full flex flex-col items-center justify-center px-5 py-10">
+        <div className="w-full max-w-[720px]">
+          <SetupChecklist />
+          <h1 className="text-[28px] font-serif text-center mb-6">{greetingText(name)}</h1>
+          <ClaudeStatusNotice st={cli} onRefresh={refreshCli} />
+          <Composer session={draftSession} running={false} draft={draft} toolbar={toolbar}
+            className="rounded-xl border border-line surface-raised px-3 py-3 shadow-sm" />
+          {recent.length > 0 && (
+            <div className="mt-3 flex flex-wrap justify-center gap-1.5" aria-label="Recent folders">
+              {recent.map((f) => (
+                <button key={f} className={`chip ${folderMode && folder === f ? "text-text border-action" : "text-muted"}`} title={f}
+                  onClick={() => { setFolder(f); setFolderMode(true); }}><Folder size={12} />{baseName(f)}</button>
+              ))}
+            </div>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+}
