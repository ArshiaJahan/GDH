+        /// <summary>SHA-256 of a project-relative file, or of nothing when it is missing or unreadable.</summary>
+        static string FileSha256(string projectRoot, string relativePath)
+        {
+            try
+            {
+                if (!string.IsNullOrEmpty(relativePath))
+                {
+                    string path = Path.Combine(projectRoot, relativePath);
+                    if (File.Exists(path)) return Digest.Sha256Hex(File.ReadAllBytes(path));
+                }
+            }
+            catch (Exception e)
+            {
+                Debug.LogWarning("[Gdw.Replay] could not hash " + relativePath + ": " + e.Message);
+            }
+            return Digest.Sha256Hex(new byte[0]);
