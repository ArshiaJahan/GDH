+        /// </summary>
+        static string ProjectSettingsSha256(string projectRoot)
+        {
+            var canonical = new List<byte>();
+            try
+            {
+                string dir = Path.Combine(projectRoot, "ProjectSettings");
+                if (Directory.Exists(dir))
+                {
+                    var files = new List<string>(Directory.GetFiles(dir, "*.asset"));
+                    files.Sort(StringComparer.Ordinal);
+                    foreach (var file in files)
+                    {
+                        byte[] name = Digest.Utf8("ProjectSettings/" + Path.GetFileName(file));
+                        byte[] bytes = File.ReadAllBytes(file);
+                        canonical.AddRange(Digest.U32((uint)name.Length));
+                        canonical.AddRange(name);
+                        canonical.AddRange(Digest.U32((uint)bytes.Length));
+                        canonical.AddRange(bytes);
+                    }
+                }
+            }
+            catch (Exception e)
+            {
+                Debug.LogWarning("[Gdw.Replay] could not hash project settings: " + e.Message);
+            }
+            return Digest.Sha256Hex(canonical.ToArray());
+        }
