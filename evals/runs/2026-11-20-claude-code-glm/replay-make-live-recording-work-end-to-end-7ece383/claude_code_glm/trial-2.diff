+        /// <summary>SHA-256 of a file's bytes; the empty hash when it does not exist.</summary>
+        static string FileSha256(string path)
+        {
+            try
+            {
+                if (!string.IsNullOrEmpty(path) && File.Exists(path))
+                    return Digest.Sha256Hex(File.ReadAllBytes(path));
+            }
+            catch (Exception e)
+            {
+                Debug.LogWarning("[Gdw.Replay] could not hash " + path + ": " + e.Message);
+            }
+            return EmptySha256;
+        }
+
+        /// <summary>
+        /// Digest of ProjectSettings/: each file's relative POSIX path and bytes, in ordinal path order.
+        /// </summary>
+        static string ProjectSettingsSha256(string projectRoot)
+        {
+            string dir = Path.Combine(projectRoot, "ProjectSettings");
+            if (!Directory.Exists(dir)) return EmptySha256;
+            var entries = new List<KeyValuePair<string, string>>();
+            foreach (var file in Directory.GetFiles(dir, "*", SearchOption.AllDirectories))
+            {
+                string rel = file.Substring(dir.Length).TrimStart('/', '\\').Replace('\\', '/');
+                entries.Add(new KeyValuePair<string, string>(rel, file));
+            }
+            entries.Sort((a, b) => StringComparer.Ordinal.Compare(a.Key, b.Key));
+            var parts = new List<byte[]>();
+            foreach (var entry in entries)
+            {
+                byte[] data;
+                try { data = File.ReadAllBytes(entry.Value); }
+                catch (IOException) { continue; }
+                byte[] name = Digest.Utf8(entry.Key);
+                parts.Add(Digest.U32((uint)name.Length));
+                parts.Add(name);
+                parts.Add(Digest.U64((ulong)data.Length));
+                parts.Add(data);
+            }
+            return Digest.Sha256Hex(Digest.Concat(parts.ToArray()));
+        }
