+                string meta = Path.Combine(projectRoot, scenePath + ".meta");
+                if (!File.Exists(meta)) return "";
+                foreach (var line in File.ReadAllLines(meta))
+                {
+                    if (line.StartsWith("guid:", StringComparison.Ordinal))
+                        return line.Substring(5).Trim();
+                }
+            }
