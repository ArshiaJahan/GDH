diff --git a/backend/gamedevworkstation/features/media_outputs.py b/backend/gamedevworkstation/features/media_outputs.py
new file mode 100644
index 0000000..1a149cd
--- /dev/null
+++ b/backend/gamedevworkstation/features/media_outputs.py
@@ -0,0 +1,138 @@
+"""Media outputs: videos and audio a `run_command` writes (an ffmpeg render, a trailer cut, a mix)
+become items of the session, so they show in the chat and the Items panel like ElevenLabs outputs.
+
+- post_tool  media_outputs.observe  (fail open): paths with a media extension in the command or its
+  output that exist in the session folder and changed since the turn started are indexed (at most
+  MAX_PER_CALL per call). Re-rendering the same path makes a new version of its item; an unchanged
+  file is not indexed again.
+"""
+from __future__ import annotations
+
+import asyncio
+import json
+import logging
+import mimetypes
+import re
+import shlex
+from pathlib import Path
+from typing import TYPE_CHECKING
+
+from fastapi import APIRouter, FastAPI
+
+from ..items import classify
+from .hookbus import HookEvent, HookResult
+
+if TYPE_CHECKING:
+    from ..app import AppState
+
+log = logging.getLogger(__name__)
+
+MAX_PER_CALL = 8  # files indexed per tool call (a batch export can't flood the Items panel)
+MEDIA_EXTS = frozenset({".mp4", ".mov", ".m4v", ".webm", ".mkv", ".avi", ".gif",
+                        ".mp3", ".wav", ".m4a", ".aac", ".ogg", ".opus", ".flac"})
+_EXT = "|".join(sorted((e[1:] for e in MEDIA_EXTS), key=len, reverse=True))
+# A quoted path (may hold spaces), else a run of non-space characters, ending in a media extension.
+_PATH_RE = re.compile(rf"""(?:"([^"\n]+?\.(?:{_EXT}))"|'([^'\n]+?\.(?:{_EXT}))'|([^\s"'`<>|;,()=\[\]]+?\.(?:{_EXT})))"""
+                      rf"""(?![\w.])""", re.I)
+
+
+def media_paths(text: str) -> list[str]:
+    """Paths of video/audio files mentioned in `text` (quoted or bare), in order, without repeats.
+    URLs and ffmpeg patterns (`%03d`) are left out."""
+    out: list[str] = []
+    for m in _PATH_RE.finditer(text or ""):
+        p = (m.group(1) or m.group(2) or m.group(3) or "").strip()
+        if not p or "://" in p or "%" in p or "*" in p:
+            continue
+        p = p.lstrip("[").rstrip(":")
+        if p not in out:
+            out.append(p)
+    return out
+
+
+class MediaOutputs:
+    """app.extensions["media_outputs"]."""
+
+    def __init__(self, app: "AppState"):
+        self.app = app
+
+    async def observe(self, ev: HookEvent) -> HookResult | None:
+        """post_tool on run_command: index the media files it wrote (fail open)."""
+        out, ctx = ev.output, ev.ctx
+        folder = ctx.folder
+        if out is None or not folder or ev.tool != "run_command" or not out.text.startswith("exit code "):
+            return None  # declined, Plan mode, started in the background, or no folder
+        command = str((ev.args or {}).get("command") or "")
+        try:
+            words = " ".join(shlex.quote(w) for w in shlex.split(command))
+        except ValueError:
+            words = command
+        since = ev.turn.started_at if ev.turn else 0.0
+        found = await asyncio.to_thread(self._files, folder, media_paths(words + "\n" + out.text), since)
+        ids = [iid for p in found if (iid := self.index(ctx, p))]
+        if not ids:
+            return None
+        return HookResult(action="note", note="[Media] Indexed as items: " + ", ".join(
+            f"{p.name} ({iid})" for p, iid in zip(found, ids)))
+
+    @staticmethod
+    def _files(folder: Path, paths: list[str], since: float) -> list[Path]:
+        root = Path(folder).expanduser().resolve()
+        got: list[Path] = []
+        for s in paths:
+            p = Path(s).expanduser()
+            try:
+                p = (p if p.is_absolute() else root / p).resolve()
+                if not p.is_relative_to(root) or not p.is_file() or p.stat().st_size == 0:
+                    continue
+                if p.stat().st_mtime + 1 < since:  # older than this turn: mentioned, not made
+                    continue
+            except OSError:
+                continue
+            if p.suffix.lower() in MEDIA_EXTS and p not in got:
+                got.append(p)
+            if len(got) >= MAX_PER_CALL:
+                break
+        return got
+
+    def index(self, ctx, path: Path) -> str | None:
+        """An item for `path` (a new version when the file changed since it was last indexed); None
+        when this version is already indexed or indexing fails."""
+        st = path.stat()
+        mtime = round(st.st_mtime, 3)
+        prev = self.app.db.one("SELECT id, meta FROM items WHERE session_id=? AND path=? AND deleted=0 "
+                               "ORDER BY version DESC LIMIT 1", [ctx.session_id, str(path)])
+        if prev:
+            try:
+                meta = json.loads(prev.get("meta") or "{}")
+            except ValueError:
+                meta = {}
+            if meta.get("mtime") == mtime and meta.get("size") == st.st_size:
+                return None
+        mime = mimetypes.guess_type(path.name)[0]
+        kind, subtype = classify(path, mime)
+        try:
+            return self.app.items.add(kind=kind, subtype=subtype, source="tool", session_id=ctx.session_id,
+                                      message_id=ctx.message_id, provider=ctx.provider, model=ctx.model,
+                                      title=path.name, path=str(path), mime=mime, extracted_text="",
+                                      meta={"mtime": mtime, "size": st.st_size, "from": "run_command"},
+                                      parent_id=prev["id"] if prev else None)
+        except Exception:  # noqa: BLE001
+            log.info("media_outputs: couldn't index %s", path, exc_info=True)
+            return None
+
+
+def install(app: "AppState") -> MediaOutputs:
+    """Register the observer on an app (idempotent). register() calls this; tests call it on a bare AppState."""
+    mo = app.extensions.get("media_outputs")
+    if isinstance(mo, MediaOutputs):
+        return mo
+    mo = MediaOutputs(app)
+    app.extensions["media_outputs"] = mo
+    app.hooks.register("post_tool", "media_outputs.observe", mo.observe, order=30,
+                       when=lambda ev: ev.tool == "run_command")
+    return mo
+
+
+def register(app_: FastAPI, api: APIRouter, S: "AppState") -> None:
+    install(S)
