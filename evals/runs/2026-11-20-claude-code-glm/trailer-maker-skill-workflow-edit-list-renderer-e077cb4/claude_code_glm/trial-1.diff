@@ -0,0 +1,394 @@
+#!/usr/bin/env python3
+"""Trailer helper for the trailer-maker skill: ffmpeg checks, probing and the edit-list renderer.
+
+    trailer.py check                     ffmpeg/ffprobe found? which filters/encoders it has
+    trailer.py probe FILE...             duration, size, fps, audio of each file
+    trailer.py render EDIT.json [--dry-run]
+                                         validate an edit list and render it with one ffmpeg call
+
+ffmpeg is looked up in $TRAILER_FFMPEG, then PATH, then the Homebrew prefixes (ffmpeg-full first).
+Edit list (JSON, paths relative to the file's folder):
+
+    {"output": "out/trailer.mp4", "width": 1920, "height": 1080, "fps": 30,
+     "clips": [{"src": "footage/boss.mp4", "in": 12.0, "out": 15.5, "speed": 1.0,
+                "fade_in": 0.2, "fade_out": 0.2},
+               {"card": "cards/title.png", "duration": 2.5, "fade_in": 0.3}],
+     "audio": [{"src": "audio/music.mp3", "start": 0, "gain_db": -2, "fade_out": 1.5},
+               {"src": "audio/vo_01.mp3", "start": 4.0}],
+     "fade_out": 1.0}
+
+Clip audio is never used: footage is muted and the soundtrack comes from "audio" (see
+references/audio.md). The last line is machine-readable: RESULT: OK ... | RESULT: FAIL ...
+Python 3.9+, standard library only.
+"""
+from __future__ import annotations
+
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+BREW_DIRS = ("/opt/homebrew/opt/ffmpeg-full/bin", "/usr/local/opt/ffmpeg-full/bin", "/opt/homebrew/bin", "/usr/local/bin")
+WANT_FILTERS = ("drawtext", "subtitles", "xfade", "loudnorm", "amix", "afade", "zscale")
+WANT_ENCODERS = ("libx264", "libx265", "h264_videotoolbox", "aac", "libopus", "libvpx-vp9")
+IMAGE_EXTS = {".png", ".jpg", ".jpeg", ".webp", ".bmp", ".tif", ".tiff"}
+
+
+def out(*args):
+    print(*args, flush=True)
+
+
+def result(ok, summary):
+    """Print the RESULT line and return the exit code."""
+    out("RESULT: %s %s" % ("OK" if ok else "FAIL", summary))
+    return 0 if ok else 1
+
+
+def find_ffmpeg():
+    """(ffmpeg, ffprobe) paths; either may be None."""
+    env = os.environ.get("TRAILER_FFMPEG")
+    if env:
+        p = Path(env).expanduser()
+        if p.is_dir():
+            p = p / "ffmpeg"
+        ff = str(p) if p.is_file() else None
+        probe = p.with_name("ffprobe")
+        return ff, (str(probe) if probe.is_file() else shutil.which("ffprobe"))
+    for d in BREW_DIRS[:2]:  # the full build wins over a slim one on PATH
+        if Path(d, "ffmpeg").is_file():
+            fp = Path(d, "ffprobe")
+            return str(Path(d, "ffmpeg")), (str(fp) if fp.is_file() else None)
+    ff = shutil.which("ffmpeg")
+    fp = shutil.which("ffprobe")
+    for d in BREW_DIRS[2:]:
+        ff = ff or (str(Path(d, "ffmpeg")) if Path(d, "ffmpeg").is_file() else None)
+        fp = fp or (str(Path(d, "ffprobe")) if Path(d, "ffprobe").is_file() else None)
+    return ff, fp
+
+
+def _run(cmd, timeout=60):
+    try:
+        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
+        return r.returncode, r.stdout, r.stderr
+    except (OSError, subprocess.SubprocessError) as e:
+        return -1, "", str(e)
+
+
+def ffmpeg_caps(ffmpeg):
+    """{"version": str, "filters": {name: bool}, "encoders": {name: bool}} for the wanted ones."""
+    _, v, _ = _run([ffmpeg, "-hide_banner", "-version"])
+    _, f, _ = _run([ffmpeg, "-hide_banner", "-filters"])
+    _, e, _ = _run([ffmpeg, "-hide_banner", "-encoders"])
+    m = re.search(r"ffmpeg version (\S+)", v)
+    names_f = {ln.split()[1] for ln in f.splitlines() if len(ln.split()) > 2 and re.match(r"^ [.TSC|]{2,3} ", ln)}
+    names_e = {ln.split()[1] for ln in e.splitlines() if len(ln.split()) > 1 and re.match(r"^ [VAS][.FSXBD]{5} ", ln)}
+    return {"version": m.group(1) if m else "unknown",
+            "filters": {n: n in names_f for n in WANT_FILTERS},
+            "encoders": {n: n in names_e for n in WANT_ENCODERS}}
+
+
+def _fps(rate):
+    try:
+        n, _, d = str(rate).partition("/")
+        return round(float(n) / float(d or 1), 3) if float(d or 1) else None
+    except ValueError:
+        return None
+
+
+def probe(ffprobe, path):
+    """{"duration": s, "streams": [{"kind": "video"|"audio", "codec", ...}]} from ffprobe, or None."""
+    code, so, _ = _run([ffprobe, "-v", "error", "-print_format", "json", "-show_format", "-show_streams", str(path)])
+    if code != 0:
+        return None
+    try:
+        data = json.loads(so)
+    except ValueError:
+        return None
+    streams = []
+    for s in data.get("streams", []):
+        kind = s.get("codec_type")
+        if kind == "video":
+            streams.append({"kind": "video", "codec": s.get("codec_name"), "width": s.get("width"),
+                            "height": s.get("height"), "fps": _fps(s.get("avg_frame_rate") or s.get("r_frame_rate"))})
+        elif kind == "audio":
+            streams.append({"kind": "audio", "codec": s.get("codec_name"),
+                            "sample_rate": int(s.get("sample_rate") or 0) or None, "channels": s.get("channels")})
+    try:
+        dur = float((data.get("format") or {}).get("duration"))
+    except (TypeError, ValueError):
+        dur = None
+    return {"duration": dur, "streams": streams}
+
+
+def parse_ffmpeg_info(stderr):
+    """The same shape as probe(), from `ffmpeg -i FILE` stderr (used when there is no ffprobe)."""
+    info = {"duration": None, "streams": []}
+    m = re.search(r"Duration:\s*(\d+):(\d+):(\d+(?:\.\d+)?)", stderr or "")
+    if m:
+        info["duration"] = int(m.group(1)) * 3600 + int(m.group(2)) * 60 + float(m.group(3))
+    for ln in (stderr or "").splitlines():
+        m = re.search(r"Stream #\d+:\d+.*?: (Video|Audio): (\w+)(.*)", ln)
+        if not m:
+            continue
+        rest = m.group(3)
+        if m.group(1) == "Video":
+            size = re.search(r"\b(\d{2,5})x(\d{2,5})\b", rest)
+            fps = re.search(r"([\d.]+) (?:fps|tbr)", rest)
+            info["streams"].append({"kind": "video", "codec": m.group(2),
+                                    "width": int(size.group(1)) if size else None,
+                                    "height": int(size.group(2)) if size else None,
+                                    "fps": float(fps.group(1)) if fps else None})
+        else:
+            sr = re.search(r"(\d+) Hz", rest)
+            ch = re.search(r"Hz, ([^,]+)", rest)
+            layout = ch.group(1).strip() if ch else ""
+            chans = {"mono": 1, "stereo": 2}.get(layout) or (
+                int(layout.split(".")[0]) + (1 if "." in layout else 0) if re.match(r"^\d", layout) else None)
+            info["streams"].append({"kind": "audio", "codec": m.group(2),
+                                    "sample_rate": int(sr.group(1)) if sr else None, "channels": chans})
+    return info
+
+
+def stream(info, kind):
+    """The first stream of `kind` ("video" / "audio") in a probe() / parse_ffmpeg_info() result, or None."""
+    return next((s for s in (info or {}).get("streams", []) if s.get("kind") == kind), None)
+
+
+def media_info(ffmpeg, ffprobe, path):
+    if ffprobe:
+        info = probe(ffprobe, path)
+        if info is not None:
+            return info
+    _, _, err = _run([ffmpeg, "-hide_banner", "-i", str(path)])
+    return parse_ffmpeg_info(err)
+
+
+# ------------------------------------------------------------------ commands
+
+
+def cmd_check():
+    ff, fp = find_ffmpeg()
+    if not ff:
+        out("ffmpeg not found. Install it: brew install ffmpeg (or ffmpeg-full for drawtext/libass),"
+            " or set TRAILER_FFMPEG to its path.")
+        return result(False, "no ffmpeg")
+    caps = ffmpeg_caps(ff)
+    out("ffmpeg  %s (%s)" % (ff, caps["version"]))
+    out("ffprobe %s" % (fp or "not found (probing falls back to ffmpeg -i)"))
+    out("filters  " + "  ".join("%s=%s" % (k, "yes" if v else "no") for k, v in caps["filters"].items()))
+    out("encoders " + "  ".join("%s=%s" % (k, "yes" if v else "no") for k, v in caps["encoders"].items()))
+    if not caps["filters"]["drawtext"]:
+        out("note: no drawtext/libass: make title cards as images (Unity UI screenshots) and use them as cards.")
+    if not (caps["encoders"]["libx264"] or caps["encoders"]["h264_videotoolbox"]):
+        return result(False, "ffmpeg has no H.264 encoder")
+    return result(True, "ffmpeg %s" % caps["version"])
+
+
+def cmd_probe(paths):
+    ff, fp = find_ffmpeg()
+    if not ff and not fp:
+        return result(False, "no ffmpeg")
+    bad = 0
+    for p in paths:
+        info = media_info(ff, fp, p) if ff else (probe(fp, p) or {"streams": []})
+        v, a = stream(info, "video"), stream(info, "audio")
+        if not v and not a:
+            bad += 1
+            out("%s: not a readable media file" % p)
+            continue
+        parts = ["%.2fs" % info["duration"] if info.get("duration") else "?s"]
+        if v:
+            parts.append("video %s %sx%s @ %s fps" % (v["codec"], v["width"], v["height"], v["fps"]))
+        if a:
+            parts.append("audio %s %s Hz %sch" % (a["codec"], a["sample_rate"], a["channels"]))
+        out("%s: %s" % (p, ", ".join(parts)))
+    return result(bad == 0, "%d file(s), %d unreadable" % (len(paths), bad))
+
+
+def _num(d, key, default=None, lo=None):
+    v = d.get(key, default)
+    if v is None:
+        return None
+    if isinstance(v, bool) or not isinstance(v, (int, float)):
+        raise ValueError("%s must be a number" % key)
+    if lo is not None and v < lo:
+        raise ValueError("%s must be >= %s" % (key, lo))
+    return float(v)
+
+
+def load_edit_list(path):
+    """(edit list with resolved paths and computed durations, list of problems)."""
+    base = Path(path).resolve().parent
+    try:
+        e = json.loads(Path(path).read_text())
+    except (OSError, ValueError) as ex:
+        return None, ["can't read edit list: %s" % ex]
+    errs = []
+    if not isinstance(e, dict) or not isinstance(e.get("clips"), list) or not e["clips"]:
+        return None, ["edit list needs a non-empty clips list"]
+    e.setdefault("width", 1920)
+    e.setdefault("height", 1080)
+    e.setdefault("fps", 30)
+    if not e.get("output"):
+        errs.append("output is missing")
+    else:
+        e["output"] = str((base / e["output"]).resolve())
+    for i, c in enumerate(e["clips"], 1):
+        where = "clip %d: " % i
+        try:
+            if "card" in c:
+                c["card"] = str((base / c["card"]).resolve())
+                c["length"] = _num(c, "duration", 2.0, 0.1)
+                if not Path(c["card"]).is_file():
+                    errs.append(where + "card %s not found" % c["card"])
+            else:
+                c["src"] = str((base / str(c.get("src") or "")).resolve())
+                a, b = _num(c, "in", 0, 0), _num(c, "out")
+                speed = _num(c, "speed", 1.0, 0.05)
+                if b is None or b <= a:
+                    errs.append(where + "needs out > in")
+                    continue
+                c["length"] = (b - a) / speed
+                if not Path(c["src"]).is_file():
+                    errs.append(where + "src %s not found" % c["src"])
+            for k in ("fade_in", "fade_out"):
+                if (_num(c, k, 0, 0) or 0) * 2 > c["length"] + 1e-6:
+                    errs.append(where + "%s is longer than half the clip" % k)
+        except ValueError as ex:
+            errs.append(where + str(ex))
+    for i, t in enumerate(e.get("audio") or [], 1):
+        where = "audio %d: " % i
+        t["src"] = str((base / str(t.get("src") or "")).resolve())
+        if not Path(t["src"]).is_file():
+            errs.append(where + "src %s not found" % t["src"])
+        try:
+            _num(t, "start", 0, 0), _num(t, "gain_db", 0), _num(t, "fade_in", 0, 0), _num(t, "fade_out", 0, 0)
+        except ValueError as ex:
+            errs.append(where + str(ex))
+    e["length"] = sum(c.get("length") or 0 for c in e["clips"])
+    return e, errs
+
+
+def build_command(ffmpeg, e, encoder="libx264"):
+    """The ffmpeg argv that renders edit list `e` (as load_edit_list returns it)."""
+    W, H, fps = int(e["width"]), int(e["height"]), float(e["fps"])
+    args, chains, labels = [ffmpeg, "-hide_banner", "-y"], [], []
+    n = 0
+    for i, c in enumerate(e["clips"]):
+        if "card" in c:
+            args += ["-loop", "1", "-t", "%.3f" % c["length"], "-i", c["card"]]
+            steps = []
+        else:
+            args += ["-i", c["src"]]
+            steps = ["trim=start=%.3f:end=%.3f" % (c.get("in") or 0, c["out"]),
+                     "setpts=(PTS-STARTPTS)/%s" % float(c.get("speed") or 1)]
+        steps.append("scale=%d:%d:force_original_aspect_ratio=decrease,pad=%d:%d:(ow-iw)/2:(oh-ih)/2:black,"
+                     "setsar=1,fps=%s,format=yuv420p" % (W, H, W, H, fps))
+        f = "[%d:v]" % n + ",".join(steps)
+        if c.get("fade_in"):
+            f += ",fade=t=in:st=0:d=%.3f" % c["fade_in"]
+        if c.get("fade_out"):
+            f += ",fade=t=out:st=%.3f:d=%.3f" % (c["length"] - c["fade_out"], c["fade_out"])
+        f += ",trim=duration=%.3f,setpts=PTS-STARTPTS" % c["length"]
+        chains.append(f + "[v%d]" % i)
+        labels.append("[v%d]" % i)
+        n += 1
+    vout = "".join(labels) + "concat=n=%d:v=1:a=0" % len(labels)
+    if e.get("fade_out"):
+        vout += ",fade=t=out:st=%.3f:d=%.3f" % (max(0, e["length"] - e["fade_out"]), e["fade_out"])
+    chains.append(vout + "[vout]")
+    tracks = e.get("audio") or []
+    for j, t in enumerate(tracks):
+        args += ["-i", t["src"]]
+        f = "[%d:a]aresample=48000,aformat=channel_layouts=stereo" % n
+        if t.get("gain_db"):
+            f += ",volume=%sdB" % t["gain_db"]
+        if t.get("fade_in"):
+            f += ",afade=t=in:st=0:d=%.3f" % t["fade_in"]
+        if t.get("fade_out"):  # fades out where the trailer ends (or where the track ends, if sooner)
+            end = e["length"] - float(t.get("start") or 0)
+            f += ",atrim=duration=%.3f,areverse,afade=t=in:d=%.3f,areverse" % (end, t["fade_out"])
+        if t.get("start"):
+            ms = int(round(float(t["start"]) * 1000))
+            f += ",adelay=%d|%d" % (ms, ms)
+        chains.append(f + "[a%d]" % j)
+        n += 1
+    if tracks:
+        mix = "".join("[a%d]" % j for j in range(len(tracks)))
+        mix += "amix=inputs=%d:normalize=0:dropout_transition=0," % len(tracks) if len(tracks) > 1 else "anull,"
+        mix += "atrim=duration=%.3f,apad=whole_dur=%.3f" % (e["length"], e["length"])
+        if e.get("fade_out"):
+            mix += ",afade=t=out:st=%.3f:d=%.3f" % (max(0, e["length"] - e["fade_out"]), e["fade_out"])
+        chains.append(mix + ",alimiter=limit=0.95[aout]")
+    args += ["-filter_complex", ";".join(chains), "-map", "[vout]"]
+    if tracks:
+        args += ["-map", "[aout]", "-c:a", "aac", "-b:a", "192k", "-ar", "48000"]
+    if encoder == "h264_videotoolbox":
+        args += ["-c:v", encoder, "-b:v", "16M"]
+    else:
+        args += ["-c:v", encoder, "-crf", "18", "-preset", "medium"]
+    args += ["-pix_fmt", "yuv420p", "-r", "%s" % fps, "-movflags", "+faststart",
+             "-t", "%.3f" % e["length"], e["output"]]
+    return args
+
+
+def cmd_render(path, dry_run=False):
+    ff, fp = find_ffmpeg()
+    if not ff and not dry_run:
+        return result(False, "no ffmpeg (run: trailer.py check)")
+    e, errs = load_edit_list(path)
+    if e and ff:
+        for i, c in enumerate(e["clips"], 1):  # cut points inside the footage?
+            if "src" in c and Path(c["src"]).is_file():
+                info = media_info(ff, fp, c["src"])
+                if not stream(info, "video"):
+                    errs.append("clip %d: %s has no video stream" % (i, c["src"]))
+                elif info.get("duration") and c["out"] > info["duration"] + 0.05:
+                    errs.append("clip %d: out %.2fs is past the end of %s (%.2fs)"
+                                % (i, c["out"], Path(c["src"]).name, info["duration"]))
+    for x in errs:
+        out("error: " + x)
+    if errs or not e:
+        return result(False, "%d problem(s) in %s" % (len(errs), path))
+    enc = "libx264"
+    if ff:
+        caps = ffmpeg_caps(ff)["encoders"]
+        enc = "libx264" if caps["libx264"] else "h264_videotoolbox" if caps["h264_videotoolbox"] else "libx264"
+    argv = build_command(ff or "ffmpeg", e, enc)
+    out("$ " + " ".join(_quote(a) for a in argv))
+    if dry_run:
+        return result(True, "dry run: %d clip(s), %d audio track(s), %.2fs" %
+                      (len(e["clips"]), len(e.get("audio") or []), e["length"]))
+    Path(e["output"]).parent.mkdir(parents=True, exist_ok=True)
+    code, _, err = _run(argv, timeout=3600)
+    if code != 0:
+        out("\n".join(err.strip().splitlines()[-25:]))
+        return result(False, "ffmpeg exited %d" % code)
+    out("wrote %s" % e["output"])
+    return result(True, "%s %.2fs" % (e["output"], e["length"]))
+
+
+def _quote(a):
+    return a if re.match(r"^[\w@%+=:,./-]+$", a) else "'" + a.replace("'", "'\\''") + "'"
+
+
+def main(argv):
+    if not argv or argv[0] in ("-h", "--help"):
+        out(__doc__)
+        return 0
+    cmd, rest = argv[0], argv[1:]
+    if cmd == "check":
+        return cmd_check()
+    if cmd == "probe" and rest:
+        return cmd_probe(rest)
+    if cmd == "render" and rest:
+        return cmd_render(rest[0], dry_run="--dry-run" in rest[1:])
+    out(__doc__)
+    return result(False, "usage: trailer.py check | probe FILE... | render EDIT.json [--dry-run]")
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
