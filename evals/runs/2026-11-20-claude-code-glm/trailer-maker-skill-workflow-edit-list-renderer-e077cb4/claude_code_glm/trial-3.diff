+SECTION_MS = (3000, 120_000)  # ElevenLabs bounds for one composition-plan section
+PLAN_MAX_MS = 600_000
+
+
+def composition_plan_checked(plan: Any) -> dict:
+    """A music composition plan (dict or JSON text) checked against the shape ElevenLabs takes:
+    {positive_global_styles, negative_global_styles, sections: [{section_name, positive_local_styles,
+    negative_local_styles, duration_ms, lines}]}. Missing style/lines lists default to []; durations
+    are ints in 3–120 s per section and at most 10 min in total. Raises ElevenLabsError."""
+    if isinstance(plan, str):
+        try:
+            plan = json.loads(plan)
+        except ValueError:
+            raise ElevenLabsError("composition_plan is not valid JSON.") from None
+    if not isinstance(plan, dict):
+        raise ElevenLabsError("composition_plan must be an object with a sections list.")
+
+    def strs(o: dict, key: str, where: str) -> list[str]:
+        v = o.get(key) or []
+        if not isinstance(v, list) or not all(isinstance(x, str) for x in v):
+            raise ElevenLabsError(f"composition_plan {where}{key} must be a list of strings.")
+        return v
+
+    sections = plan.get("sections")
+    if not isinstance(sections, list) or not sections:
+        raise ElevenLabsError("composition_plan needs a non-empty sections list.")
+    out_sections, total = [], 0
+    for i, sec in enumerate(sections):
+        where = f"section {i + 1} "
+        if not isinstance(sec, dict):
+            raise ElevenLabsError(f"composition_plan {where}must be an object.")
+        name = sec.get("section_name")
+        if not isinstance(name, str) or not name.strip():
+            raise ElevenLabsError(f"composition_plan {where}needs a section_name.")
+        ms = sec.get("duration_ms")
+        if isinstance(ms, bool) or not isinstance(ms, (int, float)) or not SECTION_MS[0] <= ms <= SECTION_MS[1]:
+            raise ElevenLabsError(f"composition_plan {where}({name}) duration_ms must be "
+                                  f"{SECTION_MS[0]}–{SECTION_MS[1]}.")
+        total += int(ms)
+        out_sections.append({"section_name": name, "positive_local_styles": strs(sec, "positive_local_styles", where),
+                             "negative_local_styles": strs(sec, "negative_local_styles", where),
+                             "duration_ms": int(ms), "lines": strs(sec, "lines", where)})
+    if total > PLAN_MAX_MS:
+        raise ElevenLabsError(f"composition_plan is {total / 1000:g} s long; the limit is {PLAN_MAX_MS // 1000} s.")
+    return {"positive_global_styles": strs(plan, "positive_global_styles", ""),
+            "negative_global_styles": strs(plan, "negative_global_styles", ""), "sections": out_sections}
+
+
