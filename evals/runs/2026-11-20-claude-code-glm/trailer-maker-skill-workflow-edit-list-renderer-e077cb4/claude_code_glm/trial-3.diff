new file mode 100644
index 0000000..9601a3b
--- /dev/null
+++ b/backend/gamedevworkstation/features/media_outputs.py
@@ -0,0 +1,95 @@
+"""Media outputs: index the video/audio/image files a shell command produces (an ffmpeg render, a
+trailer cut, a recorded clip) under Items, so they show up like any written artifact.
+
+Files the agent writes with write_file reach Items through changes.notify; a file ffmpeg writes
+doesn't. This post_tool observer reads the run_command output for media paths, and indexes those
+that exist inside the session's roots and were written during the current turn.
+"""
+from __future__ import annotations
+
+import re
+import time
+from pathlib import Path
+from typing import TYPE_CHECKING
+
+from fastapi import APIRouter, FastAPI
+
+from .hookbus import HookEvent, HookResult
+
+if TYPE_CHECKING:
+    from ..app import AppState
+
+MEDIA_EXT = ("mp4", "mov", "webm", "mkv", "m4v", "gif", "mp3", "wav", "m4a", "aac", "ogg", "flac", "png", "jpg",
+             "jpeg", "webp")
+MAX_PER_CALL = 8  # one command indexes at most this many files (a frame dump shouldn't flood Items)
+RECENT_S = 600.0  # with no running turn, a file counts as new if written this recently
+_EXT = "|".join(MEDIA_EXT)
+_PATH_RX = re.compile(
+    rf"""(?:"([^"\n]+?\.(?:{_EXT}))"|'([^'\n]+?\.(?:{_EXT}))'|([^\s"'`<>|=,;()\[\]]+?\.(?:{_EXT})))(?![\w.\-])""",
+    re.IGNORECASE)
+
+
+def media_paths(text: str) -> list[str]:
+    """Media file paths mentioned in `text` (quoted or bare), in order of first mention, each once."""
+    seen: dict[str, None] = {}
+    for m in _PATH_RX.finditer(text or ""):
+        p = (m.group(1) or m.group(2) or m.group(3) or "").strip()
+        if p.lower().startswith(("http://", "https://")) or "://" in p:
+            continue
+        p = p.rstrip(":")
+        if p:
+            seen.setdefault(p, None)
+    return list(seen)
+
+
+class MediaOutputs:
+    """app.extensions["media_outputs"]."""
+
+    def __init__(self, app: "AppState"):
+        self.app = app
+
+    def _indexed(self, session_id: str, path: str) -> bool:
+        return bool(self.app.items.db.one("SELECT id FROM items WHERE session_id=? AND path=? AND deleted=0 LIMIT 1",
+                                          [session_id, path]))
+
+    async def observe(self, ev: HookEvent) -> HookResult | None:
+        out = ev.output
+        if out is None or out.is_error or not ev.ctx.folder:
+            return None
+        text = "\n".join(t for t in (str((ev.args or {}).get("command") or ""), out.text or "") if t)
+        since = ev.turn.started_at if ev.turn else time.time() - RECENT_S
+        added = 0
+        for raw in media_paths(text):
+            if added >= MAX_PER_CALL:
+                break
+            p = Path(raw).expanduser()
+            if not p.is_absolute():
+                p = ev.ctx.folder / p
+            try:
+                p = p.resolve()
+                if not p.is_file() or not ev.ctx.within_roots(p) or p.stat().st_mtime < since - 1:
+                    continue
+            except OSError:
+                continue
+            if self._indexed(ev.session_id, str(p)):
+                continue
+            if self.app.items.add_file(p, source="agent", session_id=ev.session_id, provider=ev.ctx.provider,
+                                       model=ev.ctx.model, message_id=ev.ctx.message_id):
+                added += 1
+        return None
+
+
+def install(app: "AppState") -> MediaOutputs:
+    """Register the observer on an app (idempotent; tests call it on a bare AppState)."""
+    mo = app.extensions.get("media_outputs")
+    if isinstance(mo, MediaOutputs):
+        return mo
+    mo = MediaOutputs(app)
+    app.extensions["media_outputs"] = mo
+    app.hooks.register("post_tool", "media_outputs.observe", mo.observe, order=70,
+                       when=lambda ev: ev.tool == "run_command")
+    return mo
+
+
+def register(app_: FastAPI, api: APIRouter, S: "AppState") -> None:
+    install(S)
