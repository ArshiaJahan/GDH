index 0000000..091ec74
--- /dev/null
+++ b/skills/trailer-maker/scripts/render_trailer.py
@@ -0,0 +1,354 @@
+#!/usr/bin/env python3
+"""Render a trailer from an edit list (edl.json) with ffmpeg. Standard library only.
+
+    render_trailer.py check                 ffmpeg/ffprobe found? which filters/encoders?
+    render_trailer.py probe <file>...       duration, size, fps, audio of each file (JSON)
+    render_trailer.py render <edl.json> [--dry-run]
+
+The edit list (paths relative to the edl file):
+    {"output": "out/trailer.mp4", "width": 1920, "height": 1080, "fps": 30,
+     "clips": [{"src": "capture/boss.mp4", "in": 3.2, "out": 6.0, "fade_in": 0.2, "fade_out": 0.2},
+               {"card": "cards/title.png", "duration": 2.5, "fade_in": 0.3}],
+     "audio": [{"src": "audio/music.mp3", "start": 0, "volume": 0.9, "fade_out": 1.5},
+               {"src": "audio/vo_01.mp3", "start": 4.0}]}
+Clips play in order; their own audio is dropped (the mix comes from "audio"). Text belongs on cards
+rendered in Unity, so no drawtext/libass is needed.
+
+Human lines go to stdout; JSON with --json; the last line is always `RESULT: OK|FAIL <summary>`.
+Exit codes: 0 ok, 1 render/probe failure, 2 usage or input error. ffmpeg is found via
+$TRAILER_FFMPEG, then PATH, then the Homebrew prefixes (ffmpeg-full included).
+"""
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+ENV = "TRAILER_FFMPEG"
+BREW_BINS = ("/opt/homebrew/bin", "/usr/local/bin", "/opt/homebrew/opt/ffmpeg-full/bin",
+             "/usr/local/opt/ffmpeg-full/bin")
+WANT_FILTERS = ("scale", "pad", "fps", "trim", "concat", "fade", "afade", "amix", "adelay", "drawtext", "subtitles")
+WANT_ENCODERS = ("libx264", "h264_videotoolbox", "aac")
+AS_JSON = "--json" in sys.argv
+
+
+def out(*args):
+    """A human-readable line (silent with --json, where stdout is the JSON document)."""
+    if not AS_JSON:
+        print(*args)
+
+
+def result(ok, summary):
+    """Print the RESULT footer and return the exit code for it."""
+    print(f"RESULT: {'OK' if ok else 'FAIL'} {summary}", file=sys.stderr if AS_JSON else sys.stdout)
+    return 0 if ok else 1
+
+
+def find_ffmpeg():
+    """(ffmpeg, ffprobe) paths; either may be None. $TRAILER_FFMPEG may name ffmpeg or its folder."""
+    env = os.environ.get(ENV, "").strip()
+    cands = []
+    if env:
+        p = Path(env).expanduser()
+        cands.append(p / "ffmpeg" if p.is_dir() else p)
+    if w := shutil.which("ffmpeg"):
+        cands.append(Path(w))
+    cands += [Path(d) / "ffmpeg" for d in BREW_BINS]
+    for c in cands:
+        if c.is_file() and os.access(c, os.X_OK):
+            probe_bin = c.with_name("ffprobe")
+            return str(c), str(probe_bin) if probe_bin.is_file() else shutil.which("ffprobe")
+    return None, shutil.which("ffprobe")
+
+
+def ffmpeg_caps(ffmpeg):
+    """{"version", "filters": {name: bool}, "encoders": {name: bool}} for WANT_FILTERS / WANT_ENCODERS."""
+    def run(*a):
+        try:
+            return subprocess.run([ffmpeg, "-hide_banner", *a], capture_output=True, text=True, timeout=30).stdout
+        except (OSError, subprocess.SubprocessError):
+            return ""
+    ver = run("-version").splitlines()
+    filters = {m.group(1) for m in re.finditer(r"^\s*[TSC.]{2,3}\s+(\w+)\s", run("-filters"), re.M)}
+    encoders = {m.group(1) for m in re.finditer(r"^\s*[VAS][\w.]{5}\s+(\w+)\s", run("-encoders"), re.M)}
+    return {"version": ver[0] if ver else "", "filters": {f: f in filters for f in WANT_FILTERS},
+            "encoders": {e: e in encoders for e in WANT_ENCODERS}}
+
+
+def parse_ffmpeg_info(stderr):
+    """Parse `ffmpeg -i <file>` stderr (for when ffprobe is missing) into probe()'s shape."""
+    info = {"duration": None, "streams": []}
+    if m := re.search(r"Duration:\s*(\d+):(\d+):(\d+(?:\.\d+)?)", stderr):
+        h, mi, s = m.groups()
+        info["duration"] = int(h) * 3600 + int(mi) * 60 + float(s)
+    for m in re.finditer(r"Stream #\d+:\d+(?:\[\w+\])?(?:\(\w+\))?: (Video|Audio): (.*)", stderr):
+        kind, rest = m.group(1).lower(), m.group(2)
+        st = {"kind": kind, "codec": rest.split(",")[0].split()[0] if rest else ""}
+        if kind == "video":
+            if d := re.search(r"\b(\d{2,5})x(\d{2,5})\b", rest):
+                st["width"], st["height"] = int(d.group(1)), int(d.group(2))
+            if f := re.search(r"(\d+(?:\.\d+)?) fps", rest):
+                st["fps"] = float(f.group(1))
+        else:
+            if r := re.search(r"(\d+) Hz", rest):
+                st["sample_rate"] = int(r.group(1))
+            st["channels"] = 1 if "mono" in rest else 2 if "stereo" in rest else None
+        info["streams"].append(st)
+    return info
+
+
+def _rate(s):
+    try:
+        n, _, d = str(s).partition("/")
+        return round(float(n) / float(d or 1), 3) if float(d or 1) else None
+    except ValueError:
+        return None
+
+
+def probe(ffprobe, path, ffmpeg=None):
+    """{"duration", "streams": [{"kind", "codec", ...}]} of a media file, or None if unreadable.
+    Uses ffprobe; falls back to parsing `ffmpeg -i` when only ffmpeg is there."""
+    if ffprobe:
+        try:
+            p = subprocess.run([ffprobe, "-v", "error", "-show_format", "-show_streams", "-of", "json", str(path)],
+                               capture_output=True, text=True, timeout=60)
+            data = json.loads(p.stdout or "{}") if p.returncode == 0 else None
+        except (OSError, subprocess.SubprocessError, ValueError):
+            data = None
+        if data is not None:
+            streams = []
+            for s in data.get("streams", []):
+                kind = s.get("codec_type")
+                if kind == "video":
+                    streams.append({"kind": kind, "codec": s.get("codec_name", ""), "width": s.get("width"),
+                                    "height": s.get("height"), "fps": _rate(s.get("avg_frame_rate") or s.get("r_frame_rate"))})
+                elif kind == "audio":
+                    streams.append({"kind": kind, "codec": s.get("codec_name", ""), "channels": s.get("channels"),
+                                    "sample_rate": int(s["sample_rate"]) if s.get("sample_rate") else None})
+            dur = (data.get("format") or {}).get("duration")
+            return {"duration": float(dur) if dur not in (None, "N/A") else None, "streams": streams}
+    if ffmpeg:
+        try:
+            p = subprocess.run([ffmpeg, "-hide_banner", "-i", str(path)], capture_output=True, text=True, timeout=60)
+        except (OSError, subprocess.SubprocessError):
+            return None
+        info = parse_ffmpeg_info(p.stderr)
+        return info if info["streams"] else None
+    return None
+
+
+def stream(info, kind):
+    """The first stream of `kind` ("video" / "audio") in a probe() result, or None."""
+    return next((s for s in (info or {}).get("streams", []) if s.get("kind") == kind), None)
+
+
+# ------------------------------------------------------------------ edit list
+
+
+class EdlError(ValueError):
+    pass
+
+
+def _num(d, key, default=None, lo=0.0):
+    v = d.get(key, default)
+    if v is None:
+        return None
+    if isinstance(v, bool) or not isinstance(v, (int, float)) or v < lo:
+        raise EdlError(f"{key} must be a number >= {lo:g} (got {v!r})")
+    return float(v)
+
+
+def load_edl(path):
+    base = Path(path).resolve().parent
+    try:
+        edl = json.loads(Path(path).read_text(encoding="utf-8"))
+    except (OSError, ValueError) as e:
+        raise EdlError(f"cannot read edit list: {e}") from None
+    if not isinstance(edl, dict) or not isinstance(edl.get("clips"), list) or not edl["clips"]:
+        raise EdlError("edit list needs a non-empty clips list")
+    w, h, fps = int(edl.get("width", 1920)), int(edl.get("height", 1080)), _num(edl, "fps", 30, lo=1)
+    if w % 2 or h % 2:
+        raise EdlError("width and height must be even")
+    clips = []
+    for i, c in enumerate(edl["clips"]):
+        where = f"clips[{i}]"
+        if not isinstance(c, dict) or bool(c.get("src")) == bool(c.get("card")):
+            raise EdlError(f"{where}: give exactly one of src (video) or card (image)")
+        try:
+            src = (base / (c.get("src") or c["card"])).resolve()
+            if not src.is_file():
+                raise EdlError(f"missing file {src}")
+            if c.get("card"):
+                dur, t_in = _num(c, "duration", lo=0.04), 0.0
+                if dur is None:
+                    raise EdlError("a card needs duration")
+            else:
+                t_in, t_out = _num(c, "in", 0.0), _num(c, "out")
+                if t_out is None or t_out <= t_in:
+                    raise EdlError("a clip needs out > in")
+                dur = t_out - t_in
+            fi, fo = _num(c, "fade_in", 0.0), _num(c, "fade_out", 0.0)
+            if fi + fo > dur:
+                raise EdlError("fades are longer than the clip")
+        except EdlError as e:
+            raise EdlError(f"{where}: {e}") from None
+        clips.append({"src": src, "card": bool(c.get("card")), "in": t_in, "dur": dur, "fade_in": fi, "fade_out": fo})
+    audio = []
+    for i, a in enumerate(edl.get("audio") or []):
+        try:
+            src = (base / a["src"]).resolve()
+            if not src.is_file():
+                raise EdlError(f"missing file {src}")
+            audio.append({"src": src, "start": _num(a, "start", 0.0), "in": _num(a, "in", 0.0),
+                          "volume": _num(a, "volume", 1.0), "fade_in": _num(a, "fade_in", 0.0),
+                          "fade_out": _num(a, "fade_out", 0.0)})
+        except (EdlError, KeyError, TypeError) as e:
+            raise EdlError(f"audio[{i}]: {e}") from None
+    output = (base / edl.get("output", "out/trailer.mp4")).resolve()
+    return {"output": output, "width": w, "height": h, "fps": fps, "clips": clips, "audio": audio,
+            "duration": round(sum(c["dur"] for c in clips), 3), "crf": int(edl.get("crf", 18))}
+
+
+def build_command(ffmpeg, edl, encoder="libx264"):
+    """The ffmpeg argv that renders `edl` (load_edl's result)."""
+    w, h, fps, total = edl["width"], edl["height"], edl["fps"], edl["duration"]
+    args, parts, labels = [ffmpeg, "-hide_banner", "-y"], [], []
+    for i, c in enumerate(edl["clips"]):
+        if c["card"]:
+            args += ["-loop", "1", "-framerate", f"{fps:g}", "-t", f"{c['dur']:.3f}", "-i", str(c["src"])]
+        else:
+            args += ["-ss", f"{c['in']:.3f}", "-t", f"{c['dur']:.3f}", "-i", str(c["src"])]
+        f = (f"[{i}:v]scale={w}:{h}:force_original_aspect_ratio=decrease,pad={w}:{h}:(ow-iw)/2:(oh-ih)/2:black,"
+             f"setsar=1,fps={fps:g},format=yuv420p,trim=duration={c['dur']:.3f},setpts=PTS-STARTPTS")
+        if c["fade_in"]:
+            f += f",fade=t=in:st=0:d={c['fade_in']:.3f}"
+        if c["fade_out"]:
+            f += f",fade=t=out:st={c['dur'] - c['fade_out']:.3f}:d={c['fade_out']:.3f}"
+        parts.append(f + f"[v{i}]")
+        labels.append(f"[v{i}]")
+    parts.append("".join(labels) + f"concat=n={len(labels)}:v=1:a=0[vout]")
+    n = len(edl["clips"])
+    amix = []
+    for j, a in enumerate(edl["audio"]):
+        args += ["-ss", f"{a['in']:.3f}", "-i", str(a["src"])]
+        f = f"[{n + j}:a]aformat=sample_rates=48000:channel_layouts=stereo,volume={a['volume']:g}"
+        length = max(0.0, total - a["start"])
+        f += f",atrim=duration={length:.3f}"
+        if a["fade_in"]:
+            f += f",afade=t=in:st=0:d={a['fade_in']:.3f}"
+        if a["fade_out"]:
+            f += f",afade=t=out:st={max(0.0, length - a['fade_out']):.3f}:d={a['fade_out']:.3f}"
+        if a["start"]:
+            ms = int(round(a["start"] * 1000))
+            f += f",adelay={ms}|{ms}"
+        parts.append(f + f"[a{j}]")
+        amix.append(f"[a{j}]")
+    if amix:
+        parts.append("".join(amix) + f"amix=inputs={len(amix)}:normalize=0:duration=longest,"
+                     f"apad,atrim=duration={total:.3f}[aout]")
+    args += ["-filter_complex", ";".join(parts), "-map", "[vout]"]
+    if amix:
+        args += ["-map", "[aout]", "-c:a", "aac", "-b:a", "192k"]
+    vq = ["-crf", str(edl["crf"]), "-preset", "medium"] if encoder == "libx264" else ["-b:v", "12M"]
+    args += ["-c:v", encoder, *vq, "-pix_fmt", "yuv420p", "-r", f"{fps:g}", "-movflags", "+faststart",
+             "-t", f"{total:.3f}", str(edl["output"])]
+    return args
+
+
+# ------------------------------------------------------------------ commands
+
+
+def cmd_check():
+    ffmpeg, ffprobe = find_ffmpeg()
+    if not ffmpeg:
+        out("ffmpeg not found. Install it: brew install ffmpeg  (or set TRAILER_FFMPEG to its path)")
+        if AS_JSON:
+            print(json.dumps({"ffmpeg": None, "ffprobe": ffprobe}))
+        return result(False, "ffmpeg not found")
+    caps = ffmpeg_caps(ffmpeg)
+    if AS_JSON:
+        print(json.dumps({"ffmpeg": ffmpeg, "ffprobe": ffprobe, **caps}, indent=2))
+    out(f"ffmpeg: {ffmpeg}  ({caps['version']})")
+    out(f"ffprobe: {ffprobe or 'missing (falling back to ffmpeg -i)'}")
+    out("filters: " + ", ".join(f"{k}{'' if v else ' (missing)'}" for k, v in caps["filters"].items()))
+    out("encoders: " + ", ".join(f"{k}{'' if v else ' (missing)'}" for k, v in caps["encoders"].items()))
+    core = [f for f in WANT_FILTERS if f not in ("drawtext", "subtitles")]
+    missing = [f for f in core if not caps["filters"][f]]
+    if not (caps["encoders"]["libx264"] or caps["encoders"]["h264_videotoolbox"]):
+        missing.append("an H.264 encoder")
+    return result(not missing, "missing " + ", ".join(missing) if missing else "ffmpeg ready")
+
+
+def cmd_probe(paths):
+    ffmpeg, ffprobe = find_ffmpeg()
+    if not (ffmpeg or ffprobe):
+        return result(False, "ffmpeg not found")
+    report, bad = {}, 0
+    for p in paths:
+        info = probe(ffprobe, p, ffmpeg)
+        report[p] = info
+        if info is None:
+            bad += 1
+            out(f"{p}: unreadable")
+            continue
+        v, a = stream(info, "video"), stream(info, "audio")
+        dur = f"{info['duration']:.2f}s" if info["duration"] is not None else "?s"
+        vs = f"{v.get('width')}x{v.get('height')} @{v.get('fps')}fps {v.get('codec')}" if v else "no video"
+        out(f"{p}: {dur}, {vs}, {'audio ' + a.get('codec', '') if a else 'no audio'}")
+    if AS_JSON:
+        print(json.dumps(report, indent=2))
+    return result(not bad, f"{len(paths) - bad}/{len(paths)} probed")
+
+
+def cmd_render(edl_path, dry_run):
+    try:
+        edl = load_edl(edl_path)
+    except EdlError as e:
+        out(f"edit list error: {e}")
+        result(False, str(e))
+        return 2
+    ffmpeg, ffprobe = find_ffmpeg()
+    if not ffmpeg:
+        return result(False, "ffmpeg not found")
+    caps = ffmpeg_caps(ffmpeg)
+    encoder = "libx264" if caps["encoders"]["libx264"] else "h264_videotoolbox"
+    argv = build_command(ffmpeg, edl, encoder)
+    if dry_run:
+        if AS_JSON:
+            print(json.dumps({"argv": argv, "duration": edl["duration"]}, indent=2))
+        out(" ".join(argv))
+        return result(True, f"dry run, {edl['duration']:g}s, {len(edl['clips'])} clips")
+    edl["output"].parent.mkdir(parents=True, exist_ok=True)
+    p = subprocess.run(argv, capture_output=True, text=True)
+    if p.returncode != 0:
+        out(p.stderr[-4000:])
+        return result(False, f"ffmpeg exited {p.returncode}")
+    info = probe(ffprobe, edl["output"], ffmpeg)
+    got = (info or {}).get("duration")
+    ok = got is not None and abs(got - edl["duration"]) <= max(0.25, 2 / edl["fps"])
+    if AS_JSON:
+        print(json.dumps({"output": str(edl["output"]), "expected": edl["duration"], "probe": info}, indent=2))
+    out(f"wrote {edl['output']}")
+    return result(ok, f"{edl['output']} {got if got is not None else '?'}s (expected {edl['duration']:g}s)")
+
+
+def main(argv=None):
+    args = [a for a in (sys.argv[1:] if argv is None else argv) if a != "--json"]
+    if not args or args[0] in ("-h", "--help"):
+        print(__doc__)
+        return 0 if args else 2
+    cmd, rest = args[0], args[1:]
+    if cmd == "check" and not rest:
+        return cmd_check()
+    if cmd == "probe" and rest:
+        return cmd_probe(rest)
+    if cmd == "render" and rest and len([r for r in rest if r != "--dry-run"]) == 1:
+        return cmd_render(next(r for r in rest if r != "--dry-run"), "--dry-run" in rest)
+    print(__doc__, file=sys.stderr)
+    return 2
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/skills/unity-router/chains/trailer.toml b/skills/unity-router/chains/trailer.toml
new file mode 100644
index 0000000..3d7755b
--- /dev/null
+++ b/skills/unity-router/chains/trailer.toml
@@ -0,0 +1,42 @@
+# Workflow template (features/chains.py). done_when types adapted from SethGammon/Citadel (MIT).
+id = "trailer"
+title = "Trailer"
+summary = "Beat sheet → captures and cards → audio → edit list and render → pacing and technical reviews → report"
+kinds = ["chain", "campaign"]
+applies_to = "unity"
+
+[[phase]]
+name = "Beats"
+type = "research"
+skills = ["trailer-maker"]
+instructions = "Write Trailer/<date>/BEATS.md (trailer-maker step 1) and get the user's approval."
+done_when = [{ type = "file_exists", path = "Trailer/*/BEATS.md", newer_than = "phase_start" }, { type = "manual" }]
+
+[[phase]]
+name = "Capture"
+type = "build"
+skills = ["trailer-maker", "play-verify"]
+instructions = "Record one clip per shot and render the cards (trailer-maker steps 2-3)."
+done_when = [{ type = "file_exists", path = "Trailer/*/capture/*.mp4", newer_than = "phase_start" }]
+
+[[phase]]
+name = "Audio"
+type = "build"
+skills = ["trailer-maker"]
+instructions = "Music with a composition_plan matching the beats, VO and SFX (trailer-maker step 4)."
+done_when = [{ type = "file_exists", path = "Trailer/*/audio/sources.json", newer_than = "phase_start" }]
+
+[[phase]]
+name = "Render"
+type = "build"
+skills = ["trailer-maker"]
+instructions = "Write edl.json and render it (trailer-maker steps 5-6)."
+done_when = [{ type = "file_exists", path = "Trailer/*/out/*.mp4", newer_than = "phase_start" }]
+
+[[phase]]
+name = "Review"
+type = "verify"
+skills = ["trailer-maker"]
+critique = true
+instructions = "Run both reviewers from references/reviewers.md, fix edl.json, render again (trailer-maker step 7)."
+done_when = [{ type = "file_exists", path = "Trailer/*/REPORT.md", newer_than = "phase_start" }]
