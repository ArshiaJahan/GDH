@@ -0,0 +1,42 @@
+# Workflow template (features/chains.py). done_when types adapted from SethGammon/Citadel (MIT).
+id = "trailer"
+title = "Trailer"
+summary = "Beat sheet → capture clips and cards → audio bed → edit list and render → three-reviewer review → report"
+kinds = ["chain", "campaign"]
+applies_to = "unity"
+critique = false
+
+[[phase]]
+name = "Beats"
+type = "plan"
+skills = ["trailer-maker"]
+instructions = "Write Trailer/<name>/BEATS.md (trailer-maker step 1) and get the user's approval."
+done_when = [{ type = "file_exists", path = "Trailer/*/BEATS.md", newer_than = "phase_start" }, { type = "manual", question = "Is the beat sheet approved?" }]
+
+[[phase]]
+name = "Capture"
+type = "build"
+skills = ["trailer-maker", "play-verify"]
+instructions = "Record every beat's clip to Trailer/<name>/clips/ and the title and end cards to cards/."
+done_when = [{ type = "file_exists", path = "Trailer/*/clips/*.mp4", newer_than = "phase_start" }]
+
+[[phase]]
+name = "Audio"
+type = "build"
+skills = ["trailer-maker"]
+instructions = "Build the audio bed (references/audio.md); reuse items instead of regenerating."
+done_when = [{ type = "file_exists", path = "Trailer/*/audio/sources.json", newer_than = "phase_start" }]
+
+[[phase]]
+name = "Render"
+type = "build"
+skills = ["trailer-maker"]
+instructions = "Write edit.json, then render_edit.py check and render it."
+done_when = [{ type = "command_passes", observe = "render_edit" }, { type = "file_exists", path = "Trailer/*/out/*.mp4", newer_than = "phase_start" }]
+
+[[phase]]
+name = "Review"
+type = "verify"
+skills = ["trailer-maker"]
+instructions = "Run the three reviewers (references/reviewers.md); fix and re-render until none scores below 3."
+done_when = [{ type = "file_exists", path = "Trailer/*/REPORT.md", newer_than = "phase_start" }, { type = "manual", question = "Watch out/trailer.mp4: ship it?" }]
