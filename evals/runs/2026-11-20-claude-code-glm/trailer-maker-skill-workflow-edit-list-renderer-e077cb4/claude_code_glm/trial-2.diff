@@ -0,0 +1,280 @@
+#!/usr/bin/env python3
+"""Render a trailer from an edit list (JSON) with ffmpeg: clips and stills cut, scaled and
+concatenated, the audio bed (music, VO, SFX) placed on the timeline and mixed.
+
+Usage:
+  render_edit.py caps                       which ffmpeg is used and what it can do
+  render_edit.py check EDIT                 validate the edit list and probe every source
+  render_edit.py render EDIT [--dry-run]    render (--dry-run prints the ffmpeg command only)
+
+Edit list (paths relative to the edit file's folder):
+  {"output": "out/trailer.mp4", "width": 1920, "height": 1080, "fps": 30,
+   "clips": [{"src": "clips/boss.mp4", "in": 2.0, "out": 5.5, "fade_in": 0.2, "fade_out": 0.2},
+             {"src": "cards/title.png", "duration": 2.5}],
+   "audio": [{"src": "audio/music.mp3", "start": 0, "gain_db": -2, "fade_out": 1.5},
+             {"src": "audio/vo_01.mp3", "start": 3.2}]}
+Clip audio is not used: game audio is recorded separately and placed in "audio" like the rest.
+
+ffmpeg: $TRAILER_FFMPEG, else Homebrew's ffmpeg-full, else ffmpeg on PATH (ffprobe next to it).
+The last stdout line is RESULT: OK … or RESULT: FAIL … (details as JSON just above it). Exit: 0 ok, 1 failed, 2 usage.
+Python 3.9+ stdlib only.
+"""
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+IMAGE_EXTS = {".png", ".jpg", ".jpeg", ".webp", ".bmp"}
+FULL_FFMPEG = ("/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg", "/usr/local/opt/ffmpeg-full/bin/ffmpeg")
+
+
+def out(*args):
+    print(*args, flush=True)
+
+
+def result(ok, summary, **extra):
+    """The machine-readable last line (RESULT: OK … / RESULT: FAIL …, which the quality ladder and
+    workflows observe); details go on the line before it as JSON."""
+    if extra:
+        out(json.dumps(extra))
+    out(f"RESULT: {'OK' if ok else 'FAIL'} {summary}")
+    return 0 if ok else 1
+
+
+def find_ffmpeg():
+    """(ffmpeg, ffprobe or None), or (None, None) when there is no ffmpeg."""
+    env = os.environ.get("TRAILER_FFMPEG")
+    cands = [env] if env else []
+    cands += [p for p in FULL_FFMPEG if Path(p).is_file()]
+    if w := shutil.which("ffmpeg"):
+        cands.append(w)
+    for c in cands:
+        if c and Path(c).is_file() and os.access(c, os.X_OK):
+            probe_ = Path(c).with_name("ffprobe" + Path(c).suffix)
+            return c, (str(probe_) if probe_.is_file() else shutil.which("ffprobe"))
+    return None, None
+
+
+def ffmpeg_caps(ffmpeg):
+    """What this ffmpeg build has that the trailer needs (or could use)."""
+    def listing(flag):
+        try:
+            return subprocess.run([ffmpeg, "-hide_banner", flag], capture_output=True, text=True, timeout=30).stdout
+        except (OSError, subprocess.SubprocessError):
+            return ""
+    filters, encoders = listing("-filters"), listing("-encoders")
+
+    def has(text, name):
+        return re.search(rf"^\s*\S+\s+{re.escape(name)}\s", text, re.M) is not None
+    return {"drawtext": has(filters, "drawtext"), "subtitles": has(filters, "subtitles"),
+            "loudnorm": has(filters, "loudnorm"), "libx264": has(encoders, "libx264"), "aac": has(encoders, "aac")}
+
+
+def parse_ffmpeg_info(stderr):
+    """{"duration", "streams"} from `ffmpeg -i FILE` stderr (when there's no ffprobe)."""
+    info = {"duration": None, "streams": []}
+    if m := re.search(r"Duration:\s*(\d+):(\d+):(\d+(?:\.\d+)?)", stderr or ""):
+        info["duration"] = int(m.group(1)) * 3600 + int(m.group(2)) * 60 + float(m.group(3))
+    for m in re.finditer(r"Stream #\d+:\d+[^:]*:\s*(Video|Audio):\s*([^\s,]+)([^\n]*)", stderr or ""):
+        kind, codec, rest = m.group(1).lower(), m.group(2), m.group(3)
+        s = {"codec_type": kind, "codec_name": codec}
+        if kind == "video":
+            if d := re.search(r"\b(\d{2,5})x(\d{2,5})\b", rest):
+                s["width"], s["height"] = int(d.group(1)), int(d.group(2))
+            if f := re.search(r"([\d.]+)\s*fps", rest):
+                s["fps"] = float(f.group(1))
+        elif hz := re.search(r"(\d+)\s*Hz", rest):
+            s["sample_rate"] = int(hz.group(1))
+        info["streams"].append(s)
+    return info
+
+
+def probe(ffprobe, path, ffmpeg=None):
+    """{"duration", "streams"} of a media file, or None when it can't be read."""
+    if ffprobe:
+        try:
+            r = subprocess.run([ffprobe, "-v", "error", "-show_format", "-show_streams", "-of", "json", str(path)],
+                               capture_output=True, text=True, timeout=60)
+            if r.returncode == 0:
+                d = json.loads(r.stdout or "{}")
+                dur = (d.get("format") or {}).get("duration")
+                streams = []
+                for s in d.get("streams") or []:
+                    x = {k: s[k] for k in ("codec_type", "codec_name", "width", "height", "sample_rate") if k in s}
+                    if "sample_rate" in x:
+                        x["sample_rate"] = int(x["sample_rate"])
+                    if (fr := s.get("avg_frame_rate")) and "/" in fr and not fr.endswith("/0"):
+                        n, dd = fr.split("/")
+                        x["fps"] = round(float(n) / float(dd), 3)
+                    streams.append(x)
+                return {"duration": float(dur) if dur else None, "streams": streams}
+        except (OSError, subprocess.SubprocessError, ValueError):
+            pass
+    if ffmpeg:
+        try:
+            r = subprocess.run([ffmpeg, "-hide_banner", "-i", str(path)], capture_output=True, text=True, timeout=60)
+        except (OSError, subprocess.SubprocessError):
+            return None
+        info = parse_ffmpeg_info(r.stderr)
+        return info if info["streams"] else None
+    return None
+
+
+def stream(info, kind):
+    """The first stream of `kind` ("video" / "audio") in probe() output, or None."""
+    return next((s for s in (info or {}).get("streams") or [] if s.get("codec_type") == kind), None)
+
+
+def num(v, name, errors, default=None, low=None):
+    if v is None:
+        return default
+    if isinstance(v, bool) or not isinstance(v, (int, float)):
+        errors.append(f"{name} must be a number")
+        return default
+    if low is not None and v < low:
+        errors.append(f"{name} must be >= {low}")
+    return float(v)
+
+
+def load_edit(path, ffmpeg, ffprobe):
+    """(plan, errors): the edit list with resolved paths and clip lengths."""
+    errors = []
+    try:
+        edit = json.loads(Path(path).read_text())
+    except (OSError, ValueError) as e:
+        return None, [f"can't read the edit list: {e}"]
+    base = Path(path).resolve().parent
+    plan = {"output": str(base / (edit.get("output") or "out/trailer.mp4")),
+            "width": int(edit.get("width") or 1920), "height": int(edit.get("height") or 1080),
+            "fps": float(edit.get("fps") or 30), "clips": [], "audio": []}
+    if not edit.get("clips"):
+        errors.append("clips: at least one clip is needed")
+    for i, c in enumerate(edit.get("clips") or []):
+        where = f"clips[{i}]"
+        src = base / str(c.get("src") or "")
+        if not c.get("src") or not src.is_file():
+            errors.append(f"{where}: no file {c.get('src')!r}")
+            continue
+        still = src.suffix.lower() in IMAGE_EXTS
+        info = None if still else probe(ffprobe, src, ffmpeg)
+        if not still and not stream(info, "video"):
+            errors.append(f"{where}: {src.name} has no video stream")
+            continue
+        t_in = num(c.get("in"), f"{where}.in", errors, 0.0, 0)
+        if still:
+            length = num(c.get("duration"), f"{where}.duration", errors, 3.0, 0.1)
+        else:
+            src_dur = info.get("duration") or 0
+            t_out = num(c.get("out"), f"{where}.out", errors, src_dur)
+            if src_dur and t_out > src_dur + 0.05:
+                errors.append(f"{where}: out {t_out:g}s is past the end of {src.name} ({src_dur:.2f}s)")
+            length = t_out - t_in
+            if length <= 0:
+                errors.append(f"{where}: out must be after in")
+        plan["clips"].append({"src": str(src), "still": still, "in": t_in, "length": length,
+                              "fade_in": num(c.get("fade_in"), f"{where}.fade_in", errors, 0.0, 0),
+                              "fade_out": num(c.get("fade_out"), f"{where}.fade_out", errors, 0.0, 0)})
+    for i, a in enumerate(edit.get("audio") or []):
+        where = f"audio[{i}]"
+        src = base / str(a.get("src") or "")
+        if not a.get("src") or not src.is_file():
+            errors.append(f"{where}: no file {a.get('src')!r}")
+            continue
+        if not stream(probe(ffprobe, src, ffmpeg), "audio"):
+            errors.append(f"{where}: {src.name} has no audio stream")
+            continue
+        plan["audio"].append({"src": str(src), "start": num(a.get("start"), f"{where}.start", errors, 0.0, 0),
+                              "gain_db": num(a.get("gain_db"), f"{where}.gain_db", errors, 0.0),
+                              "fade_in": num(a.get("fade_in"), f"{where}.fade_in", errors, 0.0, 0),
+                              "fade_out": num(a.get("fade_out"), f"{where}.fade_out", errors, 0.0, 0)})
+    plan["duration"] = round(sum(c["length"] for c in plan["clips"]), 3)
+    return plan, errors
+
+
+def build_command(ffmpeg, plan):
+    w, h, fps = plan["width"], plan["height"], plan["fps"]
+    args, parts, labels = [ffmpeg, "-hide_banner", "-y"], [], []
+    for i, c in enumerate(plan["clips"]):
+        if c["still"]:
+            args += ["-loop", "1", "-t", f"{c['length']:.3f}", "-i", c["src"]]
+            chain = f"[{i}:v]"
+        else:
+            args += ["-ss", f"{c['in']:.3f}", "-t", f"{c['length']:.3f}", "-i", c["src"]]
+            chain = f"[{i}:v]"
+        f = (f"{chain}fps={fps:g},scale={w}:{h}:force_original_aspect_ratio=decrease,"
+             f"pad={w}:{h}:(ow-iw)/2:(oh-ih)/2:color=black,setsar=1,format=yuv420p,setpts=PTS-STARTPTS")
+        if c["fade_in"]:
+            f += f",fade=t=in:st=0:d={c['fade_in']:.3f}"
+        if c["fade_out"]:
+            f += f",fade=t=out:st={max(0.0, c['length'] - c['fade_out']):.3f}:d={c['fade_out']:.3f}"
+        parts.append(f + f"[v{i}]")
+        labels.append(f"[v{i}]")
+    parts.append("".join(labels) + f"concat=n={len(labels)}:v=1:a=0[vout]")
+    n = len(plan["clips"])
+    alabels = []
+    for j, a in enumerate(plan["audio"]):
+        args += ["-i", a["src"]]
+        ms = int(round(a["start"] * 1000))
+        f = f"[{n + j}:a]aresample=48000,aformat=channel_layouts=stereo,volume={a['gain_db']:g}dB"
+        if a["fade_in"]:
+            f += f",afade=t=in:st=0:d={a['fade_in']:.3f}"
+        if a["fade_out"]:
+            # Fade at the trailer's end, or at the source's own end when that comes first.
+            end = plan["duration"] - a["start"]
+            f += f",atrim=0:{end:.3f},afade=t=out:st={max(0.0, end - a['fade_out']):.3f}:d={a['fade_out']:.3f}"
+        parts.append(f + f",adelay={ms}|{ms}[a{j}]")
+        alabels.append(f"[a{j}]")
+    maps = ["-map", "[vout]"]
+    if alabels:
+        parts.append("".join(alabels) + f"amix=inputs={len(alabels)}:normalize=0:duration=longest,"
+                                        f"atrim=0:{plan['duration']:.3f},alimiter=limit=0.95[aout]")
+        maps += ["-map", "[aout]", "-c:a", "aac", "-b:a", "256k"]
+    args += ["-filter_complex", ";".join(parts), *maps, "-c:v", "libx264", "-preset", "medium", "-crf", "18",
+             "-pix_fmt", "yuv420p", "-r", f"{fps:g}", "-t", f"{plan['duration']:.3f}", "-movflags", "+faststart",
+             plan["output"]]
+    return args
+
+
+def main(argv):
+    if not argv or argv[0] not in ("caps", "check", "render") or (argv[0] != "caps" and len(argv) < 2):
+        out(__doc__)
+        return 2
+    ffmpeg, ffprobe = find_ffmpeg()
+    if not ffmpeg:
+        return result(False, "No ffmpeg: `brew install ffmpeg` (or set TRAILER_FFMPEG to one).")
+    if argv[0] == "caps":
+        caps = ffmpeg_caps(ffmpeg)
+        missing = [k for k in ("libx264", "aac") if not caps[k]]
+        return result(not missing, f"{ffmpeg}" + (f" lacks {', '.join(missing)}" if missing else " can render"),
+                      ffmpeg=ffmpeg, ffprobe=ffprobe, caps=caps)
+    plan, errors = load_edit(argv[1], ffmpeg, ffprobe)
+    if errors:
+        for e in errors:
+            out(f"- {e}")
+        return result(False, f"{len(errors)} problem(s) in the edit list", errors=errors)
+    if argv[0] == "check":
+        for c in plan["clips"]:
+            out(f"{Path(c['src']).name}: {c['length']:.2f}s" + (" (still)" if c["still"] else f" from {c['in']:g}s"))
+        return result(True, f"{len(plan['clips'])} clips, {len(plan['audio'])} audio items, "
+                            f"{plan['duration']:.2f}s", duration=plan["duration"])
+    cmd = build_command(ffmpeg, plan)
+    if "--dry-run" in argv:
+        out(" ".join(json.dumps(a) if re.search(r"[\s;|\[\]]", a) else a for a in cmd))
+        return result(True, "dry run: nothing rendered", duration=plan["duration"])
+    Path(plan["output"]).parent.mkdir(parents=True, exist_ok=True)
+    r = subprocess.run(cmd, capture_output=True, text=True)
+    if r.returncode != 0:
+        out(r.stderr[-4000:])
+        return result(False, f"ffmpeg failed (exit {r.returncode})")
+    got = probe(ffprobe, plan["output"], ffmpeg)
+    dur = (got or {}).get("duration")
+    ok = bool(stream(got, "video")) and dur is not None and abs(dur - plan["duration"]) < 0.5
+    return result(ok, f"Rendered {plan['output']} ({dur or 0:.2f}s of {plan['duration']:.2f}s planned)",
+                  output=plan["output"], duration=dur)
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
