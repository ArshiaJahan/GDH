new file mode 100644
index 0000000..8eb6827
--- /dev/null
+++ b/backend/gamedevworkstation/features/media_outputs.py
@@ -0,0 +1,130 @@
+"""Media outputs: video, audio and image files a command writes (a trailer render, a capture, an
+ffmpeg mix) become items, so they show in the session's files and can be played from the chat.
+
+A post_tool observer on `run_command`: paths in the command and its output with a media extension
+that exist in the session folder and changed since the command started are indexed once per
+version (path + mtime + size), and the tool result gets their item ids.
+"""
+from __future__ import annotations
+
+import mimetypes
+import re
+import time
+from pathlib import Path
+from typing import TYPE_CHECKING
+
+from fastapi import APIRouter, FastAPI
+
+from .hookbus import HookEvent, HookResult
+
+if TYPE_CHECKING:
+    from ..app import AppState
+
+MEDIA_EXTS = {
+    ".mp4": "video", ".mov": "video", ".webm": "video", ".mkv": "video", ".gif": "image",
+    ".wav": "audio", ".mp3": "audio", ".m4a": "audio", ".ogg": "audio", ".flac": "audio", ".aac": "audio",
+    ".png": "image", ".jpg": "image", ".jpeg": "image", ".webp": "image",
+}
+MAX_PER_CALL = 12  # files indexed per command (a frame dump shouldn't flood the files list)
+_EXT = "|".join(sorted((e[1:] for e in MEDIA_EXTS), key=len, reverse=True))
+# A quoted path (spaces allowed), or a bare one without spaces / quotes / shell punctuation.
+_PATH = re.compile(rf"""["']([^"'\n]+?\.(?:{_EXT}))["']|((?:~|\.{{1,2}})?[^\s"'`<>|;&()=,]*\.(?:{_EXT}))(?![\w.])""",
+                   re.I)
+
+
+def media_paths(text: str) -> list[str]:
+    """Media file paths named in `text`, in order of first mention, without duplicates. URLs and
+    ffmpeg pattern names (frame_%04d.png) are left out."""
+    out: list[str] = []
+    for m in _PATH.finditer(text or ""):
+        p = (m.group(1) or m.group(2) or "").strip()
+        start = m.start(1) if m.group(1) else m.start(2)
+        if not p or "%" in p or "*" in p or "://" in p or (text[max(0, start - 3):start] == "://"):
+            continue
+        if re.match(r"^[a-z][a-z0-9+.-]*:", p, re.I) and not re.match(r"^[a-z]:[\\/]", p, re.I):
+            continue  # scheme:… (data:, file:, http:) but not a Windows drive
+        if p not in out:
+            out.append(p)
+    return out
+
+
+class MediaOutputs:
+    def __init__(self, app: "AppState"):
+        self.app = app
+        self._seen: dict[str, tuple[float, int]] = {}  # resolved path → (mtime, size) indexed
+        self._started: dict[int, float] = {}  # id(args) of a running command → when it started
+
+    def started(self, ev: HookEvent) -> None:
+        """pre_tool: note the start, so files the command only reads (older) aren't indexed."""
+        if len(self._started) > 256:  # calls that never got a post_tool (denied, crashed)
+            self._started.clear()
+        self._started[id(ev.args)] = time.time()
+
+    def _candidates(self, ev: HookEvent) -> list[Path]:
+        folder = ev.ctx.folder
+        if folder is None:
+            return []
+        text = "\n".join(str(v) for v in (ev.args or {}).values() if isinstance(v, str))
+        text += "\n" + (ev.output.text if ev.output is not None else "")
+        cwd = folder
+        if isinstance((ev.args or {}).get("cwd"), str):
+            cwd = (folder / ev.args["cwd"]).resolve()
+        root = folder.resolve()
+        out: list[Path] = []
+        for raw in media_paths(text):
+            p = Path(raw).expanduser()
+            p = (p if p.is_absolute() else cwd / p).resolve()
+            if p.suffix.lower() not in MEDIA_EXTS or p in out:
+                continue
+            if p != root and root not in p.parents:  # only the session's own files
+                continue
+            if p.is_file():
+                out.append(p)
+        return out
+
+    async def observe(self, ev: HookEvent) -> HookResult | None:
+        if ev.output is None or ev.output.is_error:
+            return None
+        started = self._started.pop(id(ev.args), 0.0)
+        ids, names = [], []
+        for p in self._candidates(ev):
+            if len(ids) >= MAX_PER_CALL:
+                break
+            st = p.stat()
+            if started and st.st_mtime < started - 2:
+                continue  # named but not written by this command (an input, an old render)
+            key = str(p)
+            if self._seen.get(key) == (st.st_mtime, st.st_size):
+                continue
+            kind = MEDIA_EXTS[p.suffix.lower()]
+            iid = self.app.items.add(kind="media", subtype=kind, source="tool", session_id=ev.ctx.session_id,
+                                     message_id=ev.ctx.message_id, title=p.name, path=key, size=st.st_size,
+                                     mime=mimetypes.guess_type(p.name)[0] or f"{kind}/*",
+                                     meta={"from": "run_command", "indexed_at": time.time()})
+            if not iid:
+                continue
+            self._seen[key] = (st.st_mtime, st.st_size)
+            ids.append(iid)
+            names.append(f"{p.name} ({iid})")
+        if not ids:
+            return None
+        ev.output.items.extend(i for i in ids if i not in ev.output.items)
+        return HookResult(action="note", hook="media_outputs", note="Media files saved as items: " + ", ".join(names))
+
+
+def install(app: "AppState") -> MediaOutputs:
+    """Register the observer (idempotent). register() calls this; tests call it on a bare AppState."""
+    mo = app.extensions.get("media_outputs")
+    if isinstance(mo, MediaOutputs):
+        return mo
+    mo = MediaOutputs(app)
+    app.extensions["media_outputs"] = mo
+    app.hooks.register("pre_tool", "media_outputs.started", mo.started, order=900,
+                       when=lambda ev: ev.tool == "run_command")
+    app.hooks.register("post_tool", "media_outputs.observe", mo.observe, order=80,
+                       when=lambda ev: ev.tool == "run_command")
+    return mo
+
+
+def register(app_: FastAPI, api: APIRouter, S: "AppState") -> None:
+    install(S)
