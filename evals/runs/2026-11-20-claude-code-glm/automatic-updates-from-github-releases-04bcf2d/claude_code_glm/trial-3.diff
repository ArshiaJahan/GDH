+    assert calls == ["https://api.github.com/repos/o/r/releases/latest"]
+    assert rel["version"] == "2.0.0" and rel["notes"] == "What's new"
+    assert rel["assets"]["a.zip"] == {"url": "https://dl/a.zip", "size": 1}
+    assert U.latest_release("o/r", _fake_github("2.0.0", {}, draft=True)[0]) is None
+    assert U.latest_release("o/r", _fake_github("2.0.0", {}, prerelease=True)[0]) is None
+    assert U.latest_release("not a repo", fetch) is None
+
+    def offline(url: str) -> bytes:
