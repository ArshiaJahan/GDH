+# ------------------------------------------------------------------ Windows
+# A Windows release is an NSIS installer (`<dir>/<version>/<installer>.exe`, release.json
+# "installer"). Installing hands over to a PowerShell helper that stops the app, runs the
+# installer silently and starts the app again.
+
+CREATE_BREAKAWAY_FROM_JOB = 0x01000000
+
+
+def process_exe(pid: int) -> Path | None:
+    """Full path of a running process's executable (Windows), or None."""
+    if os.name != "nt":
+        return None
+    import ctypes
+    from ctypes import wintypes
+
+    k32 = ctypes.windll.kernel32  # type: ignore[attr-defined]
+    h = k32.OpenProcess(0x1000, False, int(pid))  # PROCESS_QUERY_LIMITED_INFORMATION
+    if not h:
+        return None
+    try:
+        buf = ctypes.create_unicode_buffer(32768)
+        n = wintypes.DWORD(len(buf))
+        if not k32.QueryFullProcessImageNameW(h, 0, buf, ctypes.byref(n)):
+            return None
+        return Path(buf.value)
+    finally:
+        k32.CloseHandle(h)
+
+
+def _ps_quote(s: str) -> str:
+    return "'" + str(s).replace("'", "''") + "'"
+
+
+def windows_helper_script(*, app_pid: int, backend_pid: int, installer: Path, app_exe: Path | None) -> str:
+    """The stop-install-restart script. Values are baked in; timings can be shortened via env
+    (WS_START_DELAY, WS_QUIT_TIMEOUT, WS_BACKEND_WAIT, WS_INSTALL_TIMEOUT)."""
+    exe = _ps_quote(str(app_exe)) if app_exe else "$null"
+    return f"""# GameDevWorkstation update helper (generated by the backend). Runs detached from the app.
+$ErrorActionPreference = 'Continue'
+$AppPid = {int(app_pid)}
+$BackendPid = {int(backend_pid)}
+$Installer = {_ps_quote(str(installer))}
+$AppExe = {exe}
+function Env-Int($name, $default) {{ $v = [Environment]::GetEnvironmentVariable($name); if ($v) {{ [int]$v }} else {{ $default }} }}
+function Log($msg) {{ Write-Output ("{{0}} {{1}}" -f (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'), $msg) }}
+function Alive($id) {{ $id -gt 0 -and (Get-Process -Id $id -ErrorAction SilentlyContinue) }}
+function Wait-Exit($id, $seconds) {{
+  $i = 0
+  while ((Alive $id) -and $i -lt ($seconds * 10)) {{ Start-Sleep -Milliseconds 100; $i++ }}
+  -not (Alive $id)
+}}
+function Start-App {{
+  if ($AppExe -and (Test-Path -LiteralPath $AppExe)) {{ Start-Process -FilePath $AppExe }}
+  else {{ Log "ERROR: couldn't find the app to start ($AppExe)" }}
+}}
+
+Log "update: $Installer (app pid $AppPid)"
+if (-not (Test-Path -LiteralPath $Installer)) {{ Log "ERROR: the installer is missing; nothing changed"; exit 1 }}
+Start-Sleep -Seconds (Env-Int 'WS_START_DELAY' 1)  # let the backend answer the request first
+
+# 1. Stop the app: ask its window to close, then force it. The backend exits with the app.
+if (Alive $AppPid) {{
+  Log "asking the app to quit"
+  $p = Get-Process -Id $AppPid -ErrorAction SilentlyContinue
+  if ($p) {{ [void]$p.CloseMainWindow() }}
+  if (-not (Wait-Exit $AppPid (Env-Int 'WS_QUIT_TIMEOUT' 15))) {{
+    Log "still running; stopping it"; Stop-Process -Id $AppPid -Force -ErrorAction SilentlyContinue
+    [void](Wait-Exit $AppPid 5)
+  }}
+}}
+if (-not (Wait-Exit $BackendPid (Env-Int 'WS_BACKEND_WAIT' 15))) {{
+  Log "the old backend (pid $BackendPid) is still running; stopping it"
+  Stop-Process -Id $BackendPid -Force -ErrorAction SilentlyContinue
+  [void](Wait-Exit $BackendPid 5)
+}}
+
+# 2. Install silently (NSIS /S). The installer replaces the app in place.
+Log "running the installer"
+$code = 1
+try {{
+  $inst = Start-Process -FilePath $Installer -ArgumentList '/S' -PassThru
+  if ($inst.WaitForExit((Env-Int 'WS_INSTALL_TIMEOUT' 600) * 1000)) {{ $code = $inst.ExitCode }}
+  else {{ Log "ERROR: the installer didn't finish in time" }}
+}} catch {{ Log "ERROR: couldn't run the installer: $_" }}
+if ($code -eq 0) {{ Log "installed; starting the app" }} else {{ Log "ERROR: the installer failed (exit $code); starting the app" }}
+
+# 3. Start the app again, updated or not.
+Start-App
+if ($code -eq 0) {{ exit 0 }} else {{ exit 1 }}
+"""
+
+
+def launch_windows_helper(script: str, log_path: Path) -> int:
+    """Start the helper detached (own process group, outside the app's job if allowed), so stopping
+    the app doesn't stop it."""
+    d = data_dir() / "updates-tmp"
+    d.mkdir(parents=True, exist_ok=True)
+    path = d / f"install-{int(time.time())}.ps1"
+    path.write_text(script, encoding="utf-8-sig")
+    log_path.parent.mkdir(parents=True, exist_ok=True)
+    argv = ["powershell.exe", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", str(path)]
+    flags = subprocess.CREATE_NEW_PROCESS_GROUP | subprocess.CREATE_NO_WINDOW  # type: ignore[attr-defined]
+    with log_path.open("a") as out:
+        for extra in (CREATE_BREAKAWAY_FROM_JOB, 0):  # breakaway fails if the job doesn't allow it
+            try:
+                p = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT,
+                                     creationflags=flags | extra, close_fds=True, env=_clean_env())
+                return p.pid
+            except OSError:
+                if not extra:
+                    raise
+    raise OSError("couldn't start the update helper")
+
+
+# ------------------------------------------------------------- GitHub Releases
+# Builds made by .github/workflows/release.yml carry the "github" channel (buildinfo). They look
+# at the repo's latest release now and then, download the asset for their platform into the
+# updates folder and publish it there like `make release` does; the folder updater takes it from
+# there. Local builds never call GitHub.
+
+GITHUB_API = "https://api.github.com"
+GITHUB_INTERVAL_S = 6 * 3600
+Fetch = Callable[[str], bytes]
+
+
+def asset_name(version: str, platform: str | None = None) -> str | None:
+    """The release asset this platform installs, or None where there's none."""
+    platform = platform or sys.platform
+    v = str(version).removeprefix("v")
+    if platform == "darwin":
+        return f"GameDevWorkstation-{v}-macos-arm64.zip"
+    if platform in ("win32", "windows"):
+        return f"GameDevWorkstation-{v}-x64-setup.exe"
+    return None
+
+
+def _http_get(url: str) -> bytes:
+    req = urllib.request.Request(url, headers={"Accept": "application/vnd.github+json" if "api.github.com" in url
+                                               else "application/octet-stream",
+                                               "User-Agent": f"GameDevWorkstation/{__version__}"})
+    with urllib.request.urlopen(req, timeout=60) as r:  # noqa: S310 — fixed https URLs
+        return r.read()
+
+
+def latest_release(repo: str, fetch: Fetch = _http_get) -> dict | None:
+    """The repo's latest published release: {version, tag, notes, published_at, url, assets:
+    {name: {url, size}}}, or None (no release, a draft or pre-release, not a version, or offline)."""
+    if not re.fullmatch(r"[\w.-]+/[\w.-]+", repo or ""):
+        return None
+    try:
+        data = json.loads(fetch(f"{GITHUB_API}/repos/{repo}/releases/latest"))
+    except (OSError, ValueError) as e:
+        log.info("couldn't check GitHub releases of %s: %s", repo, e)
+        return None
+    if not isinstance(data, dict) or data.get("draft") or data.get("prerelease"):
+        return None
+    tag = str(data.get("tag_name") or "")
+    if parse_version(tag) is None:
+        return None
+    assets = {}
+    for a in data.get("assets") or []:
+        if isinstance(a, dict) and a.get("name") and a.get("browser_download_url"):
+            assets[str(a["name"])] = {"url": str(a["browser_download_url"]),
+                                      "size": a.get("size") if isinstance(a.get("size"), int) else None}
+    return {"version": tag.removeprefix("v"), "tag": tag, "notes": str(data.get("body") or ""),
+            "published_at": data.get("published_at"), "url": data.get("html_url"), "assets": assets}
+
+
+def download(url: str, dest: Path, size: int | None, fetch: Fetch = _http_get) -> Path:
+    """Fetch `url` to `dest` (via a temp file, so `dest` is whole or absent). Raises ValueError
+    when the size doesn't match what the release said."""
+    data = fetch(url)
+    if size is not None and len(data) != size:
+        raise ValueError(f"{url} gave {len(data)} bytes, expected {size}")
+    dest.parent.mkdir(parents=True, exist_ok=True)
+    tmp = dest.with_name(f".{dest.name}.download")
+    try:
+        tmp.write_bytes(data)
+        os.replace(tmp, dest)
+    except BaseException:
+        tmp.unlink(missing_ok=True)
+        raise
+    return dest
+
+
+def _unzip_app(zip_path: Path, into: Path) -> Path:
+    """Extract the app from a release zip; ditto keeps symlinks and the code signature."""
+    into.mkdir(parents=True, exist_ok=True)
+    if shutil.which("ditto"):
+        r = subprocess.run(["ditto", "-x", "-k", str(zip_path), str(into)], capture_output=True, text=True, timeout=600)
+        if r.returncode != 0:
+            raise OSError(f"ditto couldn't extract {zip_path.name}: {r.stderr.strip()[:300]}")
+    else:
+        with zipfile.ZipFile(zip_path) as z:
+            root = into.resolve()
+            for m in z.namelist():
+                if root not in (into / m).resolve().parents and (into / m).resolve() != root:
+                    raise OSError(f"{zip_path.name} has a path outside the folder: {m}")
+            z.extractall(into)
+    app = into / APP_NAME
+    if not (app / "Contents" / "Info.plist").is_file():
+        raise OSError(f"{zip_path.name} has no {APP_NAME}")
+    return app
+
+
+class ReleaseFeed:
+    """Checks GitHub at most every `interval_s` and brings a newer release into the updates folder."""
+
+    def __init__(self, repo: str, *, interval_s: float = GITHUB_INTERVAL_S, fetch: Fetch = _http_get,
+                 platform: str | None = None):
+        self.repo, self.interval_s, self.fetch = repo, interval_s, fetch
+        self.platform = platform or sys.platform
+        self.last_check: float | None = None
+        self.last_error: str | None = None
+        self.latest: dict | None = None
+
+    def due(self, now: float | None = None) -> bool:
+        now = time.time() if now is None else now
+        return self.last_check is None or now - self.last_check >= self.interval_s
+
+    def poll(self, d: Path, current: str, *, is_newer: Callable[[Any, Any], bool],
+             now: float | None = None) -> dict | None:
+        """One check. Returns the release now in `d` (newly downloaded or already there) when it's
+        newer than `current`, else None. Blocking: run it in a thread."""
+        self.last_check = time.time() if now is None else now
+        self.last_error = None
+        rel = self.latest = latest_release(self.repo, self.fetch)
+        if not rel or not is_newer(rel["version"], current):
+            return None
+        v = rel["version"]
+        name = asset_name(v, self.platform)
+        asset = rel["assets"].get(name) if name else None
+        if not asset:
+            return None
+        if validate_release(d, read_json(d / v / "release.json")):
+            return rel  # already downloaded
+        partial = d / f".{v}.partial"
+        try:
+            if partial.exists():
+                shutil.rmtree(partial)
+            partial.mkdir(parents=True)
+            got = download(asset["url"], partial / name, asset["size"], self.fetch)
+            record = {"version": v, "built_at": rel.get("published_at"), "git_commit": None, "notes": rel["notes"],
+                      "source": f"github:{self.repo}"}
+            if name.endswith(".zip"):
+                _unzip_app(got, partial)
+                got.unlink()
+                record["app"] = f"{v}/{APP_NAME}"
+            else:
+                record["installer"] = f"{v}/{name}"
+            write_json_atomic(partial / "release.json", record)
+            final = d / v
+            if final.exists():
+                shutil.rmtree(final)
+            partial.rename(final)
+        except (OSError, ValueError) as e:
+            shutil.rmtree(partial, ignore_errors=True)
+            self.last_error = str(e)
+            log.warning("couldn't download update %s from %s: %s", v, self.repo, e)
+            return None
+        # Advertise last, never backwards (same rule as `make release`).
+        cur = read_json(d / "latest.json")
+        if not cur or parse_version(cur.get("version")) is None or not is_newer(cur["version"], v):
+            write_json_atomic(d / "latest.json", record)
+        log.info("downloaded update %s from %s", v, self.repo)
+        return rel
+
+    def status(self) -> dict:
+        return {"repo": self.repo, "interval_s": self.interval_s, "last_check": self.last_check,
+                "last_error": self.last_error, "latest": (self.latest or {}).get("version")}
+
+
