+# ------------------------------------------------------------- GitHub Releases
+
+
+def _zip_app(tmp_path: Path, version: str) -> bytes:
+    src = make_bundle(tmp_path / "zsrc" / "GameDevWorkstation.app", version)
+    out = tmp_path / "app.zip"
+    subprocess.run(["ditto", "-c", "-k", "--keepParent", str(src), str(out)], check=True)
+    return out.read_bytes()
+
+
+def _fake_github(version: str, assets: dict[str, bytes], **extra) -> tuple:
+    calls: list[str] = []
+    release = {"tag_name": f"v{version}", "body": "What's new", "published_at": "2026-11-20T10:00:00Z",
+               "html_url": "https://github.com/o/r/releases/tag/v" + version, **extra,
+               "assets": [{"name": n, "size": len(b), "browser_download_url": f"https://dl/{n}"} for n, b in assets.items()]}
+
+    def fetch(url: str) -> bytes:
+        calls.append(url)
+        if url.endswith("/releases/latest"):
+            return json.dumps(release).encode()
+        return assets[url.removeprefix("https://dl/")]
+
+    return fetch, calls
+
+
