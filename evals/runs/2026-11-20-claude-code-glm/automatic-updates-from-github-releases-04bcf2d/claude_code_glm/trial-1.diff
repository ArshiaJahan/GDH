+name: Release
+
+# When main carries a version (VERSION) that has no GitHub Release yet, build the macOS app (zip and
+# .dmg) and the Windows installer and publish them as Release v<version>. These builds carry the
+# "github" update channel: they check the latest release and update themselves from it. Local builds
+# (make release, scripts/build_*.sh/.ps1 without GDW_UPDATE_CHANNEL) never call GitHub.
+
+on:
+  push:
+    branches: [main]
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: release
+  cancel-in-progress: false
+
+jobs:
+  check:
+    name: Is this version released?
+    runs-on: ubuntu-latest
+    outputs:
+      version: ${{ steps.v.outputs.version }}
+      release: ${{ steps.v.outputs.release }}
+    steps:
+      - uses: actions/checkout@v4
+      - id: v
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          V="$(tr -d '[:space:]' < VERSION)"
+          python3 scripts/version.py check
+          echo "version=$V" >> "$GITHUB_OUTPUT"
+          if gh release view "v$V" --repo "$GITHUB_REPOSITORY" >/dev/null 2>&1; then
+            echo "v$V is already released"
+            echo "release=false" >> "$GITHUB_OUTPUT"
+          else
+            echo "v$V has no release yet; building it"
+            echo "release=true" >> "$GITHUB_OUTPUT"
+          fi
+
+  macos:
+    name: macOS app (zip + dmg)
+    needs: check
+    if: needs.check.outputs.release == 'true'
+    runs-on: macos-latest
+    timeout-minutes: 60
+    env:
+      UV_PYTHON: "3.13"
+      GDW_UPDATE_CHANNEL: github
+      GDW_ALLOW_ADHOC: "1"  # no signing certificate on the runner
+    steps:
+      - uses: actions/checkout@v4
+      - uses: astral-sh/setup-uv@v6
+        with:
+          enable-cache: true
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: npm
+          cache-dependency-path: frontend/package-lock.json
+      - uses: dtolnay/rust-toolchain@stable
+        with:
+          targets: aarch64-apple-darwin
+      - uses: Swatinem/rust-cache@v2
+        with:
+          workspaces: src-tauri
+      - name: Build
+        run: ./scripts/build_mac.sh
+      - name: Package
+        env:
+          V: ${{ needs.check.outputs.version }}
+        run: |
+          mkdir -p out
+          ditto -c -k --keepParent dist/GameDevWorkstation.app "out/GameDevWorkstation-$V-macos-arm64.zip"
+          cp dist/GameDevWorkstation.dmg "out/GameDevWorkstation-$V-macos-arm64.dmg"
+      - uses: actions/upload-artifact@v4
+        with:
+          name: release-macos
+          path: out/*
+          if-no-files-found: error
+
+  windows:
+    name: Windows installer
+    needs: check
+    if: needs.check.outputs.release == 'true'
+    runs-on: windows-latest
+    timeout-minutes: 60
+    env:
+      UV_PYTHON: "3.13"
+      GDW_UPDATE_CHANNEL: github
+    steps:
+      - uses: actions/checkout@v4
+      - uses: astral-sh/setup-uv@v6
+        with:
+          enable-cache: true
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: npm
+          cache-dependency-path: frontend/package-lock.json
+      - uses: dtolnay/rust-toolchain@stable
+      - uses: Swatinem/rust-cache@v2
+        with:
+          workspaces: src-tauri
+      - name: Build
+        shell: pwsh
+        run: ./scripts/build_windows.ps1
+      - uses: actions/upload-artifact@v4
+        with:
+          name: release-windows
+          path: dist/*-setup.exe
+          if-no-files-found: error
+
+  publish:
+    name: Publish GitHub Release
+    needs: [check, macos, windows]
+    runs-on: ubuntu-latest
+    permissions:
+      contents: write
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+      - uses: actions/download-artifact@v4
+        with:
+          path: assets
+          merge-multiple: true
+      - name: Create the release
+        env:
+          GH_TOKEN: ${{ github.token }}
+          V: ${{ needs.check.outputs.version }}
+        run: |
+          ls -l assets
+          test -f "assets/GameDevWorkstation-$V-macos-arm64.zip"
+          test -f "assets/GameDevWorkstation-$V-x64-setup.exe"
+          PREV="$(git describe --tags --abbrev=0 --match 'v*' HEAD^ 2>/dev/null || true)"
+          if [ -n "$PREV" ]; then git log --format='- %s' "$PREV..HEAD" > notes.md; else echo "GameDevWorkstation $V" > notes.md; fi
+          gh release create "v$V" assets/* --repo "$GITHUB_REPOSITORY" --target "$GITHUB_SHA" \
+            --title "GameDevWorkstation $V" --notes-file notes.md
