+# ------------------------------------------------------------- GitHub Releases
+
+GITHUB_REPO = "ArshiaJahan/GDH"
+GITHUB_API = "https://api.github.com"
+Fetch = Callable[[str], bytes]
+
+
+def _http_get(url: str) -> bytes:
+    """GET over https only. GitHub API calls ask for JSON; asset downloads follow GitHub's redirect."""
+    if not url.startswith("https://"):
+        raise ValueError(f"refusing a non-https URL: {url}")
+    api = url.startswith(GITHUB_API + "/")
+    req = urllib.request.Request(url, headers={
+        "Accept": "application/vnd.github+json" if api else "application/octet-stream",
+        "User-Agent": f"GameDevWorkstation/{__version__}"})
+    with urllib.request.urlopen(req, timeout=30 if api else 600) as r:  # noqa: S310 — https checked above
+        return r.read()
+
+
+def asset_name(version: str, platform: str | None = None) -> str | None:
+    """The release asset this platform installs from (the release workflow uploads these names)."""
+    v = str(version).removeprefix("v")
+    platform = platform or sys.platform
+    if platform == "darwin":
+        return f"GameDevWorkstation-{v}-macos-arm64.zip"
+    if platform == "win32":
+        return f"GameDevWorkstation-{v}-x64-setup.exe"
+    return None
+
+
+def latest_release(repo: str, fetch: Fetch = _http_get) -> dict | None:
+    """The repo's latest published release, or None (no release yet, offline, rate-limited, bad data)."""
+    if not re.fullmatch(r"[\w.-]+/[\w.-]+", repo or ""):
+        return None
+    try:
+        data = json.loads(fetch(f"{GITHUB_API}/repos/{repo}/releases/latest"))
+    except (OSError, ValueError) as e:
+        log.info("GitHub release check failed: %s", e)
+        return None
+    if not isinstance(data, dict) or data.get("draft") or data.get("prerelease"):
+        return None
+    version = str(data.get("tag_name") or "").removeprefix("v")
+    if parse_version(version) is None:
+        return None
+    assets = {}
+    for a in data.get("assets") or []:
+        if not isinstance(a, dict) or not a.get("name"):
+            continue
+        url = str(a.get("browser_download_url") or "")
+        if url.startswith("https://"):
+            size = a.get("size")
+            assets[str(a["name"])] = {"url": url, "size": size if isinstance(size, int) else None}
+    return {"version": version, "notes": str(data.get("body") or ""), "built_at": data.get("published_at"),
+            "url": data.get("html_url"), "assets": assets}
+
+
+def download(url: str, dest: Path, size: int | None, fetch: Fetch = _http_get) -> Path:
+    """Fetch `url` into `dest` atomically; raise ValueError if the size isn't what GitHub said."""
+    data = fetch(url)
+    if size is not None and len(data) != size:
+        raise ValueError(f"{dest.name}: got {len(data)} bytes, expected {size}")
+    dest.parent.mkdir(parents=True, exist_ok=True)
+    fd, tmp = tempfile.mkstemp(dir=dest.parent, prefix=f".{dest.name}.", suffix=".part")
+    try:
+        with os.fdopen(fd, "wb") as f:
+            f.write(data)
+            f.flush()
+            os.fsync(f.fileno())
+        os.replace(tmp, dest)
+    except BaseException:
+        Path(tmp).unlink(missing_ok=True)
+        raise
+    return dest
+
+
+def unpack_app(archive: Path, dest: Path) -> Path:
+    """Unzip a release zip into `dest` and return the GameDevWorkstation.app inside it."""
+    dest.mkdir(parents=True, exist_ok=True)
+    if shutil.which("ditto"):  # keeps symlinks, permissions and the code signature intact
+        r = subprocess.run(["ditto", "-x", "-k", str(archive), str(dest)], capture_output=True, text=True, timeout=600)
+        if r.returncode != 0:
+            raise OSError(f"ditto couldn't unpack {archive.name}: {r.stderr.strip()[:300]}")
+    else:
+        with zipfile.ZipFile(archive) as z:
+            z.extractall(dest)
+            for info in z.infolist():  # zipfile drops the executable bits
+                if mode := (info.external_attr >> 16) & 0o777:
+                    (dest / info.filename).chmod(mode)
+    app = dest / APP_NAME
+    if not (app / "Contents" / "Info.plist").is_file():
+        raise ValueError(f"{archive.name} has no {APP_NAME}")
+    return app
+
+
+class ReleaseFeed:
+    """Mirrors the latest GitHub release into the updates folder, at most every `interval_s`."""
+
+    def __init__(self, repo: str = GITHUB_REPO, interval_s: float = 6 * 3600, fetch: Fetch = _http_get,
+                 platform: str | None = None):
+        self.repo, self.interval_s, self.fetch, self.platform = repo, interval_s, fetch, platform
+        self.last_check: float | None = None
+        self.last_error: str | None = None
+
+    def due(self, now: float | None = None) -> bool:
+        now = time.time() if now is None else now
+        return self.last_check is None or now - self.last_check >= self.interval_s
+
+    def poll(self, d: Path, current: str, *, is_newer: Callable[[Any, Any], bool],
+             now: float | None = None) -> dict | None:
+        """Download a release newer than `current` into `d` (once) and advertise it in latest.json.
+        Returns the release record, or None when there's nothing new (or it couldn't be fetched)."""
+        self.last_check = time.time() if now is None else now
+        self.last_error = None
+        rel = latest_release(self.repo, self.fetch)
+        if not rel or not is_newer(rel["version"], current):
+            return None
+        v = rel["version"]
+        name = asset_name(v, self.platform)
+        asset = rel["assets"].get(name) if name else None
+        if not asset:
+            self.last_error = f"Release v{v} has no {name or 'asset for this platform'}."
+            return None
+        folder = d / v
+        record = {"version": v, "built_at": rel["built_at"], "git_commit": None, "notes": rel["notes"],
+                  "source": "github", "url": rel["url"]}
+        record["installer" if name.endswith(".exe") else "app"] = f"{v}/{name if name.endswith('.exe') else APP_NAME}"
+        if validate_release(d, read_json(folder / "release.json")) is None:
+            tmp = d / f".download-{v}"
+            try:
+                shutil.rmtree(tmp, ignore_errors=True)
+                got = download(asset["url"], tmp / name, asset["size"], self.fetch)
+                src = got if name.endswith(".exe") else unpack_app(got, tmp / "app")
+                target = d / record.get("installer", record.get("app"))
+                folder.mkdir(parents=True, exist_ok=True)
+                if target.is_dir():
+                    shutil.rmtree(target)
+                else:
+                    target.unlink(missing_ok=True)
+                os.replace(src, target)
+                write_json_atomic(folder / "release.json", record)
+            except (OSError, ValueError, zipfile.BadZipFile) as e:
+                self.last_error = f"Couldn't download v{v}: {e}"
+                log.warning("%s", self.last_error)
+                return None
+            finally:
+                shutil.rmtree(tmp, ignore_errors=True)
+        latest = validate_release(d, read_json(d / "latest.json"))
+        if latest is None or is_newer(v, latest["version"]):  # never advertise an older version
+            write_json_atomic(d / "latest.json", record)
+        return record
+
+
+# ------------------------------------------------------------------ Windows
+
+
+def process_exe(pid: int) -> Path | None:
+    """The executable a running process was started from (Windows only)."""
+    if os.name != "nt":
+        return None
+    import ctypes
+    from ctypes import wintypes
+
+    k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+    k32.OpenProcess.restype = wintypes.HANDLE
+    k32.OpenProcess.argtypes = [wintypes.DWORD, wintypes.BOOL, wintypes.DWORD]
+    k32.QueryFullProcessImageNameW.argtypes = [wintypes.HANDLE, wintypes.DWORD, wintypes.LPWSTR,
+                                               ctypes.POINTER(wintypes.DWORD)]
+    k32.CloseHandle.argtypes = [wintypes.HANDLE]
+    h = k32.OpenProcess(0x1000, False, int(pid))  # PROCESS_QUERY_LIMITED_INFORMATION
+    if not h:
+        return None
+    try:
+        buf = ctypes.create_unicode_buffer(32768)
+        size = wintypes.DWORD(len(buf))
+        if not k32.QueryFullProcessImageNameW(h, 0, buf, ctypes.byref(size)):
+            return None
+        return Path(buf.value)
+    finally:
+        k32.CloseHandle(h)
+
+
+def _ps(s: str) -> str:
+    """A PowerShell single-quoted literal."""
+    return "'" + str(s).replace("'", "''") + "'"
+
+
+def windows_helper_script(*, app_pid: int, backend_pid: int, installer: Path, app_exe: Path | None) -> str:
+    """The stop-install-restart script for Windows. Timings can be shortened via env (WS_START_DELAY,
+    WS_QUIT_TIMEOUT, WS_BACKEND_WAIT, WS_INSTALL_TIMEOUT). If the installer fails, the old app (still
+    in place: NSIS only replaces files once it runs) is started again."""
+    exe = _ps(str(app_exe)) if app_exe else "$null"
+    return f"""# GameDevWorkstation update helper (generated by the backend). Runs detached from the app.
+$ErrorActionPreference = 'Continue'
+$AppPid = {int(app_pid)}
+$BackendPid = {int(backend_pid)}
+$Installer = {_ps(str(installer))}
+$AppExe = {exe}
+function Setting($name, $default) {{ $v = [Environment]::GetEnvironmentVariable($name); if ($v) {{ [double]$v }} else {{ $default }} }}
+$StartDelay = Setting 'WS_START_DELAY' 1
+$QuitTimeout = Setting 'WS_QUIT_TIMEOUT' 30
+$BackendWait = Setting 'WS_BACKEND_WAIT' 15
+$InstallTimeout = Setting 'WS_INSTALL_TIMEOUT' 600
+function Log($m) {{ Write-Output ("{{0}} {{1}}" -f (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'), $m) }}
+function Alive($id) {{ $id -gt 0 -and $null -ne (Get-Process -Id $id -ErrorAction SilentlyContinue) }}
+function WaitGone($id, $seconds) {{
+  $deadline = (Get-Date).AddSeconds($seconds)
+  while ((Alive $id) -and (Get-Date) -lt $deadline) {{ Start-Sleep -Milliseconds 100 }}
+  -not (Alive $id)
+}}
+function StartApp {{
+  if ($AppExe -and (Test-Path -LiteralPath $AppExe -PathType Leaf)) {{
+    Log "starting $AppExe"; Start-Process -FilePath $AppExe
+  }} else {{ Log "note: couldn't find the app to start; open GameDevWorkstation from the Start menu" }}
+}}
+
+Log "update: $Installer (app pid $AppPid)"
+if (-not (Test-Path -LiteralPath $Installer -PathType Leaf)) {{ Log 'ERROR: the installer is missing; nothing changed'; exit 1 }}
