+def windows_process_path(pid: int) -> Path | None:
+    """The executable a Windows process runs from (QueryFullProcessImageNameW), or None."""
+    if os.name != "nt":
+        return None
+    import ctypes
+    from ctypes import wintypes
+
+    k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+    k32.OpenProcess.restype = wintypes.HANDLE
+    h = k32.OpenProcess(0x1000, False, int(pid))  # PROCESS_QUERY_LIMITED_INFORMATION
+    if not h:
+        return None
+    try:
+        buf = ctypes.create_unicode_buffer(32768)
+        size = wintypes.DWORD(len(buf))
+        if not k32.QueryFullProcessImageNameW(h, 0, buf, ctypes.byref(size)):
+            return None
+        return Path(buf.value)
+    finally:
+        k32.CloseHandle(h)
+
+
+def _ps(s: str) -> str:
+    """A PowerShell single-quoted literal."""
+    return "'" + s.replace("'", "''") + "'"
+
+
+def windows_helper_script(*, app_pid: int, backend_pid: int, installer: Path, app_exe: Path | None) -> str:
+    """The stop-install-restart script (PowerShell). It stops the app (and the backend, if it
+    outlives it), runs the NSIS installer silently, then starts the app again: the installed exe
+    if it's known, else the installer's default per-user location."""
+    exe = _ps(str(app_exe)) if app_exe else "$null"
+    return f"""# GameDevWorkstation update helper (generated by the backend). Runs detached from the app.
+$ErrorActionPreference = 'Continue'
+$AppPid = {int(app_pid)}
+$BackendPid = {int(backend_pid)}
+$Installer = {_ps(str(installer))}
+$AppExe = {exe}
+function Log($m) {{ Write-Output ("{{0}} {{1}}" -f (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'), $m) }}
+
+Log "update: $Installer (app pid $AppPid)"
+if (-not (Test-Path -LiteralPath $Installer -PathType Leaf)) {{ Log 'ERROR: the installer is missing; nothing changed'; exit 1 }}
+Start-Sleep -Seconds 1  # let the backend answer the request first
+
+# 1. Stop the app, then the backend if it's still around.
+foreach ($id in @($AppPid, $BackendPid)) {{
+  if ($id -le 0) {{ continue }}
+  $p = Get-Process -Id $id -ErrorAction SilentlyContinue
+  if ($p) {{
+    Log "stopping pid $id"
+    $null = $p.CloseMainWindow()
+    if (-not $p.WaitForExit(10000)) {{ Stop-Process -Id $id -Force -ErrorAction SilentlyContinue; $null = $p.WaitForExit(10000) }}
+  }}
+}}
+Start-Sleep -Milliseconds 500
+
+# 2. Install silently (NSIS /S) and wait for it.
+Log 'running the installer'
+$code = 1
+try {{
+  $proc = Start-Process -FilePath $Installer -ArgumentList '/S' -Wait -PassThru
+  $code = $proc.ExitCode
+}} catch {{ Log "ERROR: couldn't run the installer: $_" }}
+if ($code -ne 0) {{ Log "ERROR: the installer exited with $code" }}
+
+# 3. Start the app again (the old one if the install failed: NSIS leaves it in place).
+if (-not $AppExe -or -not (Test-Path -LiteralPath $AppExe)) {{
+  $AppExe = Join-Path $env:LOCALAPPDATA 'GameDevWorkstation\\GameDevWorkstation.exe'
+}}
+if (Test-Path -LiteralPath $AppExe) {{ Log "starting $AppExe"; Start-Process -FilePath $AppExe }}
+else {{ Log "ERROR: couldn't find the app to start ($AppExe)" }}
+if ($code -ne 0) {{ exit 1 }}
+Log 'done'
+exit 0
+"""
+
+
+def launch_windows_helper(script: str, log_path: Path) -> int:
+    """Start the helper detached from the app, so it survives the app and backend stopping."""
+    d = data_dir() / "updates-tmp"
+    d.mkdir(parents=True, exist_ok=True)
+    path = d / f"install-{int(time.time())}.ps1"
+    path.write_text(script, encoding="utf-8-sig")
+    log_path.parent.mkdir(parents=True, exist_ok=True)
+    cmd = ["powershell.exe", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-WindowStyle", "Hidden",
+           "-File", str(path)]
+    detached, new_group, breakaway, no_window = 0x8, 0x200, 0x01000000, 0x08000000
+    with log_path.open("a") as out:
+        for flags in (new_group | no_window | breakaway, new_group | detached):
+            try:
+                p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT,
+                                     creationflags=flags, close_fds=True, env=_clean_env())
+                return p.pid
+            except OSError:
+                continue  # the app's job object may not allow breakaway
+    raise OSError("couldn't start the update helper")
