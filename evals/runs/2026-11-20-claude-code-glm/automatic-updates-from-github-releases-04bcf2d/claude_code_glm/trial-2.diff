+def update_channel() -> tuple[str, str | None]:
+    """("github", "owner/repo") for builds made by the release workflow, else ("local", None).
+    Running from source is always local, so it never calls GitHub."""
+    if not frozen():
+        return "local", None
+    try:
+        data = json.loads(BUILD_INFO.read_text())
+    except (OSError, ValueError):
+        return "local", None
+    if data.get("channel") == "github" and data.get("repo"):
+        return "github", str(data["repo"])
+    return "local", None
