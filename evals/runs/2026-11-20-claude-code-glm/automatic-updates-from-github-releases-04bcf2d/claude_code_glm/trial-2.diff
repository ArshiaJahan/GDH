+# ------------------------------------------------------------ github releases
+# Builds made by the release workflow carry the "github" update channel (see buildinfo). They ask
+# GitHub for the latest release now and then, download the asset for their platform into the
+# updates folder in the same layout `make release` uses, and the folder updater does the rest.
+
+Fetch = Callable[[str], bytes]
+GITHUB_API = "https://api.github.com"
+
+
+def _http_get(url: str) -> bytes:
+    import urllib.request
+
+    accept = "application/vnd.github+json" if url.startswith(GITHUB_API) else "application/octet-stream"
+    req = urllib.request.Request(url, headers={"Accept": accept, "User-Agent": f"GameDevWorkstation/{__version__}"})
+    with urllib.request.urlopen(req, timeout=60) as r:  # noqa: S310 — https URLs from GitHub only
+        return r.read()
+
+
+def asset_name(version: str, platform: str | None = None) -> str | None:
+    """The release asset this platform installs from, or None where there's none."""
+    platform = platform or sys.platform
+    v = str(version).removeprefix("v")
+    if platform == "darwin":
+        return f"GameDevWorkstation-{v}-macos-arm64.zip"
+    if platform == "win32":
+        return f"GameDevWorkstation-{v}-x64-setup.exe"
+    return None
+
+
+def latest_release(repo: str, fetch: Fetch = _http_get) -> dict | None:
+    """GitHub's latest (non-draft, non-prerelease) release of `repo`, or None if there's none
+    or GitHub can't be reached."""
+    if not re.fullmatch(r"[\w.-]+/[\w.-]+", repo or ""):
+        return None
+    try:
+        data = json.loads(fetch(f"{GITHUB_API}/repos/{repo}/releases/latest"))
+    except Exception as e:  # noqa: BLE001 — offline, 404, rate limit: just try again later
+        log.info("couldn't read the latest release of %s: %s", repo, e)
+        return None
+    if not isinstance(data, dict) or data.get("draft") or data.get("prerelease"):
+        return None
+    if parse_version(data.get("tag_name")) is None:
+        return None
+    return data
+
+
+def download(url: str, dest: Path, size: int | None, fetch: Fetch = _http_get) -> Path:
+    """Fetch `url` into `dest` (tmp file + rename). Raises ValueError if the size is wrong."""
+    data = fetch(url)
+    if size is not None and len(data) != int(size):
+        raise ValueError(f"Downloaded {len(data)} bytes from {url}, expected {size}.")
+    dest.parent.mkdir(parents=True, exist_ok=True)
+    fd, tmp = tempfile.mkstemp(dir=dest.parent, prefix=f".{dest.name}.", suffix=".part")
+    try:
+        with os.fdopen(fd, "wb") as f:
+            f.write(data)
+        os.replace(tmp, dest)
+    except BaseException:
+        Path(tmp).unlink(missing_ok=True)
+        raise
+    return dest
+
+
+def _unzip(zip_path: Path, dest: Path) -> None:
+    if shutil.which("ditto"):  # keeps symlinks, permissions and the code signature intact
+        r = subprocess.run(["ditto", "-x", "-k", str(zip_path), str(dest)], capture_output=True, text=True, timeout=600)
+        if r.returncode != 0:
+            raise OSError(f"ditto failed: {r.stderr.strip()[:300]}")
+        return
+    import zipfile
+
+    with zipfile.ZipFile(zip_path) as z:
+        root = dest.resolve()
+        for info in z.infolist():
+            target = (dest / info.filename).resolve()
+            if target != root and root not in target.parents:
+                raise OSError(f"{zip_path} has an entry outside the archive: {info.filename}")
+            mode = info.external_attr >> 16
+            if (mode & 0o170000) == 0o120000:  # symlink
+                target.parent.mkdir(parents=True, exist_ok=True)
+                os.symlink(z.read(info).decode(), target)
+                continue
+            z.extract(info, dest)
+            if mode & 0o777:
+                os.chmod(target, mode & 0o777)
+
+
+class ReleaseFeed:
+    """Polls GitHub Releases and lays new versions out in the updates folder."""
+
+    def __init__(self, repo: str, *, interval_s: float = 6 * 3600, fetch: Fetch = _http_get,
+                 platform: str | None = None):
+        self.repo, self.interval_s, self.fetch = repo, float(interval_s), fetch
+        self.platform = platform or sys.platform
+        self.last_check: float | None = None
+        self.last_error: str | None = None
+
+    def due(self, now: float | None = None) -> bool:
+        now = time.time() if now is None else now
+        return self.last_check is None or now - self.last_check >= self.interval_s
+
+    def poll(self, d: Path, current: str, *, is_newer: Callable[[Any, Any], bool],
+             now: float | None = None) -> dict | None:
+        """Download the latest release if it's newer than `current` and not in `d` yet. Returns the
+        release record now in the folder (or None), and points latest.json at it."""
+        self.last_check = time.time() if now is None else now
+        self.last_error = None
+        rel = latest_release(self.repo, self.fetch)
+        if not rel:
+            return None
+        version = str(rel["tag_name"]).removeprefix("v")
+        if not is_newer(version, current):
+            return None
+        name = asset_name(version, self.platform)
+        asset = next((a for a in rel.get("assets") or [] if isinstance(a, dict) and a.get("name") == name), None)
+        if not name or not asset or not asset.get("browser_download_url"):
+            return None
+        folder = d / version
+        record = validate_release(d, read_json(folder / "release.json"))
+        if record is None:
+            try:
+                record = self._fetch_into(d, version, name, asset, rel)
+            except (OSError, ValueError) as e:
+                self.last_error = str(e)
+                log.warning("couldn't download update %s: %s", version, e)
+                return None
+        latest = validate_release(d, read_json(d / "latest.json"))
+        if not latest or is_newer(version, latest["version"]):
+            write_json_atomic(d / "latest.json", read_json(folder / "release.json") or {})
+        return record
+
+    def _fetch_into(self, d: Path, version: str, name: str, asset: dict, rel: dict) -> dict:
+        folder = d / version
+        work = d / ".downloads"
+        commit = str(rel.get("target_commitish") or "")
+        meta = {"version": version, "built_at": rel.get("published_at"),
+                "git_commit": commit[:12] if re.fullmatch(r"[0-9a-f]{7,40}", commit) else None,
+                "notes": str(rel.get("body") or ""), "source": f"github:{self.repo}"}
+        if name.endswith(".exe"):
+            download(asset["browser_download_url"], folder / name, asset.get("size"), self.fetch)
+            meta["installer"] = f"{version}/{name}"
+        else:
+            z = download(asset["browser_download_url"], work / name, asset.get("size"), self.fetch)
+            out = work / f"{version}-unzipped"
+            shutil.rmtree(out, ignore_errors=True)
+            try:
+                _unzip(z, out)
+                app = out / APP_NAME
+                if not (app / "Contents" / "Info.plist").is_file():
+                    raise ValueError(f"{name} doesn't contain {APP_NAME}.")
+                folder.mkdir(parents=True, exist_ok=True)
+                shutil.rmtree(folder / APP_NAME, ignore_errors=True)
+                os.replace(app, folder / APP_NAME)
+            finally:
+                shutil.rmtree(out, ignore_errors=True)
+                z.unlink(missing_ok=True)
+            meta["app"] = f"{version}/{APP_NAME}"
+        write_json_atomic(folder / "release.json", meta)  # last, so a half-done download is never listed
+        record = validate_release(d, meta)
+        if record is None:
+            raise ValueError(f"The download of {version} isn't usable.")
+        return record
+
+
