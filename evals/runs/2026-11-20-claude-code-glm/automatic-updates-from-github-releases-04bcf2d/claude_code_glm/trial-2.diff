@@ -0,0 +1,131 @@
+name: Release
+
+# When main has a VERSION with no GitHub Release yet, build the macOS app (zip + .dmg) and the
+# Windows installer and publish them as release v<version>. These builds carry the "github"
+# update channel, so they check this repo's latest release and update themselves from it.
+
+on:
+  push:
+    branches: [main]
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: release
+  cancel-in-progress: false
+
+jobs:
+  check:
+    name: Is there a version to release?
+    runs-on: ubuntu-latest
+    outputs:
+      version: ${{ steps.v.outputs.version }}
+      needed: ${{ steps.v.outputs.needed }}
+    steps:
+      - uses: actions/checkout@v4
+      - id: v
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          v="$(tr -d '[:space:]' < VERSION)"
+          echo "version=$v" >> "$GITHUB_OUTPUT"
+          if gh release view "v$v" --repo "$GITHUB_REPOSITORY" >/dev/null 2>&1; then
+            echo "v$v is already released"
+            echo "needed=false" >> "$GITHUB_OUTPUT"
+          else
+            echo "v$v has no release yet"
+            echo "needed=true" >> "$GITHUB_OUTPUT"
+          fi
+
+  macos:
+    name: macOS app (zip + dmg)
+    needs: check
+    if: needs.check.outputs.needed == 'true'
+    runs-on: macos-latest
+    timeout-minutes: 60
+    env:
+      UV_PYTHON: "3.13"
+      GDW_UPDATE_CHANNEL: github
+      GDW_UPDATE_REPO: ${{ github.repository }}
+      GDW_ALLOW_ADHOC: "1"
+      VERSION: ${{ needs.check.outputs.version }}
+    steps:
+      - uses: actions/checkout@v4
+      - uses: astral-sh/setup-uv@v6
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: npm
+          cache-dependency-path: frontend/package-lock.json
+      - uses: dtolnay/rust-toolchain@stable
+        with:
+          targets: aarch64-apple-darwin
+      - name: Check the version is the same everywhere
+        run: python3 scripts/version.py check
+      - name: Build
+        run: ./scripts/build_mac.sh
+      - name: Package
+        run: |
+          mkdir -p out
+          # ditto keeps symlinks and the signature; the app's updater unpacks it the same way.
+          ditto -c -k --sequesterRsrc --keepParent dist/GameDevWorkstation.app "out/GameDevWorkstation-$VERSION-macos-arm64.zip"
+          cp dist/GameDevWorkstation.dmg "out/GameDevWorkstation-$VERSION-macos-arm64.dmg"
+      - uses: actions/upload-artifact@v4
+        with:
+          name: macos
+          path: out/*
+          if-no-files-found: error
+
+  windows:
+    name: Windows installer
+    needs: check
+    if: needs.check.outputs.needed == 'true'
+    runs-on: windows-latest
+    timeout-minutes: 60
+    env:
+      UV_PYTHON: "3.13"
+      GDW_UPDATE_CHANNEL: github
+      GDW_UPDATE_REPO: ${{ github.repository }}
+    steps:
+      - uses: actions/checkout@v4
+      - uses: astral-sh/setup-uv@v6
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: npm
+          cache-dependency-path: frontend/package-lock.json
+      - uses: dtolnay/rust-toolchain@stable
+      - name: Build the installer
+        shell: pwsh
+        run: ./scripts/build_windows.ps1
+      - uses: actions/upload-artifact@v4
+        with:
+          name: windows
+          path: dist/*-setup.exe
+          if-no-files-found: error
+
+  publish:
+    name: Publish v${{ needs.check.outputs.version }}
+    needs: [check, macos, windows]
+    runs-on: ubuntu-latest
+    permissions:
+      contents: write
+    env:
+      GH_TOKEN: ${{ github.token }}
+      VERSION: ${{ needs.check.outputs.version }}
+    steps:
+      - uses: actions/download-artifact@v4
+        with:
+          path: assets
+          merge-multiple: true
+      - name: Create the release
+        run: |
+          ls -l assets
+          if gh release view "v$VERSION" --repo "$GITHUB_REPOSITORY" >/dev/null 2>&1; then
+            echo "v$VERSION was released meanwhile; nothing to do"
+            exit 0
+          fi
+          gh release create "v$VERSION" assets/* --repo "$GITHUB_REPOSITORY" --target "$GITHUB_SHA" \
+            --title "GameDevWorkstation $VERSION" --generate-notes
