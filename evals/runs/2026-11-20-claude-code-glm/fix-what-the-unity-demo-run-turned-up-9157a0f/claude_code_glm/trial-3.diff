+/** A wait in its two largest units: "8s", "4m 10s", "3h 5m", "6d 7h". */
+export function formatWait(seconds: number): string {
+  const s = Math.max(0, Math.ceil(seconds));
+  if (s < 60) return `${s}s`;
+  if (s < 3600) return `${Math.floor(s / 60)}m ${s % 60}s`;
+  if (s < 86400) return `${Math.floor(s / 3600)}h ${Math.floor((s % 3600) / 60)}m`;
+  return `${Math.floor(s / 86400)}d ${Math.floor((s % 86400) / 3600)}h`;
+}
+
+/** The status line's text: a retry gets a live countdown; anything else (a plan-limit notice) keeps its own text. */
+export function statusText(s: AgentStatus, nowMs: number): string {
+  const left = s.until ? Math.max(0, Math.ceil(s.until - nowMs / 1000)) : null;
+  return s.kind === "rate_limit" && left != null ? `Rate limited, retrying in ${formatWait(left)}` : s.text;
+}
