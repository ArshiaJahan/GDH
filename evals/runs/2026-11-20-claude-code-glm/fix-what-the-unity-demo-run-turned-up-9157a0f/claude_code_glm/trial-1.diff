+/** A wait as people read it: 45s, 3m 20s, 2h 5m, 6d 7h. */
+export function formatWait(seconds: number): string {
+  const s = Math.max(0, Math.ceil(seconds));
+  if (s < 60) return `${s}s`;
+  const d = Math.floor(s / 86400), h = Math.floor((s % 86400) / 3600), m = Math.floor((s % 3600) / 60), r = s % 60;
+  if (d) return h ? `${d}d ${h}h` : `${d}d`;
+  if (h) return m ? `${h}h ${m}m` : `${h}h`;
+  return r ? `${m}m ${r}s` : `${m}m`;
+}
+
+/** The status line's text: a rate-limit retry counts down; other notices (plan limits, compacting) keep their own text. */
+export function statusText(s: AgentStatus, nowMs: number): string {
+  const left = s.until ? Math.max(0, Math.ceil(s.until - nowMs / 1000)) : null
+  return s.kind === "rate_limit" && left != null ? `Rate limited, retrying in ${formatWait(left)}` : s.text;
+}
+
