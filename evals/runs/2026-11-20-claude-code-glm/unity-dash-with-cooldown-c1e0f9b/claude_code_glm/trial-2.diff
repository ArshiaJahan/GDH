+namespace CoinDash
+{
+    /// <summary>Dash timing rules, kept out of MonoBehaviours so EditMode tests can check them.</summary>
+    public sealed class Dash
+    {
+        public const float SpeedMultiplier = 3f;
+        public const float Duration = 0.2f;
+        public const float Cooldown = 1f;
+
+        // Absorbs float drift from summing many small frame deltas.
+        const float Epsilon = 1e-5f;
+
+        float _dashLeft;
+        float _cooldownLeft;
+
+        public bool IsDashing => _dashLeft > Epsilon;
+        public bool Ready => _cooldownLeft <= Epsilon;
+        public float Multiplier => IsDashing ? SpeedMultiplier : 1f;
+
+        /// <summary>Starts a dash if the player is moving and the cooldown has run out.</summary>
+        public bool TryStart(bool moving)
+        {
+            if (!moving || !Ready) return false;
+            _dashLeft = Duration;
+            _cooldownLeft = Cooldown;
+            return true;
+        }
+
+        /// <summary>Counts the dash and cooldown timers down by the frame's delta time.</summary>
+        public void Tick(float dt)
+        {
+            if (dt <= 0f) return;
+            _dashLeft = _dashLeft > dt ? _dashLeft - dt : 0f;
+            _cooldownLeft = _cooldownLeft > dt ? _cooldownLeft - dt : 0f;
+        }
+    }
+}
