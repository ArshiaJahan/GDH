diff --git a/examples/unity-sample/Assets/Tests/Editor/DashTests.cs b/examples/unity-sample/Assets/Tests/Editor/DashTests.cs
new file mode 100644
index 0000000..7812e9a
--- /dev/null
+++ b/examples/unity-sample/Assets/Tests/Editor/DashTests.cs
@@ -0,0 +1,46 @@
+using NUnit.Framework;
+
+namespace CoinDash.Tests
+{
+    public class DashTests
+    {
+        [Test]
+        public void DashOnlyStartsWhileMoving()
+        {
+            var dash = new Dash();
+            Assert.IsFalse(dash.TryStart(false));
+            Assert.IsFalse(dash.IsDashing);
+            Assert.AreEqual(1f, dash.Multiplier);
+            Assert.IsTrue(dash.Ready);
+        }
+
+        [Test]
+        public void DashTriplesSpeedForPointTwoSeconds()
+        {
+            var dash = new Dash();
+            Assert.IsTrue(dash.TryStart(true));
+            Assert.IsTrue(dash.IsDashing);
+            Assert.AreEqual(3f, dash.Multiplier);
+            dash.Tick(0.1f);
+            Assert.IsTrue(dash.IsDashing);
+            dash.Tick(0.1f);
+            Assert.IsFalse(dash.IsDashing);
+            Assert.AreEqual(1f, dash.Multiplier);
+        }
+
+        [Test]
+        public void NextDashAllowedOneSecondAfterStart()
+        {
+            var dash = new Dash();
+            dash.TryStart(true);
+            Assert.IsFalse(dash.Ready);
+            for (int i = 0; i < 4; i++) dash.Tick(0.2f);
+            Assert.IsFalse(dash.Ready);
+            Assert.IsFalse(dash.TryStart(true));
+            dash.Tick(0.2f);
+            Assert.IsTrue(dash.Ready);
+            Assert.IsTrue(dash.TryStart(true));
+            Assert.IsTrue(dash.IsDashing);
+        }
+    }
+}
