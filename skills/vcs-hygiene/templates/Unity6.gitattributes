# Unity 6 (6000.3) .gitattributes for the Unity harness.
# Based on https://github.com/gitattributes/gitattributes/blob/master/Unity.gitattributes (MIT),
# plus 2D additions (aseprite, psb, flac, fonts) marked "harness".
# Must be the TOP-LEVEL .gitattributes of the repo (macros only work there).
# merge=unityyamlmerge does nothing until the driver is configured:
#   scripts/setup_unityyamlmerge.sh  (writes LOCAL repo config only)

# Normalise text files we do not list explicitly (harness)
*                       text=auto

# Macros
[attr]lfs               filter=lfs diff=lfs merge=lfs -text
[attr]unity-json        eol=lf linguist-language=json
[attr]unity-yaml        merge=unityyamlmerge eol=lf linguist-language=yaml

# Unity source files (harness: eol=lf so macOS agents and Windows users produce identical diffs)
*.cginc                 text eol=lf
*.compute               text eol=lf linguist-language=hlsl
*.cs                    text eol=lf diff=csharp
*.hlsl                  text eol=lf linguist-language=hlsl
*.raytrace              text eol=lf linguist-language=hlsl
*.shader                text eol=lf

# Unity JSON files
*.asmdef                unity-json
*.asmref                unity-json
*.index                 unity-json
*.inputactions          unity-json
*.shadergraph           unity-json
*.shadersubgraph        unity-json

# Unity UI Toolkit files
*.tss                   text diff=css linguist-language=css
*.uss                   text diff=css linguist-language=css
*.uxml                  text linguist-language=xml linguist-detectable

# Unity YAML files (Force Text serialization) -> UnityYAMLMerge
*.anim                  unity-yaml
*.asset                 unity-yaml
*.brush                 unity-yaml
*.controller            unity-yaml
*.flare                 unity-yaml
*.fontsettings          unity-yaml
*.giparams              unity-yaml
*.guiskin               unity-yaml
*.lighting              unity-yaml
*.mask                  unity-yaml
*.mat                   unity-yaml
*.meta                  unity-yaml
*.mixer                 unity-yaml
*.overrideController    unity-yaml
*.playable              unity-yaml
*.prefab                unity-yaml
*.preset                unity-yaml
*.renderTexture         unity-yaml
*.scenetemplate         unity-yaml
*.shadervariants        unity-yaml
*.signal                unity-yaml
*.spriteatlas           unity-yaml
*.spriteatlasv2         unity-yaml
*.terrainlayer          unity-yaml
*.unity                 unity-yaml
*.physicMaterial        unity-yaml
*.physicsMaterial2D     unity-yaml

# Exclude from GitHub stats and diffs
Assets/Plugins/**           linguist-generated
Packages/packages-lock.json linguist-generated

# ---------------- Git LFS ----------------
# Rationale: git keeps every version of a binary in full (compressed binaries do not delta well),
# so art/audio history bloats every clone. LFS by EXTENSION keeps the rule predictable even for
# small pixel-art PNGs. vcs_check.py also flags any non-LFS blob above --max-blob-kb (default 1024).
# GitHub warns at 50 MB and rejects files over 100 MB without LFS.

*.cubemap               lfs
*.unitypackage          lfs

