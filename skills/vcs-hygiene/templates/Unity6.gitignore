# Unity 6 (6000.3) .gitignore for the Unity harness.
# Based on the official template https://github.com/github/gitignore/blob/main/Unity.gitignore
# (CC0-1.0), plus macOS, IDE, MCP and agent additions marked "harness".
# Place at the Unity PROJECT root. If the git root is a parent folder, prefix the
# anchored patterns (those starting with /) with the project subfolder.

# --- Unity generated folders (never commit) ---
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# Blender backups do not need to be committed
*.blend1
*.blend1.meta

# Memory Profiler captures: large, may contain sensitive data
/[Mm]emoryCaptures/

# Recorder output
/[Rr]ecordings/

# Autogenerated Jetbrains Rider plugin and personal settings
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# IDE caches and generated solution/project files
.vs/
.gradle/
# harness: Rider/IntelliJ workspace; drop .vscode/ if the team shares its settings
# (gitignore has no trailing comments: keep comments on their own lines)
.idea/
.vscode/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
/*_BackUpThisFolder_ButDontShipItWithYourGame/
/*_BurstDebugInformation_DoNotShip/

# Test Framework generated scenes
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Addressables build output (keep AddressableAssetsData settings, ignore build artefacts)
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting generated files
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Editor caches inside Assets
/[Aa]ssets/[Ss]ceneDependencyCache*
/[Aa]ssets/_Recovery/

# --- harness additions ---
# macOS
.DS_Store
._*
# git mergetool backups (UnityYAMLMerge / FileMerge)
*.orig
# Profiler captures (.raw/.data) and harness PerfProbe output, if saved in the project
/[Pp]erf[Cc]aptures/
/[Pp]rofiler[Cc]aptures/
# MCP for Unity screenshots (manage_camera default folder). Delete these two lines to keep them.
/[Aa]ssets/[Ss]creenshots/
/[Aa]ssets/[Ss]creenshots.meta
