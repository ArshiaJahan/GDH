{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameDevWorkstation",
  "version": "0.4.0",
  "identifier": "dev.local.gamedevworkstation",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GameDevWorkstation",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* https://elevenlabs.io https://*.elevenlabs.io https://*.googleapis.com",
        "img-src": "'self' data: blob: http://127.0.0.1:*",
        "media-src": "'self' blob: data: http://127.0.0.1:* https://storage.googleapis.com https://*.elevenlabs.io",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "frame-src": "'self' blob: data: about: http://127.0.0.1:*"
      }
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "copyright": "Personal use",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "resources/backend/": "backend/"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "dmg": {
        "windowSize": {
          "width": 560,
          "height": 360
        }
      }
    }
  }
}
